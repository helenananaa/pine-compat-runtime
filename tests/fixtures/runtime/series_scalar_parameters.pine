//@version=6
indicator("Explicit series scalar parameters")
previous(series float value) => value[1]
half(series float value) => value / 2
choose(series bool enabled, series string name, series color tint) =>
    [enabled ? name : "off", tint]
accumulate(series float value) =>
    var float total = 0
    total += value
    total
[caption, tint] = choose(true, "on", color.red)
plot(previous(3), "constant history")
plot(previous(close), "price history")
plot(half(3), "numeric promotion")
plot(accumulate(close), "persistent sum")
plot(caption == "on" ? 1 : 0, "string and bool", color=tint)
