//@version=6
indicator("Supported bound matrix.pinv call-result reads")

pinvRows(values) => values.pinv().copy().rows()

values = matrix.new<float>(3, 2, 0.0)
values.set(0, 0, 1.0)
values.set(1, 1, 1.0)
ints = matrix.new<int>(1, 1, 2)

int direct_rows = values.pinv().rows()
int direct_columns = values.pinv().columns()
int direct_elements = values.pinv().elements_count()
float direct_get = values.pinv().get(row=1, column=1)
matrix<float> nested_copy = values.pinv().copy()
float int_get = ints.pinv().get(0, 0)
array<float> direct_row = values.pinv().row(1).copy()
array<float> direct_col = values.pinv().col(1).copy()
array<float> direct_eigenvalues = values.pinv().eigenvalues().copy()
bool direct_is_square = values.pinv().is_square()
bool direct_is_zero = values.pinv().is_zero()
bool direct_is_binary = values.pinv().is_binary()
bool direct_is_diagonal = values.pinv().is_diagonal()
bool direct_is_identity = values.pinv().is_identity()
bool direct_is_symmetric = values.pinv().is_symmetric()
bool direct_is_antisymmetric = values.pinv().is_antisymmetric()
bool direct_is_stochastic = values.pinv().is_stochastic()
float direct_sum = values.pinv().avg()
float direct_avg = values.pinv().avg()
float direct_min = values.pinv().min()
float direct_max = values.pinv().max()
float direct_mode = values.pinv().mode()
float direct_trace = values.pinv().trace()
float direct_det = values.pinv().det()
int direct_rank = values.pinv().rank()
int transposed_columns = values.pinv().transpose().columns()
int sliced_rows = values.pinv().submatrix().rows()
int inverted_rows = values.pinv().inv().rows()
int pseudo_rows = values.pinv().pinv().rows()
int vector_rows = values.pinv().eigenvectors().rows()
int powered_rows = values.pinv().pow(2).rows()
matrix<float> kron_other = matrix.new<float>(1, 1, 2.0)
int kron_rows = values.pinv().kron(kron_other).rows()
float diff_get = values.pinv().diff(1.0).get(0, 0)
float mult_get = values.pinv().mult(2.0).get(0, 0)

plot(direct_rows + direct_columns + direct_elements + direct_get + nested_copy.get(0, 0) + int_get + direct_row.size() + direct_col.size() + direct_eigenvalues.size() + (direct_is_square ? 1 : 0) + (direct_is_zero ? 1 : 0) + (direct_is_binary ? 1 : 0) + (direct_is_diagonal ? 1 : 0) + (direct_is_identity ? 1 : 0) + (direct_is_symmetric ? 1 : 0) + (direct_is_antisymmetric ? 1 : 0) + (direct_is_stochastic ? 1 : 0) + direct_sum + direct_avg + direct_min + direct_max + direct_mode + direct_trace + direct_det + direct_rank + transposed_columns + pinvRows(values))
plot(sliced_rows)
plot(inverted_rows)
plot(pseudo_rows)
plot(vector_rows)
plot(powered_rows)
plot(kron_rows)
plot(diff_get)
plot(mult_get)
values.pinv().set(0, 0, 2.0)
values.pinv().fill(2.0)
values.pinv().reverse()
values.pinv().reshape(1, 6)
values.pinv().swap_rows(0, 1)
values.pinv().swap_columns(0, 1)
values.pinv().remove_row(0)
values.pinv().remove_col(0)
values.pinv().add_row(0, array.from(1.0))
values.pinv().add_col(0, array.from(1.0))
values.pinv().sort()
