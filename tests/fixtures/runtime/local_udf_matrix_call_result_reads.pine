//@version=6
indicator("Local UDF matrix call-result reads")

identity(values) => values

blockIdentity(values) =>
    alias = values
    alias

nestedIdentity(values) => identity(values)

pick(first, second, bool choose) => choose ? first : second

matrixFactory(left, right) => left.mult(right)

readSecond(values) => identity(values).get(0, 1)

makeInt(int value) => matrix.new<int>(1, 1, value)

floats = matrix.new<float>(2, 2, 0.0)
floats.set(0, 0, 1.0)
floats.set(0, 1, 2.0)
floats.set(1, 0, 3.0)
floats.set(1, 1, 4.0)

alternate = matrix.new<float>(2, 2, 8.0)
ints = matrix.new<int>(1, 2, 7)
bools = matrix.new<bool>(1, 1, true)
strings = matrix.new<string>(1, 1, "pine")
colors = matrix.new<color>(1, 1, color.red)
empty = matrix.new<float>(0, 3)
complex_vectors = matrix.new<float>(2, 2, 0.0)
complex_vectors.set(0, 1, -1.0)
complex_vectors.set(1, 0, 1.0)
invalid_vectors = matrix.new<float>(1, 1)

copied = identity(floats).copy()
copied.set(0, 0, 99.0)
fresh_row = identity(floats).row(0)
fresh_row.set(0, 77.0)
fresh_col = identity(floats).col(0)
fresh_col.set(0, 66.0)
fresh_eigenvalues = identity(floats).eigenvalues()
fresh_eigenvalues.set(0, 55.0)

plot(identity(floats).rows(), "rows")
plot(identity(floats).columns(), "columns")
plot(identity(floats).elements_count(), "elements")
plot(identity(floats).get(0, 1), "get")
plot(identity(floats).copy().get(1, 1), "copy_chain")
plot(identity(floats).row(1).first(), "row_float")
plot(identity(ints).row(0).last(), "row_int")
plot(identity(strings).row(0).first() == "pine" ? 1 : 0, "row_string")
plot(identity(bools).row(0).first() ? 1 : 0, "row_bool")
plot(identity(colors).row(0).first() == color.red ? 1 : 0, "row_color")
plot(identity(floats).row(0).copy().size(), "row_copy_size")
plot(floats.get(0, 0), "row_source_independent")
plot(fresh_row.get(0), "row_copy_independent")
plot(identity(floats).col(1).last(), "col_float")
plot(identity(ints).col(1).first(), "col_int")
plot(identity(strings).col(0).first() == "pine" ? 1 : 0, "col_string")
plot(identity(bools).col(0).first() ? 1 : 0, "col_bool")
plot(identity(colors).col(0).first() == color.red ? 1 : 0, "col_color")
plot(identity(floats).col(0).copy().size(), "col_copy_size")
plot(floats.get(0, 0), "col_source_independent")
plot(fresh_col.get(0), "col_copy_independent")
plot(identity(floats).eigenvalues().first(), "eigenvalues_float")
plot(identity(matrix.new<int>(2, 2, 7)).eigenvalues().size(), "eigenvalues_int")
plot(identity(floats).eigenvalues().copy().size(), "eigenvalues_copy_size")
plot(floats.get(0, 0), "eigenvalues_source_independent")
plot(fresh_eigenvalues.get(0), "eigenvalues_copy_independent")
plot(identity(floats).is_square() ? 1 : 0, "is_square_float")
plot(identity(strings).is_square() ? 1 : 0, "is_square_string")
plot(identity(floats).is_zero() ? 1 : 0, "is_zero_float")
plot(identity(ints).is_zero() ? 1 : 0, "is_zero_int")
plot(identity(floats).is_binary() ? 1 : 0, "is_binary_float")
plot(identity(ints).is_binary() ? 1 : 0, "is_binary_int")
plot(identity(floats).is_diagonal() ? 1 : 0, "is_diagonal_float")
plot(identity(ints).is_diagonal() ? 1 : 0, "is_diagonal_int")
plot(identity(floats).is_identity() ? 1 : 0, "is_identity_float")
plot(identity(ints).is_identity() ? 1 : 0, "is_identity_int")
plot(identity(floats).is_symmetric() ? 1 : 0, "is_symmetric_float")
plot(identity(ints).is_symmetric() ? 1 : 0, "is_symmetric_int")
plot(identity(floats).is_antisymmetric() ? 1 : 0, "is_antisymmetric_float")
plot(identity(ints).is_antisymmetric() ? 1 : 0, "is_antisymmetric_int")
plot(identity(floats).is_stochastic() ? 1 : 0, "is_stochastic_float")
plot(identity(ints).is_stochastic() ? 1 : 0, "is_stochastic_int")
plot(identity(floats).avg(), "sum_float")
plot(identity(ints).avg(), "sum_int")
plot(identity(floats).avg(), "avg_float")
plot(identity(ints).avg(), "avg_int")
plot(identity(floats).min(), "min_float")
plot(identity(ints).min(), "min_int")
plot(identity(floats).max(), "max_float")
plot(identity(ints).max(), "max_int")
plot(identity(alternate).mode(), "mode_float")
plot(identity(ints).mode(), "mode_int")
plot(na(identity(floats).mode()) ? 1 : 0, "mode_unique_is_na")
plot(identity(floats).trace(), "trace_float")
plot(identity(ints).trace(), "trace_int")
plot(identity(floats).det(), "det_float")
plot(identity(matrix.new<int>(2, 2, 7)).det(), "det_int")
plot(identity(floats).rank(), "rank_float")
plot(identity(ints).rank(), "rank_int")
plot(floats.get(0, 0), "source_independent")
plot(copied.get(0, 0), "copy_independent")
plot(identity(ints).get(0, 1), "generic_int")
plot(identity(floats).get(0, 0), "generic_float_again")
plot(identity(strings).get(0, 0) == "pine" ? 1 : 0, "generic_string")
plot(identity(bools).get(0, 0) ? 1 : 0, "generic_bool")
plot(identity(empty).rows() * 100 + identity(empty).columns() * 10 + identity(empty).elements_count(), "empty_shape")
plot(blockIdentity(floats).get(1, 1), "block_return")
plot(nestedIdentity(floats).get(1, 0), "nested_return")
plot(pick(second=alternate, first=floats, choose=false).get(0, 0), "named_control_flow")
plot(matrixFactory(floats, alternate).get(0, 0), "matrix_result")
plot(readSecond(floats), "nested_direct_read")
plot(makeInt(9).copy().get(0, 0), "constructed_result")
plot(identity(floats).transpose().rows(), "transpose_rows")
plot(identity(floats).transpose().columns(), "transpose_columns")
plot(identity(floats).transpose().get(1, 0), "transpose_get")
plot(identity(floats).transpose().copy().transpose().get(0, 1), "transpose_copy_chain_get")
plot(identity(ints).transpose().get(1, 0), "transpose_int")
plot(identity(bools).transpose().get(0, 0) ? 1 : 0, "transpose_bool")
plot(identity(strings).transpose().get(0, 0) == "pine" ? 1 : 0, "transpose_string")
plot(identity(colors).transpose().get(0, 0) == color.red ? 1 : 0, "transpose_color")
plot(identity(floats).submatrix(0, 1, 0, 2).rows(), "submatrix_rows")
plot(identity(floats).submatrix(0, 1, 0, 2).columns(), "submatrix_columns")
plot(identity(floats).submatrix(from_row=0, to_row=2, from_column=0, to_column=2).get(1, 0), "submatrix_get")
plot(identity(floats).transpose().submatrix().copy().get(1, 0), "submatrix_nested_get")
plot(identity(ints).submatrix().get(0, 1), "submatrix_int")
plot(identity(bools).submatrix().get(0, 0) ? 1 : 0, "submatrix_bool")
plot(identity(strings).submatrix().get(0, 0) == "pine" ? 1 : 0, "submatrix_string")
plot(identity(colors).submatrix().get(0, 0) == color.red ? 1 : 0, "submatrix_color")
plot(identity(empty).submatrix().rows() * 100 + identity(empty).submatrix().columns() * 10 + identity(empty).submatrix().elements_count(), "submatrix_empty_shape")
plot(identity(floats).inv().rows(), "inv_rows")
plot(identity(floats).inv().columns(), "inv_columns")
plot(identity(floats).inv().get(0, 1), "inv_get")
plot(identity(floats).inv().inv().get(1, 0), "inv_chain_get")
plot(identity(floats).inv().submatrix().transpose().get(1, 0), "inv_nested_get")
plot(identity(matrix.new<int>(1, 1, 2)).inv().get(0, 0), "inv_int")
plot(identity(matrix.new<int>(1, 1, 2)).inv().inv().get(0, 0), "inv_int_chain")
plot(na(identity(matrix.new<float>(2, 2, 1.0)).inv().rows()) ? 1 : 0, "inv_singular_na")
plot(identity(matrix.new<float>(0, 0)).inv().rows() * 100 + identity(matrix.new<float>(0, 0)).inv().columns() * 10 + identity(matrix.new<float>(0, 0)).inv().elements_count(), "inv_empty_shape")
plot(identity(floats).pinv().rows(), "pinv_rows")
plot(identity(floats).pinv().columns(), "pinv_columns")
plot(identity(floats).pinv().get(0, 0), "pinv_get")
plot(identity(floats).pinv().pinv().rows() * 100 + identity(floats).pinv().pinv().columns() * 10, "pinv_chain_shape")
plot(identity(matrix.new<float>(2, 2, 1.0)).pinv().get(0, 1), "pinv_singular_get")
plot(identity(matrix.new<int>(1, 1, 2)).pinv().get(0, 0), "pinv_int")
plot(na(identity(matrix.new<float>(1, 1)).pinv().rows()) ? 1 : 0, "pinv_invalid_na")
plot(identity(matrix.new<float>(0, 3)).pinv().rows() * 100 + identity(matrix.new<float>(0, 3)).pinv().columns() * 10 + identity(matrix.new<float>(0, 3)).pinv().elements_count(), "pinv_empty_shape")
plot(identity(floats).copy().pinv().transpose().get(0, 0), "pinv_nested_get")
plot(identity(floats).eigenvectors().rows(), "eigenvectors_rows")
plot(identity(floats).eigenvectors().columns(), "eigenvectors_columns")
plot(identity(floats).eigenvectors().get(0, 0), "eigenvectors_get")
plot(identity(floats).eigenvectors().eigenvectors().get(1, 1), "eigenvectors_chain_get")
plot(identity(matrix.new<int>(2, 2, 2)).eigenvectors().get(0, 0), "eigenvectors_int")
plot(na(identity(complex_vectors).eigenvectors().rows()) ? 1 : 0, "eigenvectors_complex_na")
plot(na(identity(invalid_vectors).eigenvectors().rows()) ? 1 : 0, "eigenvectors_invalid_na")
plot(identity(matrix.new<float>(0, 0)).eigenvectors().rows() * 100 + identity(matrix.new<float>(0, 0)).eigenvectors().columns() * 10 + identity(matrix.new<float>(0, 0)).eigenvectors().elements_count(), "eigenvectors_empty_shape")
plot(identity(floats).copy().eigenvectors().pinv().get(0, 0), "eigenvectors_nested_get")
plot(identity(floats).pow(2).rows(), "pow_rows")
plot(identity(floats).pow(2).columns(), "pow_columns")
plot(identity(floats).pow(2).get(0, 0), "pow_get")
plot(identity(floats).pow(2).pow(2).get(1, 1), "pow_chain_get")
plot(identity(floats).pow(0).get(0, 0), "pow_identity_get")
plot(identity(matrix.new<int>(1, 1, 2)).pow(3).get(0, 0), "pow_int")
plot(na(identity(invalid_vectors).pow(2).get(0, 0)) ? 1 : 0, "pow_invalid_na")
plot(identity(matrix.new<float>(0, 0)).pow(2).rows() * 100 + identity(matrix.new<float>(0, 0)).pow(2).columns() * 10 + identity(matrix.new<float>(0, 0)).pow(2).elements_count(), "pow_empty_shape")
plot(identity(floats).copy().pow(2).pinv().get(0, 0), "pow_nested_get")
kron_other = matrix.new<float>(1, 1, 2.0)
kron_chain_copy = identity(floats).kron(kron_other)
kron_chain_copy.set(0, 0, 777.0)
plot(identity(floats).kron(kron_other).rows(), "kron_rows")
plot(identity(floats).kron(kron_other).columns(), "kron_columns")
plot(identity(floats).kron(kron_other).get(0, 1), "kron_get")
plot(identity(floats).kron(kron_other).kron(kron_other).get(1, 1), "kron_chain_get")
plot(identity(matrix.new<int>(1, 1, 2)).kron(matrix.new<int>(1, 1, 3)).get(0, 0), "kron_int")
plot(na(identity(invalid_vectors).kron(kron_other).get(0, 0)) ? 1 : 0, "kron_invalid_na")
plot(identity(empty).kron(kron_other).rows() * 100 + identity(empty).kron(kron_other).columns() * 10 + identity(empty).kron(kron_other).elements_count(), "kron_empty_shape")
plot(identity(floats).copy().kron(kron_other).pinv().get(0, 0), "kron_nested_get")
plot(kron_chain_copy.get(0, 0), "kron_mutation")
plot(floats.get(0, 0), "kron_source_unchanged")
diff_chain_copy = identity(floats).diff(1.0)
diff_chain_copy.set(0, 0, 781.0)
plot(identity(floats).diff(1.0).rows(), "diff_rows")
plot(identity(floats).diff(1.0).columns(), "diff_columns")
plot(identity(floats).diff(1.0).get(0, 1), "diff_get")
plot(identity(floats).diff(1.0).diff(2.0).get(1, 1), "diff_chain_get")
plot(identity(matrix.new<int>(1, 1, 5)).diff(2).get(0, 0), "diff_int")
plot(na(identity(floats).diff(na).get(0, 0)) ? 1 : 0, "diff_scalar_na")
plot(na(identity(invalid_vectors).diff(1.0).get(0, 0)) ? 1 : 0, "diff_invalid_na")
plot(identity(empty).diff(1.0).rows() * 100 + identity(empty).diff(1.0).columns() * 10 + identity(empty).diff(1.0).elements_count(), "diff_empty_shape")
plot(identity(floats).copy().diff(1.0).kron(kron_other).get(0, 0), "diff_nested_get")
plot(diff_chain_copy.get(0, 0), "diff_mutation")
plot(floats.get(0, 0), "diff_source_unchanged")
mult_chain_copy = identity(floats).mult(2.0)
mult_chain_copy.set(0, 0, 785.0)
mult_array_chain_copy = identity(floats).mult(array.from(1.0, 2.0))
mult_array_chain_copy.set(0, 786.0)
plot(identity(floats).mult(2.0).rows(), "mult_rows")
plot(identity(floats).mult(2.0).columns(), "mult_columns")
plot(identity(floats).mult(2.0).get(0, 1), "mult_scalar_get")
plot(identity(floats).mult(matrix.new<float>(2, 1, 1.0)).get(1, 0), "mult_matrix_get")
plot(identity(floats).mult(array.from(1.0, 2.0)).copy().get(1), "mult_array_get")
plot(identity(floats).mult(2.0).mult(0.5).get(1, 1), "mult_chain_get")
plot(identity(ints).mult(matrix.new<int>(2, 1, 3)).get(0, 0), "mult_int")
plot(na(identity(floats).mult(na).get(0, 0)) ? 1 : 0, "mult_scalar_na")
plot(na(identity(invalid_vectors).mult(2.0).get(0, 0)) ? 1 : 0, "mult_invalid_na")
plot(identity(empty).mult(2.0).rows() * 100 + identity(empty).mult(2.0).columns() * 10 + identity(empty).mult(2.0).elements_count(), "mult_empty_shape")
plot(identity(empty).mult(array.from(1.0, 1.0, 1.0)).size(), "mult_empty_array_size")
plot(identity(floats).copy().mult(2.0).diff(1.0).get(0, 0), "mult_nested_get")
plot(mult_chain_copy.get(0, 0), "mult_mutation")
plot(mult_array_chain_copy.get(0), "mult_array_mutation")
plot(floats.get(0, 0), "mult_source_unchanged")
plot(identity(floats).mult(array.from(1.0, 2.0)).get(0), "mult_array_source_unchanged")
set_alias_source = matrix.new<float>(1, 1, 1.0)
identity(set_alias_source).set(0, 0, 111.0)
plot(set_alias_source.get(0, 0) == 111.0 ? 1 : 0, "call_result_set_alias")
fill_alias_source = matrix.new<float>(2, 2, 1.0)
identity(fill_alias_source).fill(311.0)
plot(fill_alias_source.get(0, 0) == 311.0 and fill_alias_source.get(1, 1) == 311.0 ? 1 : 0, "call_result_fill_alias")
reverse_alias_source = matrix.new<float>(2, 2, 0.0)
reverse_alias_source.set(0, 0, 1.0)
reverse_alias_source.set(0, 1, 2.0)
reverse_alias_source.set(1, 0, 3.0)
reverse_alias_source.set(1, 1, 4.0)
identity(reverse_alias_source).reverse()
plot(reverse_alias_source.get(0, 0) == 4.0 and reverse_alias_source.get(0, 1) == 3.0 and reverse_alias_source.get(1, 0) == 2.0 and reverse_alias_source.get(1, 1) == 1.0 ? 1 : 0, "call_result_reverse_alias")
reshape_alias_source = matrix.new<float>(2, 2, 0.0)
reshape_alias_source.set(0, 0, 1.0)
reshape_alias_source.set(0, 1, 2.0)
reshape_alias_source.set(1, 0, 3.0)
reshape_alias_source.set(1, 1, 4.0)
identity(reshape_alias_source).reshape(1, 4)
plot(reshape_alias_source.rows() == 1 and reshape_alias_source.columns() == 4 and reshape_alias_source.get(0, 0) == 1.0 and reshape_alias_source.get(0, 3) == 4.0 ? 1 : 0, "call_result_reshape_alias")
swap_rows_alias_source = matrix.new<float>(2, 2, 0.0)
swap_rows_alias_source.set(0, 0, 1.0)
swap_rows_alias_source.set(0, 1, 2.0)
swap_rows_alias_source.set(1, 0, 3.0)
swap_rows_alias_source.set(1, 1, 4.0)
identity(swap_rows_alias_source).swap_rows(0, 1)
plot(swap_rows_alias_source.get(0, 0) == 3.0 and swap_rows_alias_source.get(0, 1) == 4.0 and swap_rows_alias_source.get(1, 0) == 1.0 and swap_rows_alias_source.get(1, 1) == 2.0 ? 1 : 0, "call_result_swap_rows_alias")
swap_columns_alias_source = matrix.new<float>(2, 2, 0.0)
swap_columns_alias_source.set(0, 0, 1.0)
swap_columns_alias_source.set(0, 1, 2.0)
swap_columns_alias_source.set(1, 0, 3.0)
swap_columns_alias_source.set(1, 1, 4.0)
identity(swap_columns_alias_source).swap_columns(0, 1)
plot(swap_columns_alias_source.get(0, 0) == 2.0 and swap_columns_alias_source.get(0, 1) == 1.0 and swap_columns_alias_source.get(1, 0) == 4.0 and swap_columns_alias_source.get(1, 1) == 3.0 ? 1 : 0, "call_result_swap_columns_alias")
remove_row_alias_source = matrix.new<float>(2, 2, 0.0)
remove_row_alias_source.set(0, 0, 1.0)
remove_row_alias_source.set(0, 1, 2.0)
remove_row_alias_source.set(1, 0, 3.0)
remove_row_alias_source.set(1, 1, 4.0)
identity(remove_row_alias_source).remove_row(0)
plot(remove_row_alias_source.rows() == 1 and remove_row_alias_source.columns() == 2 and remove_row_alias_source.get(0, 0) == 3.0 and remove_row_alias_source.get(0, 1) == 4.0 ? 1 : 0, "call_result_remove_row_alias")
remove_row_zero_columns_alias = matrix.new<float>(2, 0, 0.0)
identity(remove_row_zero_columns_alias).remove_row(0)
plot(remove_row_zero_columns_alias.rows() == 1 and remove_row_zero_columns_alias.columns() == 0 ? 1 : 0, "call_result_remove_row_zero_columns_alias")
remove_col_alias_source = matrix.new<float>(2, 2, 0.0)
remove_col_alias_source.set(0, 0, 1.0)
remove_col_alias_source.set(0, 1, 2.0)
remove_col_alias_source.set(1, 0, 3.0)
remove_col_alias_source.set(1, 1, 4.0)
identity(remove_col_alias_source).remove_col(0)
plot(remove_col_alias_source.rows() == 2 and remove_col_alias_source.columns() == 1 and remove_col_alias_source.get(0, 0) == 2.0 and remove_col_alias_source.get(1, 0) == 4.0 ? 1 : 0, "call_result_remove_col_alias")
remove_col_zero_rows_alias = matrix.new<float>(0, 2, 0.0)
identity(remove_col_zero_rows_alias).remove_col(0)
plot(remove_col_zero_rows_alias.rows() == 0 and remove_col_zero_rows_alias.columns() == 1 ? 1 : 0, "call_result_remove_col_zero_rows_alias")
add_row_alias_source = matrix.new<float>(2, 2, 0.0)
add_row_alias_source.set(0, 0, 1.0)
add_row_alias_source.set(0, 1, 2.0)
add_row_alias_source.set(1, 0, 3.0)
add_row_alias_source.set(1, 1, 4.0)
add_row_values = array.from(5.0, 6.0)
identity(add_row_alias_source).add_row(1, add_row_values)
add_row_values.set(0, 99.0)
plot(add_row_alias_source.rows() == 3 and add_row_alias_source.columns() == 2 and add_row_alias_source.get(0, 0) == 1.0 and add_row_alias_source.get(1, 0) == 5.0 and add_row_alias_source.get(1, 1) == 6.0 and add_row_alias_source.get(2, 0) == 3.0 ? 1 : 0, "call_result_add_row_alias_copied_values")
add_row_zero_columns_alias = matrix.new<float>(0, 0, 0.0)
identity(add_row_zero_columns_alias).add_row(0, array.new<float>(0))
plot(add_row_zero_columns_alias.rows() == 1 and add_row_zero_columns_alias.columns() == 0 ? 1 : 0, "call_result_add_row_zero_columns_alias")
add_col_alias_source = matrix.new<float>(2, 2, 0.0)
add_col_alias_source.set(0, 0, 1.0)
add_col_alias_source.set(0, 1, 2.0)
add_col_alias_source.set(1, 0, 3.0)
add_col_alias_source.set(1, 1, 4.0)
add_col_values = array.from(5.0, 6.0)
identity(add_col_alias_source).add_col(1, add_col_values)
add_col_values.set(0, 99.0)
plot(add_col_alias_source.rows() == 2 and add_col_alias_source.columns() == 3 and add_col_alias_source.get(0, 0) == 1.0 and add_col_alias_source.get(0, 1) == 5.0 and add_col_alias_source.get(0, 2) == 2.0 and add_col_alias_source.get(1, 1) == 6.0 ? 1 : 0, "call_result_add_col_alias_copied_values")
add_col_zero_rows_alias = matrix.new<float>(0, 0, 0.0)
identity(add_col_zero_rows_alias).add_col(0, array.new<float>(0))
plot(add_col_zero_rows_alias.rows() == 0 and add_col_zero_rows_alias.columns() == 1 ? 1 : 0, "call_result_add_col_zero_rows_alias")
sort_alias_source = matrix.new<float>(4, 2, na)
sort_alias_source.set(0, 0, 2.0)
sort_alias_source.set(0, 1, 20.0)
sort_alias_source.set(1, 0, 1.0)
sort_alias_source.set(1, 1, 10.0)
sort_alias_source.set(2, 0, 3.0)
sort_alias_source.set(2, 1, 10.0)
sort_alias_source.set(3, 0, 4.0)
identity(sort_alias_source).sort(1)
plot(sort_alias_source.get(0, 0) == 1.0 and sort_alias_source.get(1, 0) == 3.0 and sort_alias_source.get(2, 0) == 2.0 and sort_alias_source.get(3, 0) == 4.0 ? 1 : 0, "call_result_sort_alias_stable_na_last")
sort_int_alias_source = matrix.new<int>(3, 1, 0)
sort_int_alias_source.set(0, 0, 1)
sort_int_alias_source.set(1, 0, 3)
sort_int_alias_source.set(2, 0, 2)
identity(sort_int_alias_source).sort(0, order.descending)
plot(sort_int_alias_source.get(0, 0) == 3 and sort_int_alias_source.get(1, 0) == 2 and sort_int_alias_source.get(2, 0) == 1 ? 1 : 0, "call_result_sort_int_alias_descending")
