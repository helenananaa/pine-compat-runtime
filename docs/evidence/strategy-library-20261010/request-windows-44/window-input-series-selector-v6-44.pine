//@version=6
indicator("window-input-series-selector-v6-44",dynamic_requests=true)
enabled=input.bool(true,"input-series-selector-44")
s=bar_index%2==0?"NASDAQ:AAPL":syminfo.tickerid
float a=na
if enabled
    a:=request.security(s,timeframe.period,bar_index,calc_bars_count=2)
var count=0
count+=1
plot(bar_index)
plot(na(a)?-1:a)
plot(count)
