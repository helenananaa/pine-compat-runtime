//@version=5
indicator("Codex uneven export oracle", overlay=true, dynamic_requests=false)
a=request.security(syminfo.tickerid,"11",time,lookahead=barmerge.lookahead_off)
b=request.security(syminfo.tickerid,"11",time,lookahead=barmerge.lookahead_on)
inner=request.security(syminfo.tickerid,timeframe.period,time)
c=request.security(syminfo.tickerid,"11",inner)
d=request.security(syminfo.tickerid,"11",inner,lookahead=barmerge.lookahead_on)
e=request.security(syminfo.tickerid,"20",time)
f=request.security(syminfo.tickerid,"20",time,lookahead=barmerge.lookahead_on)
plot(time,"chart.time",display=display.data_window)
plot(inner,"inner.time",display=display.data_window)
plot(a,"req11.off",display=display.data_window)
plot(b,"req11.on",display=display.data_window)
plot(c,"static11.off",display=display.data_window)
plot(d,"static11.on",display=display.data_window)
plot(e,"req20.off",display=display.data_window)
plot(f,"req20.on",display=display.data_window)
plot(request.security(syminfo.tickerid,"20",close,lookahead=barmerge.lookahead_off),"price20.off",display=display.data_window)
plot(request.security(syminfo.tickerid,"20",close,lookahead=barmerge.lookahead_on),"price20.on",display=display.data_window)
plot(request.security(syminfo.tickerid,"20",time_close),"close20.off",display=display.data_window)
plot(request.security(syminfo.tickerid,"11",time_close),"close11.off",display=display.data_window)
plot(barstate.ishistory?1:0,"history",display=display.data_window)
plot(request.security(syminfo.tickerid,"11",time,gaps=barmerge.gaps_on),"gap11.off",display=display.data_window)
plot(request.security(syminfo.tickerid,"11",time,gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_on),"gap11.on",display=display.data_window)
plot(request.security(syminfo.tickerid,"20",time,gaps=barmerge.gaps_on),"gap20.off",display=display.data_window)
plot(request.security(syminfo.tickerid,"20",time,gaps=barmerge.gaps_on,lookahead=barmerge.lookahead_on),"gap20.on",display=display.data_window)
