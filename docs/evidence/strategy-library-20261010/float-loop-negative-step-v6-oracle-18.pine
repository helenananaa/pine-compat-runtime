//@version=6
strategy("Float loop negative step oracle 18",precision=6,default_qty_value=2)
a=0.0
b=0.0
c=0.0
d=0.0
for i=0.8 to 3.8 by -0.5
    a+=i
for j=-0.8 to -3.8
    b+=j
for k=-3 to -0.8
    c+=1
for m=3 to 0.8
    d+=1
plot(a,title="float step")
plot(b,title="descending float")
plot(c,title="negative fractional end count")
plot(d,title="positive fractional end count")
f(a=strategy.position_avg_price,p=strategy.position_size)=>nz(a)+p
if bar_index==0
    strategy.entry("L",strategy.long)
plot(f(),title="default state")
