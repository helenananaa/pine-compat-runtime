//@version=6
indicator("Method qualifier propagation")

type QualifierTool
    int seed

method inc(QualifierTool tool, int x) => x + 1
method pass_tf(QualifierTool tool, simple string tf) =>
    local = tf
    local
method choose_length(QualifierTool tool, bool flag, int x) =>
    if flag
        local = x
        local
    else
        local = x + 1
        local
method loop_tf(QualifierTool tool, simple string tf) =>
    for i = 0 to 0
        local = tf
        local
method loop_in_length(QualifierTool tool, array<int> values, int x) =>
    for value in values
        local = x
        local
method choose_branch_loop_length(QualifierTool tool, bool flag, array<int> values, int x) =>
    if flag
        for i = 0 to 0
            x
    else
        for value in values
            x
method choose_branch_while_length(QualifierTool tool, bool flag, int x) =>
    if flag
        while false
            x
    else
        x
method if_expr_loop_length(QualifierTool tool, bool flag, int x) =>
    if flag
        for i = 0 to 0
            x
    else
        for i = 0 to 0
            x + 1
method switch_block_loop_length(QualifierTool tool, bool flag, int x) =>
    switch
        flag =>
            for i = 0 to 0
                x
        =>
            while false
                x + 1
method nested_loop_length(QualifierTool tool, array<int> values, bool flag, int x) =>
    for outer = 0 to 0
        for value in values
            while flag
                x
method while_length(QualifierTool tool, bool flag, int x) =>
    while flag
        x

tool = QualifierTool.new(1)
length = input.int(2, "Length")
flag = input.bool(true, "Flag")
loop_flag = input.bool(false, "Loop")
simple_values = array.from(1, 2)
chart_tf = timeframe.period

plot(ta.sma(close, tool.inc(length)))
plot(timeframe.in_seconds(tool.pass_tf(chart_tf)))
plot(ta.sma(close, tool.choose_length(flag, length)))
plot(timeframe.in_seconds(tool.loop_tf(chart_tf)))
plot(ta.sma(close, tool.loop_in_length(simple_values, length)))
plot(ta.sma(close, tool.choose_branch_loop_length(flag, simple_values, length)))
plot(ta.sma(close, tool.choose_branch_while_length(flag, length)))
plot(ta.sma(close, tool.if_expr_loop_length(flag, length)))
plot(ta.sma(close, tool.switch_block_loop_length(flag, length)))
plot(ta.sma(close, tool.nested_loop_length(simple_values, loop_flag, length)))
plot(ta.sma(close, tool.while_length(loop_flag, length)))
