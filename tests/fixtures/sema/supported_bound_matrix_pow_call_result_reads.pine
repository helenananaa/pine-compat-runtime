//@version=6
indicator("Supported bound matrix.pow call-result reads")

powRows(values, power) => values.pow(power).copy().rows()

values = matrix.new<float>(2, 2, 2.0)
ints = matrix.new<int>(1, 1, 2)

int direct_rows = values.pow(2).rows()
int direct_columns = values.pow(2).columns()
int direct_elements = values.pow(2).elements_count()
float direct_get = values.pow(2).get(row=1, column=1)
float identity_get = values.pow(0).get(0, 0)
matrix<float> nested_copy = values.pow(1).copy()
float int_get = ints.pow(3).get(0, 0)
array<float> direct_row = values.pow(2).row(1).copy()
array<float> direct_col = values.pow(2).col(1).copy()
array<float> direct_eigenvalues = values.pow(2).eigenvalues().copy()
bool direct_is_square = values.pow(2).is_square()
bool direct_is_zero = values.pow(2).is_zero()
bool direct_is_binary = values.pow(2).is_binary()
bool direct_is_diagonal = values.pow(2).is_diagonal()
bool direct_is_identity = values.pow(2).is_identity()
bool direct_is_symmetric = values.pow(2).is_symmetric()
bool direct_is_antisymmetric = values.pow(2).is_antisymmetric()
bool direct_is_stochastic = values.pow(2).is_stochastic()
float direct_sum = values.pow(2).avg()
float direct_avg = values.pow(2).avg()
float direct_min = values.pow(2).min()
float direct_max = values.pow(2).max()
float direct_mode = values.pow(2).mode()
float direct_trace = values.pow(2).trace()
float direct_det = values.pow(2).det()
int direct_rank = values.pow(2).rank()
int transposed_columns = values.pow(2).transpose().columns()
int sliced_rows = values.pow(2).submatrix().rows()
int inverted_rows = values.pow(2).inv().rows()
int pseudo_rows = values.pow(2).pinv().rows()
int vector_rows = values.pow(2).eigenvectors().rows()
int powered_rows = values.pow(2).pow(2).rows()
matrix<float> kron_other = matrix.new<float>(1, 1, 2.0)
int kron_rows = values.pow(2).kron(kron_other).rows()
float diff_get = values.pow(2).diff(1.0).get(0, 0)
float mult_get = values.pow(2).mult(2.0).get(0, 0)

plot(direct_rows + direct_columns + direct_elements + direct_get + identity_get + nested_copy.get(0, 0) + int_get + direct_row.size() + direct_col.size() + direct_eigenvalues.size() + (direct_is_square ? 1 : 0) + (direct_is_zero ? 1 : 0) + (direct_is_binary ? 1 : 0) + (direct_is_diagonal ? 1 : 0) + (direct_is_identity ? 1 : 0) + (direct_is_symmetric ? 1 : 0) + (direct_is_antisymmetric ? 1 : 0) + (direct_is_stochastic ? 1 : 0) + direct_sum + direct_avg + direct_min + direct_max + direct_mode + direct_trace + direct_det + direct_rank + transposed_columns + powRows(values, 2))
plot(sliced_rows)
plot(inverted_rows)
plot(pseudo_rows)
plot(vector_rows)
plot(powered_rows)
plot(kron_rows)
plot(diff_get)
plot(mult_get)
values.pow(2).set(0, 0, 2.0)
values.pow(2).fill(2.0)
values.pow(2).reverse()
values.pow(2).reshape(1, 4)
values.pow(2).swap_rows(0, 1)
values.pow(2).swap_columns(0, 1)
values.pow(2).remove_row(0)
values.pow(2).remove_col(0)
values.pow(2).add_row(0, array.from(1.0))
values.pow(2).add_col(0, array.from(1.0))
values.pow(2).sort()
