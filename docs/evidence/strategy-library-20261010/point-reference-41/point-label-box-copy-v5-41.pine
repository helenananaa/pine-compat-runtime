//@version=5
indicator("point-label-box-copy-v5-41")
p=chart.point.from_index(0,10)
q=chart.point.from_index(1,20)
l=label.new(p,"point")
b=box.new(p,q)
p.price:=30
plot(label.get_y(l))
plot(box.get_top(b))
label.set_point(l,p)
box.set_top_left_point(b,p)
p.price:=40
plot(label.get_y(l))
plot(box.get_top(b))
