//@version=6
indicator("Virtual week chart oracle 20",overlay=false)
f() =>
    [time("W","1700-1700:23456","America/New_York")-time,time_close("W","1700-1700:23456","America/New_York")-time,time("W","0930-0945:23456","America/New_York")-time,time_close("W","0930-0945:23456","America/New_York")-time]
[a,b,c,d]=request.security("NASDAQ:AAPL","D",f())
[e,f1,g,h]=request.security("NASDAQ:AAPL","60",f())
plot(a,title="dailyWeekFullOpen")
plot(b,title="dailyWeekFullClose")
plot(c,title="dailyWeekShortOpen")
plot(d,title="dailyWeekShortClose")
plot(e,title="hourWeekFullOpen")
plot(f1,title="hourWeekFullClose")
plot(g,title="hourWeekShortOpen")
plot(h,title="hourWeekShortClose")
