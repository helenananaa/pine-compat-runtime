//@version=6
indicator("Supported bound matrix.transpose call-result reads")

transposeRows(id) => id.transpose().copy().rows()

floats = matrix.new<float>(2, 3, 1.5)
ints = matrix.new<int>(1, 1, 4)
bools = matrix.new<bool>(1, 1, true)
strings = matrix.new<string>(1, 1, "value")
colors = matrix.new<color>(1, 1, color.red)
square = matrix.new<float>(2, 2, 1.0)

int direct_rows = floats.transpose().rows()
int direct_columns = floats.transpose().columns()
int direct_elements = floats.transpose().elements_count()
float direct_get = floats.transpose().get(row=1, column=0)
matrix<float> nested_copy = floats.transpose().copy()
int int_get = ints.transpose().get(0, 0)
bool bool_get = bools.transpose().get(0, 0)
string string_get = strings.transpose().get(0, 0)
color color_get = colors.transpose().get(0, 0)
array<float> direct_row = floats.transpose().row(1).copy()
array<float> direct_col = floats.transpose().col(1).copy()
array<float> direct_eigenvalues = square.transpose().eigenvalues().copy()
bool direct_is_square = floats.transpose().is_square()
bool direct_is_zero = floats.transpose().is_zero()
bool direct_is_binary = floats.transpose().is_binary()
bool direct_is_diagonal = floats.transpose().is_diagonal()
bool direct_is_identity = floats.transpose().is_identity()
bool direct_is_symmetric = floats.transpose().is_symmetric()
bool direct_is_antisymmetric = floats.transpose().is_antisymmetric()
bool direct_is_stochastic = floats.transpose().is_stochastic()
float direct_sum = floats.transpose().avg()
float direct_avg = floats.transpose().avg()
float direct_min = floats.transpose().min()
float direct_max = floats.transpose().max()
float direct_mode = floats.transpose().mode()
float direct_trace = floats.transpose().trace()
float direct_det = floats.transpose().det()
int direct_rank = floats.transpose().rank()
int transposed_rows = floats.transpose().transpose().rows()
int sliced_rows = floats.transpose().submatrix().rows()
int inverted_rows = floats.transpose().inv().rows()
int pseudo_rows = floats.transpose().pinv().rows()
int vector_rows = floats.transpose().eigenvectors().rows()
int powered_rows = floats.transpose().pow(2).rows()
matrix<float> kron_other = matrix.new<float>(1, 1, 2.0)
int kron_rows = floats.transpose().kron(kron_other).rows()
float diff_get = floats.transpose().diff(1.0).get(0, 0)
float mult_get = floats.transpose().mult(2.0).get(0, 0)

plot(direct_rows + direct_columns + direct_elements + direct_get + nested_copy.get(0, 0) + int_get + (bool_get ? 1 : 0) + (string_get == "value" ? 1 : 0) + (color_get == color.red ? 1 : 0) + direct_row.size() + direct_col.size() + direct_eigenvalues.size() + (direct_is_square ? 1 : 0) + (direct_is_zero ? 1 : 0) + (direct_is_binary ? 1 : 0) + (direct_is_diagonal ? 1 : 0) + (direct_is_identity ? 1 : 0) + (direct_is_symmetric ? 1 : 0) + (direct_is_antisymmetric ? 1 : 0) + (direct_is_stochastic ? 1 : 0) + direct_sum + direct_avg + direct_min + direct_max + direct_mode + direct_trace + direct_det + direct_rank + transposed_rows + transposeRows(floats))
plot(sliced_rows)
plot(inverted_rows)
plot(pseudo_rows)
plot(vector_rows)
plot(powered_rows)
plot(kron_rows)
plot(diff_get)
plot(mult_get)
floats.transpose().set(0, 0, 2.0)
floats.transpose().fill(2.0)
floats.transpose().reverse()
floats.transpose().reshape(2, 3)
floats.transpose().swap_rows(0, 1)
floats.transpose().swap_columns(0, 1)
floats.transpose().remove_row(0)
floats.transpose().remove_col(0)
floats.transpose().add_row(0, array.from(1.0))
floats.transpose().add_col(0, array.from(1.0))
floats.transpose().sort(0, order.descending)
