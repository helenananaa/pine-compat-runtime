//@version=6
import user/udt_array_returns/1 as left
import user/udt_array_returns/1 as right
indicator("Imported UDT array UDF and method returns")

readPostfix(values) =>
    item = left.direct(values).copy().first()
    (na(item) ? na : item.shared)

readAccessors(values) =>
    head = left.direct(values).get(index=0)
    tail = left.direct(values).last()
    left.direct(values).size() + (na(head) ? na : head.shared) + (na(tail) ? na : tail.shared)

localIdentity(values) => values

readLocalArray(values) =>
    head = localIdentity(values).get(index=0)
    first_item = localIdentity(values).first()
    tail = localIdentity(values).copy().last()
    localIdentity(values).size() + (na(head) ? na : head.shared) + (na(first_item) ? na : first_item.shared) + (na(tail) ? na : tail.shared) + localIdentity(values).copy().size()

readLocalScalar(value) =>
    localIdentity(value).size() + localIdentity(value).get(index=1) + localIdentity(value).first() + localIdentity(value).last() + localIdentity(value).copy()

left_first_values = array.from(left.First.new(11.0, 101.0), left.First.new(12.0, 102.0))
left_second_values = array.from(left.Second.new(201.0, 21.0), left.Second.new(202.0, 22.0))
