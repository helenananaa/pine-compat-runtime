//@version=6
indicator("window-input-series-guard-v6-44",dynamic_requests=true)
enabled=input.bool(true,"input-series-guard-44")
float a=na
if enabled and bar_index>=10
    a:=request.security(syminfo.tickerid,timeframe.period,bar_index,calc_bars_count=2)
var count=0
count+=1
plot(bar_index)
plot(na(a)?-1:a)
plot(count)
