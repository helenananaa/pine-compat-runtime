//@version=6
indicator("Virtual month chart oracle 20",overlay=false)
f() =>
    [time("M","0930-0945:23456","America/New_York")-time,time_close("M","0930-0945:23456","America/New_York")-time,time("W","0930-0945:23456","America/New_York",timeframe_bars_back=1)-time,time_close("W","0930-0945:23456","America/New_York",timeframe_bars_back=-1)-time]
[a,b,c,d]=request.security("NASDAQ:AAPL","D",f())
[e,f1,g,h]=request.security("NASDAQ:AAPL","60",f())
plot(a,title="dailyMonthOpen")
plot(b,title="dailyMonthClose")
plot(c,title="dailyWeekPastOpen")
plot(d,title="dailyWeekFutureClose")
plot(e,title="hourMonthOpen")
plot(f1,title="hourMonthClose")
plot(g,title="hourWeekPastOpen")
plot(h,title="hourWeekFutureClose")
