plot(matrix.diff(left, left).is_zero() ? 1 : 0, "matrix_diff_is_zero")
plot(matrix.pow(pow_values, 2).is_zero() ? 1 : 0, "matrix_pow_is_zero")
plot(matrix.inv(inv_values).is_zero() ? 1 : 0, "matrix_inv_is_zero")
