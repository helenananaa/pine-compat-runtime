//@version=6
strategy("Zero pyramiding", pyramiding=0, initial_capital=10000)
if bar_index == 0 or bar_index == 1
    strategy.entry("L", strategy.long, qty=1)
if bar_index == 2 or bar_index == 3
    strategy.entry("S", strategy.short, qty=1)
if bar_index == 4
    strategy.close_all()
plot(strategy.position_size)
plot(strategy.closedtrades)
