//@version=6
indicator("Builtin namespace matrix call-result reads")

matrixMultMatrixExpressionRead(left, right) => matrix.mult(left, right).copy().get(1, 1)

matrixCopyExpressionRead(values) => matrix.copy(values).copy().get(1, 0)

matrixTransposeExpressionRead(values) => matrix.transpose(values).copy().get(2, 1)

matrixSubmatrixExpressionRead(values) => matrix.submatrix(values, 0, 2, 1, 3).copy().get(1, 1)

matrixKronExpressionRead(left, right) => matrix.kron(left, right).copy().get(5, 5)

matrixDiffExpressionRead(left, right) => matrix.diff(left, right).copy().get(1, 2)

matrixPowExpressionRead(values) => matrix.pow(values, 2).copy().get(1, 1)

matrixInvExpressionRead(values) => matrix.inv(values).copy().get(0, 1)

matrixPinvExpressionRead(values) => matrix.pinv(values).copy().get(1, 1)

matrixEigenvectorsExpressionRead(values) => matrix.eigenvectors(values).copy().get(1, 1)

matrixNewExpressionRead() => matrix.new<int>(1, 1, 7).copy().get(0, 0)

matrixMultMatrixBlockRead(values, scalar) =>
    int rows = matrix.mult(values, scalar).rows()
    int columns = matrix.mult(scalar, values).columns()
    float first = matrix.mult(values, scalar).copy().get(0, 0)
    rows * 100 + columns * 10 + first

matrixCopyBlockRead(values) =>
    int rows = matrix.copy(values).rows()
    int columns = matrix.copy(values).columns()
    float first = matrix.copy(values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixTransposeBlockRead(values) =>
    int rows = matrix.transpose(values).rows()
    int columns = matrix.transpose(values).columns()
    float first = matrix.transpose(values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixSubmatrixBlockRead(values) =>
    int rows = matrix.submatrix(values).rows()
    int columns = matrix.submatrix(values).columns()
    float first = matrix.submatrix(values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixKronBlockRead(left, right) =>
    int rows = matrix.kron(left, right).rows()
    int columns = matrix.kron(left, right).columns()
    float first = matrix.kron(left, right).get(0, 0)
    rows * 100 + columns * 10 + first

matrixDiffBlockRead(values, scalar) =>
    int rows = matrix.diff(values, scalar).rows()
    int columns = matrix.diff(scalar, values).columns()
    float first = matrix.diff(scalar, values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixPowBlockRead(values) =>
    int rows = matrix.pow(values, 2).rows()
    int columns = matrix.pow(values, 2).columns()
    float first = matrix.pow(values, 2).get(0, 0)
    rows * 100 + columns * 10 + first

matrixInvBlockRead(values) =>
    int rows = matrix.inv(values).rows()
    int columns = matrix.inv(values).columns()
    float first = matrix.inv(values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixPinvBlockRead(values) =>
    int rows = matrix.pinv(values).rows()
    int columns = matrix.pinv(values).columns()
    float first = matrix.pinv(values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixEigenvectorsBlockRead(values) =>
    int rows = matrix.eigenvectors(values).rows()
    int columns = matrix.eigenvectors(values).columns()
    float first = matrix.eigenvectors(values).get(0, 0)
    rows * 100 + columns * 10 + first

matrixNewBlockRead() =>
    int rows = matrix.new<float>(1, 1, 7.0).rows()
    int columns = matrix.new<float>(1, 1, 7.0).columns()
    float first = matrix.new<float>(1, 1, 7.0).get(0, 0)
    rows * 100 + columns * 10 + first

left = matrix.new<float>(2, 3, 0.0)
left.set(0, 0, 1.0)
left.set(0, 1, 2.0)
left.set(0, 2, 3.0)
left.set(1, 0, 4.0)
left.set(1, 1, 5.0)
left.set(1, 2, 6.0)

right = matrix.new<float>(3, 2, 0.0)
right.set(0, 0, 7.0)
right.set(0, 1, 8.0)
right.set(1, 0, 9.0)
right.set(1, 1, 10.0)
right.set(2, 0, 11.0)
right.set(2, 1, 12.0)

diff_right = matrix.new<float>(2, 3, 1.0)

pow_values = matrix.new<float>(2, 2, 0.0)
pow_values.set(0, 0, 1.0)
pow_values.set(0, 1, 2.0)
pow_values.set(1, 0, 3.0)
pow_values.set(1, 1, 4.0)

inv_values = matrix.new<float>(2, 2, 0.0)
inv_values.set(0, 0, 4.0)
inv_values.set(0, 1, 7.0)
inv_values.set(1, 0, 2.0)
inv_values.set(1, 1, 6.0)
inv_singular = matrix.new<float>(2, 2, 1.0)
inv_na = matrix.new<float>(1, 1)
avg_partial_na = matrix.new<float>(1, 2)
matrix.set(avg_partial_na, 0, 0, 2.0)
mode_tie = matrix.new<float>(1, 5)
matrix.set(mode_tie, 0, 0, 2.0)
matrix.set(mode_tie, 0, 1, 2.0)
matrix.set(mode_tie, 0, 2, 3.0)
matrix.set(mode_tie, 0, 3, 3.0)
mode_mult_left = matrix.new<float>(2, 2, 1.0)
mode_mult_right = matrix.new<float>(2, 2, 1.0)

pinv_values = matrix.new<float>(2, 3, 0.0)
pinv_values.set(0, 0, 1.0)
pinv_values.set(1, 1, 1.0)
pinv_singular = matrix.new<float>(2, 2, 1.0)
pinv_na = matrix.new<float>(1, 1)

eigenvectors_values = matrix.new<float>(2, 2, 0.0)
eigenvectors_values.set(0, 0, 2.0)
eigenvectors_values.set(1, 1, 3.0)
eigenvectors_na = matrix.new<float>(1, 1)
eigenvectors_complex = matrix.new<float>(2, 2, 0.0)
eigenvectors_complex.set(0, 1, -1.0)
eigenvectors_complex.set(1, 0, 1.0)

matrix_matrix_shape = matrix.mult(left, right).rows() * 100 + matrix.mult(left, right).columns() * 10 + matrix.mult(left, right).elements_count()
matrix_matrix_get = matrix.mult(left, right).get(0, 0)
matrix_matrix_copy_get = matrix.mult(left, right).copy().copy().get(1, 1)
matrix_scalar_shape = matrix.mult(right, 2.0).rows() * 100 + matrix.mult(right, 2.0).columns() * 10 + matrix.mult(right, 2.0).elements_count()
matrix_scalar_get = matrix.mult(right, 2.0).get(0, 0)
matrix_scalar_copy_get = matrix.mult(right, 2.0).copy().copy().get(2, 1)
scalar_matrix_shape = matrix.mult(0.5, right).rows() * 100 + matrix.mult(0.5, right).columns() * 10 + matrix.mult(0.5, right).elements_count()
scalar_matrix_get = matrix.mult(0.5, right).get(1, 0)
scalar_matrix_copy_get = matrix.mult(0.5, right).copy().copy().get(2, 1)
fresh_row = matrix.copy(left).row(0)
fresh_row.set(0, 99.0)
fresh_col = matrix.copy(left).col(0)
fresh_col.set(0, 88.0)
fresh_eigenvalues = matrix.copy(pow_values).eigenvalues()
fresh_eigenvalues.set(0, 77.0)

plot(matrix_matrix_shape, "matrix_matrix_shape")
plot(matrix_matrix_get, "matrix_matrix_get")
plot(matrix_matrix_copy_get, "matrix_matrix_copy_get")
plot(matrix_scalar_shape, "matrix_scalar_shape")
plot(matrix_scalar_get, "matrix_scalar_get")
plot(matrix_scalar_copy_get, "matrix_scalar_copy_get")
plot(scalar_matrix_shape, "scalar_matrix_shape")
plot(scalar_matrix_get, "scalar_matrix_get")
plot(scalar_matrix_copy_get, "scalar_matrix_copy_get")
plot(matrix.mult(left, right).row(1).get(0), "matrix_mult_row_get")
plot(matrix.copy(left).row(0).copy().last(), "matrix_copy_row_last")
plot(matrix.transpose(left).row(2).get(1), "matrix_transpose_row_get")
plot(matrix.submatrix(left, 0, 2, 1, 3).row(1).first(), "matrix_submatrix_row_first")
plot(matrix.kron(left, right).row(5).last(), "matrix_kron_row_last")
plot(matrix.diff(left, diff_right).row(1).get(2), "matrix_diff_row_get")
plot(matrix.pow(pow_values, 2).row(1).first(), "matrix_pow_row_first")
plot(matrix.inv(inv_values).row(0).last(), "matrix_inv_row_last")
plot(matrix.pinv(pinv_values).row(2).get(1), "matrix_pinv_row_get")
plot(matrix.eigenvectors(eigenvectors_values).row(1).get(1), "matrix_eigenvectors_row_get")
plot(matrix.new<int>(1, 2, 7).row(0).size(), "matrix_new_row_size")
plot(left.get(0, 0), "matrix_row_source_independent")
plot(fresh_row.get(0), "matrix_row_copy_independent")
plot(matrix.mult(left, right).col(1).get(0), "matrix_mult_col_get")
plot(matrix.copy(left).col(2).copy().last(), "matrix_copy_col_last")
plot(matrix.transpose(left).col(1).last(), "matrix_transpose_col_last")
plot(matrix.submatrix(left, 0, 2, 1, 3).col(0).first(), "matrix_submatrix_col_first")
plot(matrix.kron(left, right).col(5).last(), "matrix_kron_col_last")
plot(matrix.diff(left, diff_right).col(2).get(1), "matrix_diff_col_get")
plot(matrix.pow(pow_values, 2).col(0).last(), "matrix_pow_col_last")
plot(matrix.inv(inv_values).col(1).first(), "matrix_inv_col_first")
plot(matrix.pinv(pinv_values).col(1).last(), "matrix_pinv_col_last")
plot(matrix.eigenvectors(eigenvectors_values).col(1).last(), "matrix_eigenvectors_col_last")
plot(matrix.new<int>(2, 1, 7).col(0).size(), "matrix_new_col_size")
plot(left.get(0, 0), "matrix_col_source_independent")
plot(fresh_col.get(0), "matrix_col_copy_independent")
plot(matrix.mult(left, right).eigenvalues().first(), "matrix_mult_eigenvalues_first")
plot(matrix.transpose(pow_values).eigenvalues().copy().last(), "matrix_transpose_eigenvalues_last")
plot(matrix.submatrix(left, 0, 2, 0, 2).eigenvalues().size(), "matrix_submatrix_eigenvalues_size")
plot(matrix.pow(pow_values, 2).eigenvalues().first(), "matrix_pow_eigenvalues_first")
plot(matrix.inv(inv_values).eigenvalues().last(), "matrix_inv_eigenvalues_last")
plot(matrix.eigenvectors(eigenvectors_values).eigenvalues().size(), "matrix_eigenvectors_eigenvalues_size")
plot(matrix.new<int>(2, 2, 7).eigenvalues().size(), "matrix_new_eigenvalues_size")
plot(pow_values.get(0, 0), "matrix_eigenvalues_source_independent")
plot(fresh_eigenvalues.get(0), "matrix_eigenvalues_copy_independent")
plot(matrix.mult(left, right).is_square() ? 1 : 0, "matrix_mult_is_square")
plot(matrix.copy(left).is_square() ? 1 : 0, "matrix_copy_is_square")
plot(matrix.transpose(left).is_square() ? 1 : 0, "matrix_transpose_is_square")
plot(matrix.submatrix(left, 0, 2, 0, 2).is_square() ? 1 : 0, "matrix_submatrix_is_square")
plot(matrix.kron(left, right).is_square() ? 1 : 0, "matrix_kron_is_square")
plot(matrix.diff(left, diff_right).is_square() ? 1 : 0, "matrix_diff_is_square")
plot(matrix.pow(pow_values, 2).is_square() ? 1 : 0, "matrix_pow_is_square")
plot(matrix.inv(inv_values).is_square() ? 1 : 0, "matrix_inv_is_square")
plot(na(matrix.inv(inv_singular).is_square()) ? 1 : 0, "matrix_inv_na_is_square")
plot(matrix.pinv(pinv_values).is_square() ? 1 : 0, "matrix_pinv_is_square")
plot(matrix.eigenvectors(eigenvectors_values).is_square() ? 1 : 0, "matrix_eigenvectors_is_square")
plot(matrix.new<string>(2, 2, "x").is_square() ? 1 : 0, "matrix_new_is_square")
plot(matrix.mult(left, right).is_zero() ? 1 : 0, "matrix_mult_is_zero")
plot(matrix.copy(left).is_zero() ? 1 : 0, "matrix_copy_is_zero")
