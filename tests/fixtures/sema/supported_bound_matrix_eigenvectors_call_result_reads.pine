//@version=6
indicator("Supported bound matrix.eigenvectors call-result reads")

eigenvectorRows(values) => values.eigenvectors().copy().rows()

values = matrix.new<float>(2, 2, 0.0)
values.set(0, 0, 2.0)
values.set(1, 1, 3.0)
ints = matrix.new<int>(2, 2, 0)
ints.set(0, 0, 2)
ints.set(1, 1, 3)

int direct_rows = values.eigenvectors().rows()
int direct_columns = values.eigenvectors().columns()
int direct_elements = values.eigenvectors().elements_count()
float direct_get = values.eigenvectors().get(row=0, column=0)
matrix<float> nested_copy = values.eigenvectors().copy()
float int_get = ints.eigenvectors().get(1, 1)
array<float> direct_row = values.eigenvectors().row(1).copy()
array<float> direct_col = values.eigenvectors().col(1).copy()
array<float> direct_eigenvalues = values.eigenvectors().eigenvalues().copy()
bool direct_is_square = values.eigenvectors().is_square()
bool direct_is_zero = values.eigenvectors().is_zero()
bool direct_is_binary = values.eigenvectors().is_binary()
bool direct_is_diagonal = values.eigenvectors().is_diagonal()
bool direct_is_identity = values.eigenvectors().is_identity()
bool direct_is_symmetric = values.eigenvectors().is_symmetric()
bool direct_is_antisymmetric = values.eigenvectors().is_antisymmetric()
bool direct_is_stochastic = values.eigenvectors().is_stochastic()
float direct_sum = values.eigenvectors().avg()
float direct_avg = values.eigenvectors().avg()
float direct_min = values.eigenvectors().min()
float direct_max = values.eigenvectors().max()
float direct_mode = values.eigenvectors().mode()
float direct_trace = values.eigenvectors().trace()
float direct_det = values.eigenvectors().det()
int direct_rank = values.eigenvectors().rank()
int transposed_columns = values.eigenvectors().transpose().columns()
int sliced_rows = values.eigenvectors().submatrix().rows()
int inverted_rows = values.eigenvectors().inv().rows()
int pseudo_rows = values.eigenvectors().pinv().rows()
int vector_rows = values.eigenvectors().eigenvectors().rows()
int powered_rows = values.eigenvectors().pow(2).rows()
matrix<float> kron_other = matrix.new<float>(1, 1, 2.0)
int kron_rows = values.eigenvectors().kron(kron_other).rows()
float diff_get = values.eigenvectors().diff(1.0).get(0, 0)
float mult_get = values.eigenvectors().mult(2.0).get(0, 0)

plot(direct_rows + direct_columns + direct_elements + direct_get + nested_copy.get(1, 1) + int_get + direct_row.size() + direct_col.size() + direct_eigenvalues.size() + (direct_is_square ? 1 : 0) + (direct_is_zero ? 1 : 0) + (direct_is_binary ? 1 : 0) + (direct_is_diagonal ? 1 : 0) + (direct_is_identity ? 1 : 0) + (direct_is_symmetric ? 1 : 0) + (direct_is_antisymmetric ? 1 : 0) + (direct_is_stochastic ? 1 : 0) + direct_sum + direct_avg + direct_min + direct_max + direct_mode + direct_trace + direct_det + direct_rank + transposed_columns + eigenvectorRows(values))
plot(sliced_rows)
plot(inverted_rows)
plot(pseudo_rows)
plot(vector_rows)
plot(powered_rows)
plot(kron_rows)
plot(diff_get)
plot(mult_get)
values.eigenvectors().set(0, 0, 2.0)
values.eigenvectors().fill(2.0)
values.eigenvectors().reverse()
values.eigenvectors().reshape(1, 4)
values.eigenvectors().swap_rows(0, 1)
values.eigenvectors().swap_columns(0, 1)
values.eigenvectors().remove_row(0)
values.eigenvectors().remove_col(0)
values.eigenvectors().add_row(0, array.from(1.0))
values.eigenvectors().add_col(0, array.from(1.0))
values.eigenvectors().sort()
