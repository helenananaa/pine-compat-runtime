//@version=6
indicator("Bound matrix.mult call-result reads")

multGet(left, right) => left.mult(right).get(1, 1)

multBlockReads(left, right) =>
    int rows = left.mult(right).rows()
    int columns = left.mult(right).columns()
    float value = left.mult(right).get(0, 0)
    rows * 100 + columns * 10 + value

left = matrix.new<float>(2, 3, 0.0)
left.set(0, 0, 1.0)
left.set(0, 1, 2.0)
left.set(0, 2, 3.0)
left.set(1, 0, 4.0)
left.set(1, 1, 5.0)
left.set(1, 2, 6.0)

right = matrix.new<float>(3, 2, 0.0)
right.set(0, 0, 7.0)
right.set(0, 1, 8.0)
right.set(1, 0, 9.0)
right.set(1, 1, 10.0)
right.set(2, 0, 11.0)
right.set(2, 1, 12.0)

copied = left.mult(right).copy()
copied.set(0, 0, 99.0)

int_left = matrix.new<int>(1, 1, 2)
int_right = matrix.new<int>(1, 1, 3)
mode_left = matrix.new<float>(2, 2, 1.0)
mode_right = matrix.new<float>(2, 2, 1.0)
int_mode_left = matrix.new<int>(1, 2, 1)
int_mode_right = matrix.new<int>(2, 2, 1)
vector = array.from(1.0, 1.0, 1.0)
na_left = matrix.new<float>(1, 1)
na_right = matrix.new<float>(1, 1, 2.0)
empty_left = matrix.new<float>(2, 0)
empty_right = matrix.new<float>(0, 3)
kron_other = matrix.new<float>(1, 1, 2.0)
nested_right = matrix.new<float>(2, 1, 0.0)
nested_right.set(0, 0, 1.0)
nested_right.set(1, 0, 2.0)

remultiplied = left.mult(right).mult(2.0)
remultiplied.set(0, 0, 777.0)
nested_array = left.mult(right).mult(array.from(1.0, 2.0))
nested_array.set(0, 778.0)

plot(left.mult(right).rows(), "matrix_rows")
plot(left.mult(right).columns(), "matrix_columns")
plot(left.mult(right).elements_count(), "matrix_elements")
plot(left.mult(right).get(0, 0), "matrix_get")
plot(left.mult(right).copy().get(1, 1), "matrix_copy_get")
plot(left.mult(right).row(1).get(0), "matrix_row_get")
plot(left.mult(right).row(0).copy().last(), "matrix_row_copy_last")
plot(left.mult(right).col(1).get(0), "matrix_col_get")
plot(left.mult(right).col(0).copy().last(), "matrix_col_copy_last")
plot(left.mult(right).eigenvalues().first(), "matrix_eigenvalues_first")
plot(left.mult(right).eigenvalues().copy().size(), "matrix_eigenvalues_copy_size")
plot(left.mult(right).is_square() ? 1 : 0, "matrix_is_square")
plot(left.mult(right).is_zero() ? 1 : 0, "matrix_is_zero")
plot(left.mult(right).is_binary() ? 1 : 0, "matrix_is_binary")
plot(left.mult(right).is_diagonal() ? 1 : 0, "matrix_is_diagonal")
plot(left.mult(right).is_identity() ? 1 : 0, "matrix_is_identity")
plot(left.mult(right).is_symmetric() ? 1 : 0, "matrix_is_symmetric")
plot(left.mult(right).is_antisymmetric() ? 1 : 0, "matrix_is_antisymmetric")
plot(left.mult(right).is_stochastic() ? 1 : 0, "matrix_is_stochastic")
plot(left.mult(right).avg(), "matrix_sum")
plot(left.mult(right).avg(), "matrix_avg")
plot(left.mult(right).min(), "matrix_min")
plot(left.mult(right).max(), "matrix_max")
plot(mode_left.mult(mode_right).mode(), "matrix_mode")
plot(left.mult(right).trace(), "matrix_trace")
plot(left.mult(right).det(), "matrix_det")
plot(left.mult(right).rank(), "matrix_rank")
plot(left.mult(right).transpose().get(1, 0), "matrix_transpose_get")
plot(left.mult(right).transpose().transpose().get(0, 1), "matrix_double_transpose_get")
plot(left.mult(right).submatrix(0, 1, 0, 2).rows(), "matrix_submatrix_rows")
plot(left.mult(right).submatrix(0, 1, 0, 2).columns(), "matrix_submatrix_columns")
plot(left.mult(right).submatrix(0, 1, 0, 2).get(0, 1), "matrix_submatrix_get")
plot(left.mult(right).inv().rows(), "matrix_inv_rows")
plot(left.mult(right).inv().columns(), "matrix_inv_columns")
plot(left.mult(right).inv().get(0, 0), "matrix_inv_get")
plot(left.mult(right).pinv().rows(), "matrix_pinv_rows")
plot(left.mult(right).pinv().columns(), "matrix_pinv_columns")
plot(left.mult(right).pinv().get(0, 0), "matrix_pinv_get")
plot(left.mult(right).eigenvectors().rows(), "matrix_eigenvectors_rows")
plot(left.mult(right).eigenvectors().columns(), "matrix_eigenvectors_columns")
plot(left.mult(right).eigenvectors().get(0, 0), "matrix_eigenvectors_get")
plot(left.mult(right).pow(2).rows(), "matrix_pow_rows")
plot(left.mult(right).pow(2).columns(), "matrix_pow_columns")
plot(left.mult(right).pow(2).get(0, 0), "matrix_pow_get")
plot(left.mult(right).kron(kron_other).rows(), "matrix_kron_rows")
plot(left.mult(right).kron(kron_other).columns(), "matrix_kron_columns")
plot(left.mult(right).kron(kron_other).get(0, 0), "matrix_kron_get")
plot(left.mult(right).diff(1.0).rows(), "matrix_diff_rows")
plot(left.mult(right).diff(1.0).columns(), "matrix_diff_columns")
plot(left.mult(right).diff(1.0).get(0, 0), "matrix_diff_get")
plot(left.mult(0.5).rows(), "scalar_rows")
plot(left.mult(0.5).columns(), "scalar_columns")
plot(left.mult(0.5).get(1, 2), "scalar_get")
plot(left.mult(0.5).transpose().rows(), "scalar_transpose_rows")
plot(left.mult(0.5).transpose().columns(), "scalar_transpose_columns")
plot(left.mult(0.5).transpose().get(2, 1), "scalar_transpose_get")
plot(left.mult(0.5).submatrix(1, 2, 1, 3).get(0, 1), "scalar_submatrix_get")
plot(int_left.mult(int_right).get(0, 0), "int_matrix_get")
plot(int_left.mult(int_right).row(0).first(), "int_matrix_row_first")
plot(int_left.mult(int_right).col(0).first(), "int_matrix_col_first")
plot(int_left.mult(int_right).eigenvalues().first(), "int_matrix_eigenvalues_first")
plot(int_left.mult(int_right).is_square() ? 1 : 0, "int_matrix_is_square")
plot(int_left.mult(int_right).is_zero() ? 1 : 0, "int_matrix_is_zero")
plot(int_left.mult(int_right).is_binary() ? 1 : 0, "int_matrix_is_binary")
plot(int_left.mult(int_right).is_diagonal() ? 1 : 0, "int_matrix_is_diagonal")
plot(int_left.mult(int_right).is_identity() ? 1 : 0, "int_matrix_is_identity")
plot(int_left.mult(int_right).is_symmetric() ? 1 : 0, "int_matrix_is_symmetric")
plot(int_left.mult(int_right).is_antisymmetric() ? 1 : 0, "int_matrix_is_antisymmetric")
plot(int_left.mult(int_right).is_stochastic() ? 1 : 0, "int_matrix_is_stochastic")
plot(int_left.mult(int_right).avg(), "int_matrix_sum")
plot(int_left.mult(int_right).avg(), "int_matrix_avg")
plot(int_left.mult(int_right).min(), "int_matrix_min")
plot(int_left.mult(int_right).max(), "int_matrix_max")
plot(int_mode_left.mult(int_mode_right).mode(), "int_matrix_mode")
plot(int_left.mult(int_right).trace(), "int_matrix_trace")
plot(int_left.mult(int_right).det(), "int_matrix_det")
plot(int_left.mult(int_right).rank(), "int_matrix_rank")
plot(na(na_left.mult(na_right).get(0, 0)) ? 1 : 0, "na_get")
plot(empty_left.mult(empty_right).rows() * 100 + empty_left.mult(empty_right).columns() * 10 + empty_left.mult(empty_right).elements_count(), "empty_shape")
plot(empty_left.mult(empty_right).get(0, 0), "empty_get")
plot(left.mult(vector).size(), "array_size")
plot(left.mult(vector).get(1), "array_get")
plot(left.get(0, 0), "source_value")
plot(copied.get(0, 0), "copied_value")
plot(multGet(left, right), "expression_udf")
plot(multBlockReads(left, right), "block_udf")
plot(left.mult(right).mult(2.0).rows(), "mult_chain_rows")
plot(left.mult(right).mult(2.0).columns(), "mult_chain_columns")
plot(left.mult(right).mult(2.0).get(1, 1), "mult_scalar_chain_get")
plot(left.mult(right).mult(nested_right).get(1, 0), "mult_matrix_chain_get")
plot(left.mult(right).mult(array.from(1.0, 2.0)).size(), "mult_array_chain_size")
plot(left.mult(right).mult(array.from(1.0, 2.0)).copy().get(1), "mult_array_chain_get")
plot(left.mult(right).mult(2.0).mult(0.5).get(0, 0), "mult_double_chain_get")
plot(int_left.mult(int_right).mult(4).get(0, 0), "mult_int_chain_get")
plot(na(left.mult(right).mult(na).get(0, 0)) ? 1 : 0, "mult_scalar_na")
plot(na(na_left.mult(na_right).mult(2.0).get(0, 0)) ? 1 : 0, "mult_upstream_na")
plot(empty_left.mult(empty_right).mult(2.0).rows() * 100 + empty_left.mult(empty_right).mult(2.0).columns() * 10 + empty_left.mult(empty_right).mult(2.0).elements_count(), "mult_empty_shape")
plot(empty_left.mult(empty_right).mult(array.from(1.0, 1.0, 1.0)).size(), "mult_empty_array_size")
plot(left.mult(right).copy().mult(2.0).diff(1.0).get(0, 0), "mult_nested_get")
plot(remultiplied.get(0, 0), "remultiplied_value")
plot(left.mult(right).get(0, 0), "remultiplied_source_value")
plot(nested_array.get(0), "multiplied_array_value")
plot(left.mult(right).mult(array.from(1.0, 2.0)).get(0), "multiplied_array_source_value")
left.mult(right).set(0, 0, 110.0)
plot(left.get(0, 0) == 1.0 and right.get(0, 0) == 7.0 ? 1 : 0, "call_result_set_source_independent")
left.mult(right).fill(310.0)
plot(left.get(0, 0) == 1.0 and right.get(0, 0) == 7.0 ? 1 : 0, "call_result_fill_source_independent")
left.mult(right).reverse()
plot(left.get(0, 0) == 1.0 and right.get(0, 0) == 7.0 ? 1 : 0, "call_result_reverse_source_independent")
left.mult(right).reshape(1, 4)
plot(left.rows() == 2 and left.columns() == 3 and right.rows() == 3 and right.columns() == 2 ? 1 : 0, "call_result_reshape_source_independent")
left.mult(right).swap_rows(0, 1)
plot(left.get(0, 0) == 1.0 and right.get(0, 0) == 7.0 ? 1 : 0, "call_result_swap_rows_source_independent")
left.mult(right).swap_columns(0, 1)
plot(left.get(0, 0) == 1.0 and right.get(0, 0) == 7.0 ? 1 : 0, "call_result_swap_columns_source_independent")
left.mult(right).remove_row(0)
left.mult(right).remove_col(0)
plot(left.rows() == 2 and right.rows() == 3 and left.get(0, 0) == 1.0 and right.get(0, 0) == 7.0 ? 1 : 0, "call_result_remove_row_source_independent")
left.mult(right).add_row(0, array.from(7.0, 8.0))
plot(left.rows() == 2 and right.rows() == 3 and left.get(0, 0) == 1.0 and right.get(0, 0) == 7.0 ? 1 : 0, "call_result_add_row_source_independent")
left.mult(right).add_col(0, array.from(7.0, 8.0))
plot(left.rows() == 2 and right.rows() == 3 and left.get(0, 0) == 1.0 and right.get(0, 0) == 7.0 ? 1 : 0, "call_result_add_col_source_independent")
left.mult(right).sort()
plot(left.rows() == 2 and right.rows() == 3 and left.get(0, 0) == 1.0 and right.get(0, 0) == 7.0 ? 1 : 0, "call_result_sort_source_independent")
