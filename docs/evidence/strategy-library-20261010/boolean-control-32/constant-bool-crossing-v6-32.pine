//@version=6
indicator("Constant bool crossing probe32",precision=0)
a=if false
    true
f()=>a
identity(x)=>x
boolInput=input.bool(a)
same=request.security(syminfo.tickerid,timeframe.period,a)
missingSwitch=switch 0
    1=>true
falseWhile=while false
    true
plot(f()?1:0,title="global function return")
plot(identity(a)?1:0,title="argument identity")
plot(boolInput?1:0,title="input default")
plot(same?1:0,title="request return")
plot(missingSwitch?1:0,title="switch missing")
plot(falseWhile?1:0,title="while false")
plot((a and true)==true?1:0,title="and equals true")
plot((a or false)==true?1:0,title="or equals true")
plot((not a)==false?1:0,title="not equals false")
