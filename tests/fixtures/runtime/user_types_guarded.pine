    Point block_typed_ternary = bar_index < 2 ? Point.new(high + 145, low) : Point.new(high + 150, low)
    block_typed_ternary := bar_index == 3 ? Point.new(high + 155, low) : Point.new(high + 160, low)
    plot((na(block_typed_ternary) ? na : block_typed_ternary.x) + (na(block_typed_ternary) ? na : block_typed_ternary.y))
