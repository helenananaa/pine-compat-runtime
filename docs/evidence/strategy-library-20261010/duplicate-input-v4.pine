study("Codex duplicate input v4 oracle",overlay=true)
a=input(2,defval=1,title="A")
b=input(2,defval=3,title="B")
c=input(1,title="First title",title="Second title")
d=input(1,group="First group",group="Second group")
plot(a,"A value")
plot(b,"B value")
plot(c,"C value")
plot(d,"D value")
