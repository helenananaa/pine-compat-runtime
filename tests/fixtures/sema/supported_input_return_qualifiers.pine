//@version=6
indicator("Supported input return qualifiers")

generic_length = input(5, "Generic length")
generic_scale = input(1.5, "Generic scale")
generic_enabled = input(true, "Generic enabled")
generic_timeframe = input("60", "Generic timeframe")
generic_shade = input(color.orange, "Generic shade")
generic_source = input(close, "Generic source")

length = input.int(5, "Length")
scale = input.float(0.85, "Scale")
enabled = input.bool(true, "Enabled")
source = input.source(close, "Source")
level_color = input.color(color.gray, "Level color")
mode = input.string("Close", "Mode")
price = input.price(2.0, "Price")
start = input.time(5, "Start")
symbol = input.symbol("NASDAQ:AAPL", "Symbol")
timeframe_value = input.timeframe("60", "Timeframe")
session_value = input.session("0930-1600", "Session")
notes = input.text_area("Plan", "Notes")

plot(close, show_last=generic_length)
hline(generic_scale, color=generic_shade)
plot(ta.alma(close, generic_length, generic_scale, 6, generic_enabled))
plot(ta.alma(source, length, scale, 6, enabled))
plot(generic_source)
hline(price, color=level_color)
plot(close, show_last=start)
plot(time(generic_timeframe))
plot(str.length(mode) + str.length(symbol) + str.length(timeframe_value) + str.length(session_value) + str.length(notes))
