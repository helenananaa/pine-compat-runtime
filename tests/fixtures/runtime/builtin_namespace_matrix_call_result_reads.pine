plot(matrix.pinv(pinv_values).is_zero() ? 1 : 0, "matrix_pinv_is_zero")
plot(matrix.eigenvectors(eigenvectors_values).is_zero() ? 1 : 0, "matrix_eigenvectors_is_zero")
