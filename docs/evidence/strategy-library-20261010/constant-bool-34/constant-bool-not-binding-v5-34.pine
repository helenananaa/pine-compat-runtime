//@version=5
a=if true
    false
b=not a
indicator("Bool not binding versus expression v5 probe34",dynamic_requests=b,precision=0)
tf=bar_index%2==0?"D":"W"
v=request.security(syminfo.tickerid,tf,close)
plot(v>0?1:0,title="request enabled")
plot(a?1:0,title="a condition")
plot((not a)?1:0,title="direct not condition")
plot(b?1:0,title="b condition")
plot(b==true?1:0,title="b equals true")
plot(b==false?1:0,title="b equals false")
plot(str.tostring(b)=="true"?1:0,title="b string true")
plot(str.tostring(b)=="false"?1:0,title="b string false")
