//@version=5
indicator("User type varip")
type Point
    float x
type Wrapper
    Point inner

dyn = bar_index == 0 ? na : 1

varip Point from_na = na
if bar_index == 0
    from_na := Point.new(close)
else
    from_na.x := (na(from_na) ? na : from_na.x) + 1
plot((na(from_na) ? na : from_na.x))
from_na_prior = from_na[1]
from_na_dynamic_prior = from_na[dyn]
plot((na(from_na_prior) ? na : from_na_prior.x))
plot((na(from_na_dynamic_prior) ? na : from_na_dynamic_prior.x))

varip Point constructed = Point.new(close + 10)
constructed.x := (na(constructed) ? na : constructed.x) + 1
plot((na(constructed) ? na : constructed.x))
constructed_prior = constructed[1]
constructed_dynamic_prior = constructed[dyn]
plot((na(constructed_prior) ? na : constructed_prior.x))
plot((na(constructed_dynamic_prior) ? na : constructed_dynamic_prior.x))

varip inferred = Point.new(close + 20)
inferred.x := (na(inferred) ? na : inferred.x) + 1
plot((na(inferred) ? na : inferred.x))
inferred_prior = inferred[1]
inferred_dynamic_prior = inferred[dyn]
plot((na(inferred_prior) ? na : inferred_prior.x))
plot((na(inferred_dynamic_prior) ? na : inferred_dynamic_prior.x))

aliasPointSource = Point.new(close + 25)
varip aliasPoint = aliasPointSource
aliasPoint.x := (na(aliasPoint) ? na : aliasPoint.x) + 1
plot((na(aliasPoint) ? na : aliasPoint.x))
aliasPoint_prior = aliasPoint[1]
aliasPoint_dynamic_prior = aliasPoint[dyn]
plot((na(aliasPoint_prior) ? na : aliasPoint_prior.x))
plot((na(aliasPoint_dynamic_prior) ? na : aliasPoint_dynamic_prior.x))

varip Point typed_ternary = bar_index == 0 ? Point.new(close + 30) : Point.new(open + 30)
typed_ternary.x := (na(typed_ternary) ? na : typed_ternary.x) + 1
plot((na(typed_ternary) ? na : typed_ternary.x))
typed_ternary_prior = typed_ternary[1]
typed_ternary_dynamic_prior = typed_ternary[dyn]
plot((na(typed_ternary_prior) ? na : typed_ternary_prior.x))
plot((na(typed_ternary_dynamic_prior) ? na : typed_ternary_dynamic_prior.x))

varip Point typed_switch = switch bar_index
    0 => Point.new(close + 40)
    => Point.new(open + 40)
typed_switch.x := (na(typed_switch) ? na : typed_switch.x) + 1
plot((na(typed_switch) ? na : typed_switch.x))
typed_switch_prior = typed_switch[1]
typed_switch_dynamic_prior = typed_switch[dyn]
plot((na(typed_switch_prior) ? na : typed_switch_prior.x))
plot((na(typed_switch_dynamic_prior) ? na : typed_switch_dynamic_prior.x))

varip Point typed_if = if bar_index == 0
    Point.new(close + 50)
else
    Point.new(open + 50)
typed_if.x := (na(typed_if) ? na : typed_if.x) + 1
plot((na(typed_if) ? na : typed_if.x))
typed_if_prior = typed_if[1]
typed_if_dynamic_prior = typed_if[dyn]
plot((na(typed_if_prior) ? na : typed_if_prior.x))
plot((na(typed_if_dynamic_prior) ? na : typed_if_dynamic_prior.x))

varip Point typed_for = for i = 0 to 1
    Point.new(close + 60 + i)
typed_for.x := (na(typed_for) ? na : typed_for.x) + 1
plot((na(typed_for) ? na : typed_for.x))
typed_for_prior = typed_for[1]
typed_for_dynamic_prior = typed_for[dyn]
plot((na(typed_for_prior) ? na : typed_for_prior.x))
plot((na(typed_for_dynamic_prior) ? na : typed_for_dynamic_prior.x))

point_values = array.from(0, 1)
varip Point typed_for_in = for value in point_values
    Point.new(close + 100 + value)
typed_for_in.x := (na(typed_for_in) ? na : typed_for_in.x) + 1
plot((na(typed_for_in) ? na : typed_for_in.x))
typed_for_in_prior = typed_for_in[1]
typed_for_in_dynamic_prior = typed_for_in[dyn]
plot((na(typed_for_in_prior) ? na : typed_for_in_prior.x))
plot((na(typed_for_in_dynamic_prior) ? na : typed_for_in_dynamic_prior.x))

counter = 0
varip Point typed_while = while counter < 2
    counter := counter + 1
    Point.new(close + 110 + counter)
typed_while.x := (na(typed_while) ? na : typed_while.x) + 1
plot((na(typed_while) ? na : typed_while.x))
typed_while_prior = typed_while[1]
typed_while_dynamic_prior = typed_while[dyn]
plot((na(typed_while_prior) ? na : typed_while_prior.x))
plot((na(typed_while_dynamic_prior) ? na : typed_while_dynamic_prior.x))

varip Wrapper wrapped_ternary = bar_index == 0 ? Wrapper.new(Point.new(close + 120)) : Wrapper.new(Point.new(open + 120))
wrapped_ternary := Wrapper.new(Point.new((na(wrapped_ternary) ? na : na(wrapped_ternary.inner) ? na : wrapped_ternary.inner.x) + 1))
plot((na(wrapped_ternary) ? na : na(wrapped_ternary.inner) ? na : wrapped_ternary.inner.x))
wrapped_ternary_prior = wrapped_ternary[1]
wrapped_ternary_dynamic_prior = wrapped_ternary[dyn]
plot((na(wrapped_ternary_prior) ? na : na(wrapped_ternary_prior.inner) ? na : wrapped_ternary_prior.inner.x))
plot((na(wrapped_ternary_dynamic_prior) ? na : na(wrapped_ternary_dynamic_prior.inner) ? na : wrapped_ternary_dynamic_prior.inner.x))

varip Wrapper wrapped_switch = switch bar_index
    0 => Wrapper.new(Point.new(close + 130))
    => Wrapper.new(Point.new(open + 130))
wrapped_switch := Wrapper.new(Point.new((na(wrapped_switch) ? na : na(wrapped_switch.inner) ? na : wrapped_switch.inner.x) + 1))
plot((na(wrapped_switch) ? na : na(wrapped_switch.inner) ? na : wrapped_switch.inner.x))
wrapped_switch_prior = wrapped_switch[1]
wrapped_switch_dynamic_prior = wrapped_switch[dyn]
plot((na(wrapped_switch_prior) ? na : na(wrapped_switch_prior.inner) ? na : wrapped_switch_prior.inner.x))
plot((na(wrapped_switch_dynamic_prior) ? na : na(wrapped_switch_dynamic_prior.inner) ? na : wrapped_switch_dynamic_prior.inner.x))

varip Wrapper wrapped_if = if bar_index == 0
    Wrapper.new(Point.new(close + 140))
else
    Wrapper.new(Point.new(open + 140))
wrapped_if := Wrapper.new(Point.new((na(wrapped_if) ? na : na(wrapped_if.inner) ? na : wrapped_if.inner.x) + 1))
plot((na(wrapped_if) ? na : na(wrapped_if.inner) ? na : wrapped_if.inner.x))
wrapped_if_prior = wrapped_if[1]
wrapped_if_dynamic_prior = wrapped_if[dyn]
plot((na(wrapped_if_prior) ? na : na(wrapped_if_prior.inner) ? na : wrapped_if_prior.inner.x))
plot((na(wrapped_if_dynamic_prior) ? na : na(wrapped_if_dynamic_prior.inner) ? na : wrapped_if_dynamic_prior.inner.x))

varip Wrapper wrapped_for = for i = 0 to 1
    Wrapper.new(Point.new(close + 150 + i))
wrapped_for := Wrapper.new(Point.new((na(wrapped_for) ? na : na(wrapped_for.inner) ? na : wrapped_for.inner.x) + 1))
plot((na(wrapped_for) ? na : na(wrapped_for.inner) ? na : wrapped_for.inner.x))
wrapped_for_prior = wrapped_for[1]
wrapped_for_dynamic_prior = wrapped_for[dyn]
plot((na(wrapped_for_prior) ? na : na(wrapped_for_prior.inner) ? na : wrapped_for_prior.inner.x))
plot((na(wrapped_for_dynamic_prior) ? na : na(wrapped_for_dynamic_prior.inner) ? na : wrapped_for_dynamic_prior.inner.x))

wrapper_values = array.from(Wrapper.new(Point.new(close + 160)), Wrapper.new(Point.new(close + 161)))
varip Wrapper wrapped_for_in = for item in wrapper_values
    item
wrapped_for_in := Wrapper.new(Point.new((na(wrapped_for_in) ? na : na(wrapped_for_in.inner) ? na : wrapped_for_in.inner.x) + 1))
plot((na(wrapped_for_in) ? na : na(wrapped_for_in.inner) ? na : wrapped_for_in.inner.x))
wrapped_for_in_prior = wrapped_for_in[1]
wrapped_for_in_dynamic_prior = wrapped_for_in[dyn]
plot((na(wrapped_for_in_prior) ? na : na(wrapped_for_in_prior.inner) ? na : wrapped_for_in_prior.inner.x))
plot((na(wrapped_for_in_dynamic_prior) ? na : na(wrapped_for_in_dynamic_prior.inner) ? na : wrapped_for_in_dynamic_prior.inner.x))

wrapped_counter = 0
varip Wrapper wrapped_while = while wrapped_counter < 2
    wrapped_counter := wrapped_counter + 1
    Wrapper.new(Point.new(close + 170 + wrapped_counter))
wrapped_while := Wrapper.new(Point.new((na(wrapped_while) ? na : na(wrapped_while.inner) ? na : wrapped_while.inner.x) + 1))
plot((na(wrapped_while) ? na : na(wrapped_while.inner) ? na : wrapped_while.inner.x))
wrapped_while_prior = wrapped_while[1]
wrapped_while_dynamic_prior = wrapped_while[dyn]
plot((na(wrapped_while_prior) ? na : na(wrapped_while_prior.inner) ? na : wrapped_while_prior.inner.x))
plot((na(wrapped_while_dynamic_prior) ? na : na(wrapped_while_dynamic_prior.inner) ? na : wrapped_while_dynamic_prior.inner.x))

varip Wrapper wrapped = Wrapper.new(Point.new(close + 70))
wrapped.inner := Point.new((na(wrapped) ? na : na(wrapped.inner) ? na : wrapped.inner.x) + 1)
plot((na(wrapped) ? na : na(wrapped.inner) ? na : wrapped.inner.x))
wrapped_prior = wrapped[1]
wrapped_dynamic_prior = wrapped[dyn]
plot((na(wrapped_prior) ? na : na(wrapped_prior.inner) ? na : wrapped_prior.inner.x))
plot((na(wrapped_dynamic_prior) ? na : na(wrapped_dynamic_prior.inner) ? na : wrapped_dynamic_prior.inner.x))

varip inferredWrapped = Wrapper.new(Point.new(close + 80))
inferredWrapped := Wrapper.new(Point.new((na(inferredWrapped) ? na : na(inferredWrapped.inner) ? na : inferredWrapped.inner.x) + 1))
plot((na(inferredWrapped) ? na : na(inferredWrapped.inner) ? na : inferredWrapped.inner.x))
inferredWrapped_prior = inferredWrapped[1]
inferredWrapped_dynamic_prior = inferredWrapped[dyn]
plot((na(inferredWrapped_prior) ? na : na(inferredWrapped_prior.inner) ? na : inferredWrapped_prior.inner.x))
plot((na(inferredWrapped_dynamic_prior) ? na : na(inferredWrapped_dynamic_prior.inner) ? na : inferredWrapped_dynamic_prior.inner.x))

aliasSource = Wrapper.new(Point.new(close + 90))
varip aliasWrapped = aliasSource
aliasWrapped.inner := Point.new((na(aliasWrapped) ? na : na(aliasWrapped.inner) ? na : aliasWrapped.inner.x) + 1)
plot((na(aliasWrapped) ? na : na(aliasWrapped.inner) ? na : aliasWrapped.inner.x))
aliasWrapped_prior = aliasWrapped[1]
aliasWrapped_dynamic_prior = aliasWrapped[dyn]
plot((na(aliasWrapped_prior) ? na : na(aliasWrapped_prior.inner) ? na : aliasWrapped_prior.inner.x))
plot((na(aliasWrapped_dynamic_prior) ? na : na(aliasWrapped_dynamic_prior.inner) ? na : aliasWrapped_dynamic_prior.inner.x))
