//@version=6
indicator("Unsupported builtin namespace matrix call-result reads")

badDirectSet() =>
    matrix.new<float>(1, 1, 0.0).set(0, 0, 1.0)
    1

badDirectFill() =>
    matrix.new<float>(1, 1, 0.0).fill(1.0)
    1

badDirectReverse() =>
    matrix.new<float>(1, 1, 0.0).reverse()
    1

badDirectReshape() =>
    matrix.new<float>(1, 1, 0.0).reshape(1, 1)
    1

badDirectSwapRows() =>
    matrix.new<float>(2, 1, 0.0).swap_rows(0, 1)
    1

badDirectSwapColumns() =>
    matrix.new<float>(1, 2, 0.0).swap_columns(0, 1)
    1

badDirectRemoveRow() =>
    matrix.new<float>(2, 1, 0.0).remove_row(0)
    1

badDirectRemoveCol() =>
    matrix.new<float>(1, 2, 0.0).remove_col(0)
    1

badDirectAddRow() =>
    matrix.new<float>(1, 1, 0.0).add_row(0, array.from(1.0))
    1

badDirectAddCol() =>
    matrix.new<float>(1, 1, 0.0).add_col(0, array.from(1.0))
    1

badDirectSort() =>
    matrix.new<float>(1, 1, 0.0).sort()
    1

left = matrix.new<float>(2, 2, 1.0)
right = matrix.new<float>(2, 2, 2.0)
vector = array.from(3.0, 4.0)
bool_values = matrix.new<bool>(2, 2, true)
bad_direct_set = badDirectSet()
bad_direct_fill = badDirectFill()
bad_direct_reverse = badDirectReverse()
bad_direct_reshape = badDirectReshape()
bad_direct_swap_rows = badDirectSwapRows()
bad_direct_swap_columns = badDirectSwapColumns()
bad_direct_remove_row = badDirectRemoveRow()
bad_direct_remove_col = badDirectRemoveCol()
bad_direct_add_row = badDirectAddRow()
bad_direct_add_col = badDirectAddCol()
bad_direct_sort = badDirectSort()

matrix_bad_row = matrix.mult(left, right).get("bad", 0)
matrix_bad_column = matrix.mult(left, right).get(0, "bad")
matrix.mult(left, right).set("bad", 0, 3.0)
matrix.mult(left, right).fill("bad")
matrix.mult(left, 2.0).copy().reverse(1)
matrix.mult(left, right).reshape("bad", 2)
matrix.mult(left, right).swap_rows("bad", 1)
matrix.mult(left, right).swap_columns("bad", 1)
matrix.mult(left, right).remove_row("bad")
matrix.mult(left, right).remove_col("bad")
matrix.mult(left, right).add_row("bad", vector)
matrix.mult(left, right).add_col("bad", vector)
matrix.mult(left, right).sort("bad")
matrix_size = matrix.mult(2.0, left).size()
copy_bad_row = matrix.copy(left).get("bad", 0)
matrix.copy(left).set(0, "bad", 3.0)
matrix.copy(left).fill()
matrix.copy(left).reshape(2, "bad")
matrix.copy(left).swap_rows(0, "bad")
matrix.copy(left).swap_columns(0, "bad")
matrix.copy(left).remove_row("bad")
matrix.copy(left).remove_col("bad")
matrix.copy(left).add_row(0, array.from(1, 2))
matrix.copy(left).add_col(0, array.from(1, 2))
matrix.copy(left).sort(0, close)
copy_size = matrix.copy(left).size()
copy_wrong_receiver = matrix.copy(vector).rows()
transpose_bad_column = matrix.transpose(left).get(0, "bad")
matrix.transpose(left).set(0, 0, "bad")
matrix.transpose(left).fill(3.0, 4.0)
matrix.transpose(left).reshape(1)
matrix.transpose(left).swap_rows(0)
matrix.transpose(left).swap_columns(0)
matrix.transpose(left).remove_row()
matrix.transpose(left).remove_col()
matrix.transpose(left).add_row(0)
matrix.transpose(left).add_col(0)
matrix.transpose(left).sort(0, order.ascending, order.descending)
transpose_size = matrix.transpose(left).size()
transpose_wrong_receiver = matrix.transpose(vector).rows()
submatrix_bad_from = matrix.submatrix(left, "bad").rows()
submatrix_bad_row = matrix.submatrix(left).get("bad", 0)
matrix.submatrix(left).set(0, 0)
matrix.submatrix(left).reshape(1, 4, 2)
matrix.submatrix(left).swap_rows(0, 1, 2)
matrix.submatrix(left).swap_columns(0, 1, 2)
matrix.submatrix(left).remove_row(0, 1)
matrix.submatrix(left).remove_col(0, 1)
matrix.submatrix(left).add_row(0, vector, vector)
matrix.submatrix(left).add_col(0, vector, vector)
matrix.new<bool>(1, 1, true).sort()
submatrix_size = matrix.submatrix(left).size()
submatrix_wrong_receiver = matrix.submatrix(vector).rows()
kron_bad_right = matrix.kron(left, vector).rows()
kron_bad_row = matrix.kron(left, right).get("bad", 0)
matrix.kron(left, right).set(0, 0, 3.0, 4.0)
kron_size = matrix.kron(left, right).size()
diff_bad_right = matrix.diff(left, vector).rows()
diff_bad_row = matrix.diff(left, right).get("bad", 0)
matrix.diff(left, right).set(0, 0, "bad")
diff_size = matrix.diff(left, right).size()
pow_bad_receiver = matrix.pow(vector, 2).rows()
pow_bad_power = matrix.pow(left, "bad").rows()
pow_bad_row = matrix.pow(left, 2).get("bad", 0)
matrix.pow(left, 2).set(0, 0, "bad")
pow_size = matrix.pow(left, 2).size()
inv_bad_receiver = matrix.inv(vector).rows()
inv_bad_row = matrix.inv(left).get("bad", 0)
matrix.inv(left).set(0, 0, "bad")
inv_size = matrix.inv(left).size()
pinv_bad_receiver = matrix.pinv(vector).rows()
pinv_bad_row = matrix.pinv(left).get("bad", 0)
matrix.pinv(left).set(0, 0, "bad")
pinv_size = matrix.pinv(left).size()
eigenvectors_bad_receiver = matrix.eigenvectors(vector).rows()
eigenvectors_bad_row = matrix.eigenvectors(left).get("bad", 0)
matrix.eigenvectors(left).set(0, 0, "bad")
eigenvectors_size = matrix.eigenvectors(left).size()
new_bad_rows = matrix.new<float>("bad", 2, 0.0).rows()
new_bad_get = matrix.new<int>(2, 2, 1).get("bad", 0)
matrix.new<bool>(1, 1, true).set(0, 0, "bad")
matrix.new<bool>(1, 1, true).fill("bad")
matrix.copy(left).set(0, 0, 3.0).rows()
matrix.copy(left).fill(3.0).rows()
new_size = matrix.new<string>(1, 1, "value").size()

array_rows = matrix.mult(left, vector).rows()
array_columns = matrix.mult(vector, left).columns()
array_elements = matrix.mult(vector, vector).elements_count()
array_matrix_get = matrix.mult(left, vector).get(0, 0)
array_copy_rows = matrix.mult(vector, left).copy().rows()
row_bad_index = matrix.mult(left, right).row("bad")
col_bad_index = matrix.mult(left, right).col("bad")
bool_eigenvalues = matrix.copy(bool_values).eigenvalues()
is_square_extra_arg = matrix.copy(left).is_square(0)
bool_is_zero = matrix.copy(bool_values).is_zero()
is_zero_extra_arg = matrix.copy(left).is_zero(0)
bool_is_binary = matrix.copy(bool_values).is_binary()
is_binary_extra_arg = matrix.copy(left).is_binary(0)
bool_is_diagonal = matrix.copy(bool_values).is_diagonal()
is_diagonal_extra_arg = matrix.copy(left).is_diagonal(0)
bool_is_identity = matrix.copy(bool_values).is_identity()
is_identity_extra_arg = matrix.copy(left).is_identity(0)
bool_is_symmetric = matrix.copy(bool_values).is_symmetric()
is_symmetric_extra_arg = matrix.copy(left).is_symmetric(0)
bool_is_antisymmetric = matrix.copy(bool_values).is_antisymmetric()
is_antisymmetric_extra_arg = matrix.copy(left).is_antisymmetric(0)
bool_is_stochastic = matrix.copy(bool_values).is_stochastic()
is_stochastic_extra_arg = matrix.copy(left).is_stochastic(0)
bool_sum = matrix.copy(bool_values).sum(matrix.copy(left))
sum_extra_arg = matrix.copy(left).sum(0, 0)
bool_avg = matrix.copy(bool_values).avg()
avg_extra_arg = matrix.copy(left).avg(0)
bool_min = matrix.copy(bool_values).min()
min_extra_arg = matrix.copy(left).min(0)
bool_max = matrix.copy(bool_values).max()
max_extra_arg = matrix.copy(left).max(0)
bool_mode = matrix.copy(bool_values).mode()
mode_extra_arg = matrix.copy(left).mode(0)
bool_trace = matrix.copy(bool_values).trace()
trace_extra_arg = matrix.copy(left).trace(0)
bool_det = matrix.copy(bool_values).det()
det_extra_arg = matrix.copy(left).det(0)
bool_rank = matrix.copy(bool_values).rank()
rank_extra_arg = matrix.copy(left).rank(0)
transpose_extra_arg = matrix.copy(left).transpose(0)
submatrix_bad_from = matrix.copy(left).submatrix("bad").rows()
submatrix_extra_arg = matrix.copy(left).submatrix(0, 2, 0, 2, 0).rows()
bool_inv = matrix.copy(bool_values).inv()
inv_extra_arg = matrix.copy(left).inv(0)
bool_pinv = matrix.copy(bool_values).pinv()
pinv_extra_arg = matrix.copy(left).pinv(0)
bool_eigenvectors_continuation = matrix.copy(bool_values).eigenvectors()
eigenvectors_extra_arg = matrix.copy(left).eigenvectors(0)
bool_pow_continuation = matrix.copy(bool_values).pow(2)
pow_bad_power_continuation = matrix.copy(left).pow("bad")
pow_extra_arg_continuation = matrix.copy(left).pow(2, 3)
bool_kron_continuation = matrix.copy(bool_values).kron(left)
kron_bad_other_continuation = matrix.copy(left).kron(vector)
kron_extra_arg_continuation = matrix.copy(left).kron(right, left)
bool_diff_continuation = matrix.copy(bool_values).diff(left)
diff_bad_other_continuation = matrix.copy(left).diff(vector)
diff_extra_arg_continuation = matrix.copy(left).diff(right, left)
bool_mult_continuation = matrix.copy(bool_values).mult(left)
mult_bad_other_continuation = matrix.copy(left).mult(bool_values)
mult_extra_arg_continuation = matrix.copy(left).mult(right, left)
mult_array_rows_continuation = matrix.copy(left).mult(vector).rows()
mult_matrix_size_continuation = matrix.copy(left).mult(right).size()

plot(close)
