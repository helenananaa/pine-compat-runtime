* text=auto

# Source, fixtures, and snapshots carry byte offsets and must be identical on
# every development host.
*.cjs text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.pine text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.tsv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
