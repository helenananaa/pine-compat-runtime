//@version=6
indicator("Supported local UDF matrix call-result reads")

identity(values) => values

blockIdentity(values) =>
    alias = values
    alias

nestedIdentity(values) => identity(values)

pick(first, second, bool choose) => choose ? first : second

matrixFactory(left, right) => matrix.mult(left, right)

makeInt(int value) => matrix.new<int>(1, 1, value)

floats = matrix.new<float>(2, 3, 1.0)
other_floats = matrix.new<float>(2, 3, 2.0)
right = matrix.new<float>(3, 2, 2.0)
ints = matrix.new<int>(1, 1, 3)
bools = matrix.new<bool>(1, 1, true)
strings = matrix.new<string>(1, 1, "pine")
colors = matrix.new<color>(1, 1, color.red)

int direct_rows = identity(floats).rows()
int direct_columns = identity(floats).columns()
int direct_elements = identity(floats).elements_count()
float direct_get = identity(floats).get(row=0, column=0)
matrix<float> float_copy = identity(floats).copy().copy()
int int_get = identity(ints).get(0, 0)
bool bool_get = identity(bools).get(0, 0)
string string_get = identity(strings).get(0, 0)
color color_get = identity(colors).get(0, 0)
float block_get = blockIdentity(floats).get(1, 2)
float nested_get = nestedIdentity(floats).copy().get(0, 1)
float selected_get = pick(second=other_floats, first=floats, choose=true).get(0, 0)
float multiplied_get = matrixFactory(floats, right).get(0, 0)
matrix<int> constructed_copy = makeInt(7).copy()
array<float> float_row = identity(floats).row(1).copy()
array<int> int_row = identity(ints).row(0)
array<bool> bool_row = identity(bools).row(0)
array<string> string_row = identity(strings).row(0)
array<color> color_row = identity(colors).row(0)
array<float> float_col = identity(floats).col(1).copy()
array<int> int_col = identity(ints).col(0)
array<bool> bool_col = identity(bools).col(0)
array<string> string_col = identity(strings).col(0)
array<color> color_col = identity(colors).col(0)
array<float> float_eigenvalues = identity(matrix.new<float>(2, 2, 1.0)).eigenvalues().copy()
array<float> int_eigenvalues = identity(matrix.new<int>(2, 2, 1)).eigenvalues()
bool float_is_square = identity(floats).is_square()
bool bool_is_square = identity(bools).is_square()
bool float_is_zero = identity(floats).is_zero()
bool int_is_zero = identity(ints).is_zero()
bool float_is_binary = identity(floats).is_binary()
bool int_is_binary = identity(ints).is_binary()
bool float_is_diagonal = identity(floats).is_diagonal()
bool int_is_diagonal = identity(ints).is_diagonal()
bool float_is_identity = identity(floats).is_identity()
bool int_is_identity = identity(ints).is_identity()
bool float_is_symmetric = identity(floats).is_symmetric()
bool int_is_symmetric = identity(ints).is_symmetric()
bool float_is_antisymmetric = identity(floats).is_antisymmetric()
bool int_is_antisymmetric = identity(ints).is_antisymmetric()
bool float_is_stochastic = identity(floats).is_stochastic()
bool int_is_stochastic = identity(ints).is_stochastic()
float float_sum = identity(floats).avg()
float int_sum = identity(ints).avg()
float copied_sum = identity(floats).copy().avg()
float float_avg = identity(floats).avg()
float int_avg = identity(ints).avg()
float copied_avg = identity(floats).copy().avg()
float float_min = identity(floats).min()
float int_min = identity(ints).min()
float copied_min = identity(floats).copy().min()
float float_max = identity(floats).max()
float int_max = identity(ints).max()
float copied_max = identity(floats).copy().max()
float float_mode = identity(floats).mode()
float int_mode = identity(ints).mode()
float copied_mode = identity(floats).copy().mode()
float float_trace = identity(floats).trace()
float int_trace = identity(ints).trace()
float copied_trace = identity(floats).copy().trace()
float float_det = identity(floats).det()
float int_det = identity(matrix.new<int>(2, 2, 7)).det()
float copied_det = identity(floats).copy().det()
int float_rank = identity(floats).rank()
int int_rank = identity(ints).rank()
int copied_rank = identity(floats).copy().rank()
int transposed_rows = identity(floats).transpose().rows()
int transposed_columns = identity(floats).transpose().columns()
float transposed_get = identity(floats).transpose().get(2, 1)
int transposed_int = identity(ints).transpose().get(0, 0)
bool transposed_bool = identity(bools).transpose().get(0, 0)
string transposed_string = identity(strings).transpose().get(0, 0)
color transposed_color = identity(colors).transpose().get(0, 0)
float repeated_transpose = identity(floats).transpose().copy().transpose().get(1, 2)
int sliced_rows = identity(floats).submatrix(0, 1, 1, 3).rows()
int sliced_columns = identity(floats).submatrix().columns()
float sliced_get = identity(floats).submatrix(from_row=0, to_row=2, from_column=1, to_column=3).get(1, 1)
int sliced_int = identity(ints).submatrix().get(0, 0)
bool sliced_bool = identity(bools).submatrix().get(0, 0)
string sliced_string = identity(strings).submatrix().get(0, 0)
color sliced_color = identity(colors).submatrix().get(0, 0)
float nested_slice = identity(floats).transpose().submatrix().copy().get(1, 0)
int inverted_rows = identity(matrix.new<float>(2, 2, 1.0)).inv().rows()
float inverted_int = identity(ints).inv().get(0, 0)
float nested_inv = identity(matrix.new<float>(2, 2, 1.0)).copy().inv().submatrix().get(0, 0)
int pseudo_rows = identity(floats).pinv().rows()
float pseudo_int = identity(ints).pinv().get(0, 0)
float nested_pinv = identity(floats).copy().pinv().transpose().get(0, 0)
int vector_rows = identity(matrix.new<float>(2, 2, 1.0)).eigenvectors().rows()
float vector_int = identity(matrix.new<int>(1, 1, 2)).eigenvectors().get(0, 0)
float nested_vectors = identity(matrix.new<float>(2, 2, 1.0)).copy().eigenvectors().pinv().get(0, 0)
int powered_rows = identity(floats).pow(2).rows()
float powered_int = identity(matrix.new<int>(1, 1, 2)).pow(3).get(0, 0)
float nested_power = identity(floats).copy().pow(2).pinv().get(0, 0)
matrix<float> kron_other = matrix.new<float>(1, 1, 2.0)
int kron_rows = identity(floats).kron(kron_other).rows()
float kron_int = identity(ints).kron(matrix.new<int>(1, 1, 3)).get(0, 0)
float nested_kron = identity(floats).copy().kron(kron_other).pow(2).get(0, 0)
int diff_rows = identity(floats).diff(1.0).rows()
float diff_int = identity(ints).diff(matrix.new<int>(1, 1, 1)).get(0, 0)
float nested_diff = identity(floats).copy().diff(1.0).kron(kron_other).get(0, 0)
int mult_rows = identity(floats).mult(2.0).rows()
float mult_int = identity(ints).mult(matrix.new<int>(1, 1, 3)).get(0, 0)
int mult_array_size = identity(floats).mult(array.from(1.0, 1.0, 1.0)).copy().size()
float nested_mult = identity(floats).copy().mult(2.0).diff(1.0).get(0, 0)

plot(direct_rows + direct_columns + direct_elements + direct_get + float_copy.get(0, 0) + int_get + (bool_get ? 1 : 0) + (string_get == "pine" ? 1 : 0) + (color_get == color.red ? 1 : 0) + block_get + nested_get + selected_get + multiplied_get + constructed_copy.get(0, 0) + float_row.size() + int_row.size() + bool_row.size() + string_row.size() + color_row.size() + float_col.size() + int_col.size() + bool_col.size() + string_col.size() + color_col.size() + float_eigenvalues.size() + int_eigenvalues.size() + (float_is_square ? 1 : 0) + (bool_is_square ? 1 : 0) + (float_is_zero ? 1 : 0) + (int_is_zero ? 1 : 0) + (float_is_binary ? 1 : 0) + (int_is_binary ? 1 : 0) + (float_is_diagonal ? 1 : 0) + (int_is_diagonal ? 1 : 0) + (float_is_identity ? 1 : 0) + (int_is_identity ? 1 : 0) + (float_is_symmetric ? 1 : 0) + (int_is_symmetric ? 1 : 0) + (float_is_antisymmetric ? 1 : 0) + (int_is_antisymmetric ? 1 : 0) + (float_is_stochastic ? 1 : 0) + (int_is_stochastic ? 1 : 0) + float_sum + int_sum + copied_sum + float_avg + int_avg + copied_avg + float_min + int_min + copied_min + float_max + int_max + copied_max + float_mode + int_mode + copied_mode + float_trace + int_trace + copied_trace + float_det + int_det + copied_det + float_rank + int_rank + copied_rank)
plot(transposed_rows + transposed_columns + transposed_get + transposed_int + (transposed_bool ? 1 : 0) + (transposed_string == "pine" ? 1 : 0) + (transposed_color == color.red ? 1 : 0) + repeated_transpose)
plot(sliced_rows + sliced_columns + sliced_get + sliced_int + (sliced_bool ? 1 : 0) + (sliced_string == "pine" ? 1 : 0) + (sliced_color == color.red ? 1 : 0) + nested_slice)
plot(inverted_rows + inverted_int + nested_inv)
plot(pseudo_rows + pseudo_int + nested_pinv)
plot(vector_rows + vector_int + nested_vectors)
plot(powered_rows + powered_int + nested_power)
plot(kron_rows + kron_int + nested_kron)
plot(diff_rows + diff_int + nested_diff)
plot(mult_rows + mult_int + mult_array_size + nested_mult)
identity(floats).set(0, 0, 2.0)
identity(floats).fill(2.0)
identity(floats).reverse()
identity(floats).reshape(3, 2)
identity(floats).swap_rows(0, 1)
identity(floats).swap_columns(0, 1)
identity(ints).set(0, 0, 2)
identity(ints).fill(2)
identity(ints).reverse()
identity(ints).reshape(1, 1)
identity(ints).swap_rows(0, 0)
identity(ints).swap_columns(0, 0)
identity(bools).set(0, 0, false)
identity(bools).fill(false)
identity(bools).reverse()
identity(bools).reshape(1, 1)
identity(bools).swap_rows(0, 0)
identity(bools).swap_columns(0, 0)
identity(strings).set(0, 0, "set")
identity(strings).fill("fill")
identity(strings).reverse()
identity(strings).reshape(1, 1)
identity(strings).swap_rows(0, 0)
identity(strings).swap_columns(0, 0)
identity(colors).set(0, 0, color.blue)
identity(colors).fill(color.blue)
identity(colors).reverse()
identity(colors).reshape(1, 1)
identity(colors).swap_rows(0, 0)
identity(colors).swap_columns(0, 0)
identity(floats).remove_row(0)
identity(floats).remove_col(0)
identity(ints).remove_row(0)
identity(ints).remove_col(0)
identity(bools).remove_row(0)
identity(bools).remove_col(0)
identity(strings).remove_row(0)
identity(strings).remove_col(0)
identity(colors).remove_row(0)
identity(colors).remove_col(0)
identity(floats).add_row(0, array.from(1.0))
identity(ints).add_row(0, array.from(1))
identity(bools).add_row(0, array.from(false))
identity(strings).add_row(0, array.from("row"))
identity(colors).add_row(0, array.from(color.blue))

identity(floats).add_col(0, array.from(1.0))
identity(ints).add_col(0, array.from(1))
identity(bools).add_col(0, array.from(false))
identity(strings).add_col(0, array.from("column"))
identity(colors).add_col(0, array.from(color.blue))

identity(floats).sort()
identity(ints).sort(0, order.descending)
