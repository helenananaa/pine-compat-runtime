//@version=6
indicator("window-conditional-before-global-v6-44",dynamic_requests=true)
float a=na
if bar_index>=0
    a:=request.security(syminfo.tickerid,timeframe.period,bar_index,calc_bars_count=2)
b=request.security(syminfo.tickerid,timeframe.period,bar_index,calc_bars_count=100)
var count=0
count+=1
plot(bar_index)
plot(na(a)?-1:a)
plot(b)
plot(count)
