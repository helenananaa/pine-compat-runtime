//@version=5
indicator("alert-frequency-mapped-input-v5-39")
selection=input.string("once",options=["all","once","close"])
frequency_of(string selection)=>
    switch selection
        "all"=>alert.freq_all
        "once"=>alert.freq_once_per_bar
        =>alert.freq_once_per_bar_close
frequency=frequency_of(selection)
alert("bounded frequency admission probe",frequency)
plot(1)
