//@version=5
indicator("window-error-before-guard-v5-44",dynamic_requests=true)
if bar_index==5
    runtime.error("before context request")
float a=na
if bar_index>=10
    a:=request.security(syminfo.tickerid,timeframe.period,bar_index,calc_bars_count=2)
var count=0
count+=1
plot(bar_index)
plot(na(a)?-1:a)
plot(count)
