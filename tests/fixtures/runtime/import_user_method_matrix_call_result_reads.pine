//@version=6
import user/udt/1 as left
import user/udt/1 as right
indicator("Imported user-method matrix call-result reads")

left_point = left.Point.new(1.0)
right_point = right.Point.new(2.0)

source = left_point.exposeMatrix()
copied = source.copy()
copied.set(0, 0, 99.0)
fresh_row = left_point.exposeMatrix().row(0)
fresh_row.set(0, 77.0)
fresh_col = left_point.exposeMatrix().col(0)
fresh_col.set(0, 66.0)
fresh_eigenvalues = left_point.exposeMatrix().eigenvalues()
fresh_eigenvalues.set(0, 55.0)

plot(left_point.exposeMatrix().rows(), "rows")
plot(left_point.exposeMatrix().columns(), "columns")
plot(left_point.exposeMatrix().elements_count(), "elements")
plot(left_point.exposeMatrix().get(0, 1), "get")
plot(left_point.exposeMatrix().copy().get(1, 1), "copy_chain")
plot(left_point.exposeMatrix().row(1).first(), "row_float")
plot(left_point.exposeIntMatrix().row(0).last(), "row_int")
plot(left_point.exposeStringMatrix().row(0).first() == "pine" ? 1 : 0, "row_string")
plot(left_point.exposeBoolMatrix().row(0).first() ? 1 : 0, "row_bool")
plot(left_point.exposeColorMatrix().row(0).first() == color.red ? 1 : 0, "row_color")
plot(right_point.exposeMatrix().row(0).copy().size(), "row_dual_alias")
plot(source.get(0, 0), "row_source_independent")
plot(fresh_row.get(0), "row_copy_independent")
plot(left_point.exposeMatrix().col(1).last(), "col_float")
plot(left_point.exposeIntMatrix().col(1).first(), "col_int")
plot(left_point.exposeStringMatrix().col(0).first() == "pine" ? 1 : 0, "col_string")
plot(left_point.exposeBoolMatrix().col(0).first() ? 1 : 0, "col_bool")
plot(left_point.exposeColorMatrix().col(0).first() == color.red ? 1 : 0, "col_color")
plot(right_point.exposeMatrix().col(0).copy().size(), "col_dual_alias")
plot(source.get(0, 0), "col_source_independent")
plot(fresh_col.get(0), "col_copy_independent")
plot(left_point.exposeMatrix().eigenvalues().first(), "eigenvalues_float")
plot(right_point.exposeMatrix().eigenvalues().copy().size(), "eigenvalues_dual_alias")
plot(source.get(0, 0), "eigenvalues_source_independent")
plot(fresh_eigenvalues.get(0), "eigenvalues_copy_independent")
plot(left_point.exposeMatrix().is_square() ? 1 : 0, "is_square_float")
plot(right_point.exposeColorMatrix().is_square() ? 1 : 0, "is_square_color")
plot(left_point.exposeMatrix().is_zero() ? 1 : 0, "is_zero_float")
plot(right_point.exposeIntMatrix().is_zero() ? 1 : 0, "is_zero_int")
plot(left_point.exposeMatrix().is_binary() ? 1 : 0, "is_binary_float")
plot(right_point.exposeIntMatrix().is_binary() ? 1 : 0, "is_binary_int")
plot(left_point.exposeMatrix().is_diagonal() ? 1 : 0, "is_diagonal_float")
plot(right_point.exposeIntMatrix().is_diagonal() ? 1 : 0, "is_diagonal_int")
plot(left_point.exposeMatrix().is_identity() ? 1 : 0, "is_identity_float")
plot(right_point.exposeIntMatrix().is_identity() ? 1 : 0, "is_identity_int")
plot(left_point.exposeMatrix().is_symmetric() ? 1 : 0, "is_symmetric_float")
plot(right_point.exposeIntMatrix().is_symmetric() ? 1 : 0, "is_symmetric_int")
plot(left_point.exposeMatrix().is_antisymmetric() ? 1 : 0, "is_antisymmetric_float")
plot(right_point.exposeIntMatrix().is_antisymmetric() ? 1 : 0, "is_antisymmetric_int")
plot(left_point.exposeMatrix().is_stochastic() ? 1 : 0, "is_stochastic_float")
plot(right_point.exposeIntMatrix().is_stochastic() ? 1 : 0, "is_stochastic_int")
plot(left_point.exposeMatrix().avg(), "sum_float")
plot(right_point.exposeIntMatrix().avg(), "sum_int")
plot(left_point.exposeMatrix().avg(), "avg_float")
plot(right_point.exposeIntMatrix().avg(), "avg_int")
plot(left_point.exposeMatrix().min(), "min_float")
plot(right_point.exposeIntMatrix().min(), "min_int")
plot(left_point.exposeMatrix().max(), "max_float")
plot(right_point.exposeIntMatrix().max(), "max_int")
plot(left_point.exposeMatrix().mode(), "mode_float")
plot(right_point.exposeIntMatrix().mode(), "mode_int")
plot(left_point.exposeMatrix().trace(), "trace_float")
plot(right_point.exposeIntMatrix().trace(), "trace_int")
plot(left_point.exposeMatrix().det(), "det_float")
plot(left_point.exposeMatrix().rank(), "rank_float")
plot(right_point.exposeIntMatrix().rank(), "rank_int")
plot(source.get(0, 0), "source_independent")
plot(copied.get(0, 0), "copy_independent")
plot(left_point.exposeIntMatrix().get(0, 1), "int")
plot(left_point.exposeStringMatrix().get(0, 0) == "pine" ? 1 : 0, "string")
plot(left_point.exposeBoolMatrix().get(0, 0) ? 1 : 0, "bool")
plot(left_point.exposeColorMatrix().get(0, 0) == color.red ? 1 : 0, "color")
plot(left_point.exposeEmptyMatrix().rows() * 100 + left_point.exposeEmptyMatrix().columns() * 10 + left_point.exposeEmptyMatrix().elements_count(), "empty")
plot(left_point.exposeMatrixBlock().get(1, 1), "block")
plot(left_point.exposeMatrixNested().get(1, 0), "nested")
plot(left_point.exposeMatrixIf(other=true).get(0, 0), "control_flow")
plot(left.exposeMatrix(left_point).get(0, 0), "alias_qualified")
plot(left.Point.new(3.0).exposeMatrix().get(1, 1), "constructor_receiver")
plot(right_point.exposeMatrix().get(0, 0), "dual_alias")
plot(left_point.exposeMatrix().copy().copy().get(0, 1), "nested_copy")
plot(left_point.exposeMatrix().transpose().rows(), "transpose_rows")
plot(left_point.exposeMatrix().transpose().columns(), "transpose_columns")
plot(left_point.exposeMatrix().transpose().get(1, 0), "transpose_get")
plot(left_point.exposeMatrix().transpose().copy().transpose().get(0, 1), "transpose_copy_chain_get")
plot(right_point.exposeIntMatrix().transpose().get(1, 0), "transpose_int")
plot(right_point.exposeStringMatrix().transpose().get(0, 0) == "pine" ? 1 : 0, "transpose_string")
plot(left_point.exposeMatrix().submatrix(0, 1, 0, 2).rows(), "submatrix_rows")
plot(left_point.exposeMatrix().submatrix(0, 1, 0, 2).columns(), "submatrix_columns")
plot(left_point.exposeMatrix().submatrix().get(1, 0), "submatrix_get")
plot(left_point.exposeMatrix().transpose().submatrix().copy().get(1, 0), "submatrix_nested_get")
plot(right_point.exposeIntMatrix().submatrix().get(0, 1), "submatrix_int")
plot(right_point.exposeStringMatrix().submatrix().get(0, 0) == "pine" ? 1 : 0, "submatrix_string")
plot(left_point.exposeEmptyMatrix().submatrix().rows() * 100 + left_point.exposeEmptyMatrix().submatrix().columns() * 10 + left_point.exposeEmptyMatrix().submatrix().elements_count(), "submatrix_empty_shape")
plot(na(left_point.exposeMatrix().inv().rows()) ? 1 : 0, "inv_singular_na")
plot(na(left_point.exposeMatrix().inv().inv().rows()) ? 1 : 0, "inv_chain_na")
plot(na(right_point.exposeMatrixBlock().copy().inv().submatrix().rows()) ? 1 : 0, "inv_nested_na")
plot(left_point.exposeMatrix().pinv().rows(), "pinv_rows")
plot(left_point.exposeMatrix().pinv().columns(), "pinv_columns")
plot(left_point.exposeMatrix().pinv().get(0, 1), "pinv_singular_get")
plot(left_point.exposeMatrix().pinv().pinv().get(1, 0), "pinv_chain_get")
plot(right_point.exposeIntMatrix().pinv().rows() * 100 + right_point.exposeIntMatrix().pinv().columns() * 10, "pinv_int_shape")
plot(left_point.exposeEmptyMatrix().pinv().rows() * 100 + left_point.exposeEmptyMatrix().pinv().columns() * 10 + left_point.exposeEmptyMatrix().pinv().elements_count(), "pinv_empty_shape")
plot(right_point.exposeMatrixBlock().copy().pinv().transpose().get(0, 0), "pinv_nested_get")
plot(left_point.exposeMatrix().eigenvectors().rows(), "eigenvectors_rows")
plot(left_point.exposeMatrix().eigenvectors().columns(), "eigenvectors_columns")
plot(left_point.exposeMatrix().eigenvectors().get(0, 0), "eigenvectors_get")
plot(left_point.exposeMatrix().eigenvectors().eigenvectors().get(1, 1), "eigenvectors_chain_get")
plot(right_point.exposeMatrixBlock().copy().eigenvectors().pinv().get(0, 0), "eigenvectors_nested_get")
plot(left_point.exposeMatrix().pow(2).rows(), "pow_rows")
plot(left_point.exposeMatrix().pow(2).columns(), "pow_columns")
plot(left_point.exposeMatrix().pow(2).get(0, 0), "pow_get")
plot(left_point.exposeMatrix().pow(2).pow(2).get(1, 1), "pow_chain_get")
plot(left_point.exposeMatrix().pow(0).get(0, 0), "pow_identity_get")
plot(right_point.exposeMatrixBlock().copy().pow(2).pinv().get(0, 0), "pow_nested_get")
kron_other = matrix.new<float>(1, 1, 2.0)
kron_chain_copy = left_point.exposeMatrix().kron(kron_other)
kron_chain_copy.set(0, 0, 779.0)
plot(left_point.exposeMatrix().kron(kron_other).rows(), "kron_rows")
plot(left_point.exposeMatrix().kron(kron_other).columns(), "kron_columns")
plot(left_point.exposeMatrix().kron(kron_other).get(0, 1), "kron_get")
plot(left_point.exposeMatrix().kron(kron_other).kron(kron_other).get(1, 1), "kron_chain_get")
plot(right_point.exposeIntMatrix().kron(matrix.new<int>(1, 1, 3)).get(0, 0), "kron_int")
plot(left_point.exposeEmptyMatrix().kron(kron_other).rows() * 100 + left_point.exposeEmptyMatrix().kron(kron_other).columns() * 10 + left_point.exposeEmptyMatrix().kron(kron_other).elements_count(), "kron_empty_shape")
plot(right_point.exposeMatrixBlock().copy().kron(kron_other).pinv().get(0, 0), "kron_nested_get")
plot(kron_chain_copy.get(0, 0), "kron_mutation")
plot(source.get(0, 0), "kron_source_unchanged")
diff_chain_copy = left_point.exposeMatrix().diff(1.0)
diff_chain_copy.set(0, 0, 783.0)
plot(left_point.exposeMatrix().diff(1.0).rows(), "diff_rows")
plot(left_point.exposeMatrix().diff(1.0).columns(), "diff_columns")
plot(left_point.exposeMatrix().diff(1.0).get(0, 1), "diff_get")
plot(left_point.exposeMatrix().diff(1.0).diff(2.0).get(1, 1), "diff_chain_get")
plot(right_point.exposeIntMatrix().diff(2).get(0, 0), "diff_int")
plot(na(left_point.exposeMatrix().diff(na).get(0, 0)) ? 1 : 0, "diff_scalar_na")
plot(left_point.exposeEmptyMatrix().diff(1.0).rows() * 100 + left_point.exposeEmptyMatrix().diff(1.0).columns() * 10 + left_point.exposeEmptyMatrix().diff(1.0).elements_count(), "diff_empty_shape")
plot(right_point.exposeMatrixBlock().copy().diff(1.0).kron(kron_other).get(0, 0), "diff_nested_get")
plot(diff_chain_copy.get(0, 0), "diff_mutation")
plot(source.get(0, 0), "diff_source_unchanged")
mult_chain_copy = left_point.exposeMatrix().mult(2.0)
mult_chain_copy.set(0, 0, 791.0)
mult_array_chain_copy = left_point.exposeMatrix().mult(array.from(1.0, 2.0))
mult_array_chain_copy.set(0, 792.0)
plot(left_point.exposeMatrix().mult(2.0).rows(), "mult_rows")
plot(left_point.exposeMatrix().mult(2.0).columns(), "mult_columns")
plot(left_point.exposeMatrix().mult(2.0).get(0, 1), "mult_scalar_get")
plot(left_point.exposeMatrix().mult(matrix.new<float>(2, 1, 1.0)).get(1, 0), "mult_matrix_get")
plot(left_point.exposeMatrix().mult(array.from(1.0, 2.0)).copy().get(1), "mult_array_get")
plot(left_point.exposeMatrix().mult(2.0).mult(0.5).get(1, 1), "mult_chain_get")
plot(right_point.exposeIntMatrix().mult(matrix.new<int>(2, 1, 3)).get(0, 0), "mult_int")
plot(na(left_point.exposeMatrix().mult(na).get(0, 0)) ? 1 : 0, "mult_scalar_na")
plot(left_point.exposeEmptyMatrix().mult(2.0).rows() * 100 + left_point.exposeEmptyMatrix().mult(2.0).columns() * 10 + left_point.exposeEmptyMatrix().mult(2.0).elements_count(), "mult_empty_shape")
plot(left_point.exposeEmptyMatrix().mult(array.from(1.0, 1.0, 1.0)).size(), "mult_empty_array_size")
plot(right_point.exposeMatrixBlock().copy().mult(2.0).diff(1.0).get(0, 0), "mult_nested_get")
plot(mult_chain_copy.get(0, 0), "mult_mutation")
plot(mult_array_chain_copy.get(0), "mult_array_mutation")
plot(source.get(0, 0), "mult_source_unchanged")
plot(left_point.exposeMatrix().mult(array.from(1.0, 2.0)).get(0), "mult_array_source_unchanged")
left_point.exposeMatrix().set(0, 0, 113.0)
right_point.exposeIntMatrix().set(0, 0, 113)
left_point.exposeBoolMatrix().set(0, 0, false)
right_point.exposeStringMatrix().set(0, 0, "set")
left_point.exposeColorMatrix().set(0, 0, color.blue)
plot(1, "call_result_set_fresh_kinds")
left_point.exposeMatrix().fill(313.0)
right_point.exposeIntMatrix().fill(313)
left_point.exposeBoolMatrix().fill(false)
right_point.exposeStringMatrix().fill("fill")
left_point.exposeColorMatrix().fill(color.blue)
plot(1, "call_result_fill_fresh_kinds")
left_point.exposeMatrix().reverse()
right_point.exposeIntMatrix().reverse()
left_point.exposeBoolMatrix().reverse()
right_point.exposeStringMatrix().reverse()
left_point.exposeColorMatrix().reverse()
plot(1, "call_result_reverse_fresh_kinds")
left_point.exposeMatrix().reshape(1, 4)
right_point.exposeIntMatrix().reshape(2, 1)
left_point.exposeBoolMatrix().reshape(1, 1)
right_point.exposeStringMatrix().reshape(1, 1)
left_point.exposeColorMatrix().reshape(1, 1)
plot(1, "call_result_reshape_fresh_kinds")
left_point.exposeMatrix().swap_rows(0, 1)
right_point.exposeIntMatrix().swap_rows(0, 0)
left_point.exposeBoolMatrix().swap_rows(0, 0)
right_point.exposeStringMatrix().swap_rows(0, 0)
left_point.exposeColorMatrix().swap_rows(0, 0)
plot(1, "call_result_swap_rows_fresh_kinds")
left_point.exposeMatrix().swap_columns(0, 1)
right_point.exposeIntMatrix().swap_columns(0, 0)
left_point.exposeBoolMatrix().swap_columns(0, 0)
right_point.exposeStringMatrix().swap_columns(0, 0)
left_point.exposeColorMatrix().swap_columns(0, 0)
plot(1, "call_result_swap_columns_fresh_kinds")
left_point.exposeMatrix().remove_row(0)
right_point.exposeIntMatrix().remove_row(0)
left_point.exposeBoolMatrix().remove_row(0)
right_point.exposeStringMatrix().remove_row(0)
left_point.exposeColorMatrix().remove_row(0)
plot(1, "call_result_remove_row_fresh_kinds")
left_point.exposeMatrix().remove_col(0)
right_point.exposeIntMatrix().remove_col(0)
left_point.exposeBoolMatrix().remove_col(0)
right_point.exposeStringMatrix().remove_col(0)
left_point.exposeColorMatrix().remove_col(0)
plot(1, "call_result_remove_col_fresh_kinds")
left_point.exposeMatrix().add_row(0, array.from(1.0, 2.0))
right_point.exposeIntMatrix().add_row(0, array.from(1, 2))
left_point.exposeBoolMatrix().add_row(0, array.from(false))
right_point.exposeStringMatrix().add_row(0, array.from("row"))
left_point.exposeColorMatrix().add_row(0, array.from(color.blue))
plot(1, "call_result_add_row_fresh_kinds")
left_point.exposeMatrix().add_col(0, array.from(1.0, 2.0))
right_point.exposeIntMatrix().add_col(0, array.from(1))
left_point.exposeBoolMatrix().add_col(0, array.from(false))
right_point.exposeStringMatrix().add_col(0, array.from("column"))
left_point.exposeColorMatrix().add_col(0, array.from(color.blue))
plot(1, "call_result_add_col_fresh_kinds")
left_point.exposeMatrix().sort()
right_point.exposeIntMatrix().sort(0, order.descending)
plot(1, "call_result_sort_fresh_numeric_kinds")
