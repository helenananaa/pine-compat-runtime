//@version=5
indicator("Codex loop request oracle",overlay=true)
f(src)=>
    total=0.0
    for i=0 to 2
        total+=src[i]
    total
g(src)=>
    total=0.0
    i=0
    while i<3
        total+=src[i]
        i+=1
    total
a=f(close)
b=g(close)
c=close+close[1]+close[2]
x=request.security(syminfo.tickerid,"12M",f(close))
y=request.security(syminfo.tickerid,"12M",g(close))
z=request.security(syminfo.tickerid,"12M",close+close[1]+close[2])
var t=table.new(position.top_right,3,2,bgcolor=color.black)
if barstate.islast
    table.cell(t,0,0,str.tostring(a),text_color=color.white)
    table.cell(t,1,0,str.tostring(b),text_color=color.white)
    table.cell(t,2,0,str.tostring(c),text_color=color.white)
    table.cell(t,0,1,str.tostring(x),text_color=color.white)
    table.cell(t,1,1,str.tostring(y),text_color=color.white)
    table.cell(t,2,1,str.tostring(z),text_color=color.white)
