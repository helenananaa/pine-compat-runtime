//@version=6
indicator("Supported user-method matrix call-result reads")

type Anchor
    int tag

method expose(Anchor self) => float_values

method exposeBlock(Anchor self) =>
    made = float_values.copy()
    made

method exposeInt(Anchor self) => matrix.new<int>(1, 2, 7)
method exposeBool(Anchor self) => matrix.new<bool>(1, 1, true)
method exposeString(Anchor self) => matrix.new<string>(1, 1, "pine")
method exposeColor(Anchor self) => matrix.new<color>(1, 1, color.red)
method exposeEmpty(Anchor self) => matrix.new<float>(0, 3)
method exposeIf(Anchor self, bool use_other) => use_other ? alternate : float_values.copy()
method exposeNested(Anchor self) => self.exposeBlock()

float_values = matrix.new<float>(2, 2, 1.0)
alternate = matrix.new<float>(2, 2, 8.0)
anchor = Anchor.new(1)

rows = anchor.expose().rows()
columns = anchor.expose().columns()
elements = anchor.expose().elements_count()
get = anchor.expose().get(0, 1)
copy_chain = anchor.expose().copy().get(1, 1)
int_get = anchor.exposeInt().get(0, 1)
bool_get = anchor.exposeBool().get(0, 0)
string_get = anchor.exposeString().get(0, 0)
color_get = anchor.exposeColor().get(0, 0)
empty = anchor.exposeEmpty().columns()
block_return = anchor.exposeBlock().get(1, 1)
nested_return = anchor.exposeNested().get(1, 0)
control_flow = anchor.exposeIf(use_other=true).get(0, 0)
qualified = Anchor.expose(anchor).get(0, 0)
constructor_receiver = Anchor.new(2).expose().get(1, 1)
nested_copy = anchor.expose().copy().copy().get(0, 1)
float_row = anchor.expose().row(1).copy()
int_row = anchor.exposeInt().row(0)
bool_row = anchor.exposeBool().row(0)
string_row = anchor.exposeString().row(0)
color_row = anchor.exposeColor().row(0)
float_col = anchor.expose().col(1).copy()
int_col = anchor.exposeInt().col(1)
bool_col = anchor.exposeBool().col(0)
string_col = anchor.exposeString().col(0)
color_col = anchor.exposeColor().col(0)
float_eigenvalues = anchor.expose().eigenvalues().copy()
int_eigenvalues = anchor.exposeInt().eigenvalues()
float_is_square = anchor.expose().is_square()
string_is_square = anchor.exposeString().is_square()
float_is_zero = anchor.expose().is_zero()
int_is_zero = anchor.exposeInt().is_zero()
float_is_binary = anchor.expose().is_binary()
int_is_binary = anchor.exposeInt().is_binary()
float_is_diagonal = anchor.expose().is_diagonal()
int_is_diagonal = anchor.exposeInt().is_diagonal()
float_is_identity = anchor.expose().is_identity()
int_is_identity = anchor.exposeInt().is_identity()
float_is_symmetric = anchor.expose().is_symmetric()
int_is_symmetric = anchor.exposeInt().is_symmetric()
float_is_antisymmetric = anchor.expose().is_antisymmetric()
int_is_antisymmetric = anchor.exposeInt().is_antisymmetric()
float_is_stochastic = anchor.expose().is_stochastic()
int_is_stochastic = anchor.exposeInt().is_stochastic()
float_sum = anchor.expose().avg()
int_sum = anchor.exposeInt().avg()
float_avg = anchor.expose().avg()
int_avg = anchor.exposeInt().avg()
float_min = anchor.expose().min()
int_min = anchor.exposeInt().min()
float_max = anchor.expose().max()
int_max = anchor.exposeInt().max()
float_mode = anchor.expose().mode()
int_mode = anchor.exposeInt().mode()
float_trace = anchor.expose().trace()
int_trace = anchor.exposeInt().trace()
float_det = anchor.expose().det()
int_det = anchor.exposeInt().det()
float_rank = anchor.expose().rank()
int_rank = anchor.exposeInt().rank()
transposed_rows = anchor.expose().transpose().rows()
transposed_columns = anchor.expose().transpose().columns()
transposed_get = anchor.expose().transpose().get(1, 0)
transposed_bool = anchor.exposeBool().transpose().get(0, 0)
repeated_transpose = anchor.expose().copy().transpose().transpose().get(0, 1)
sliced_rows = anchor.expose().submatrix(0, 1, 0, 2).rows()
sliced_columns = anchor.expose().submatrix().columns()
sliced_get = anchor.expose().submatrix().get(1, 0)
sliced_bool = anchor.exposeBool().submatrix().get(0, 0)
nested_slice = anchor.expose().transpose().submatrix().copy().get(1, 0)
inverted_rows = anchor.expose().inv().rows()
inverted_int = anchor.exposeInt().inv().get(0, 0)
nested_inv = anchor.expose().copy().inv().submatrix().get(0, 0)
pseudo_rows = anchor.expose().pinv().rows()
pseudo_int = anchor.exposeInt().pinv().get(0, 0)
nested_pinv = anchor.expose().copy().pinv().transpose().get(0, 0)
vector_rows = anchor.expose().eigenvectors().rows()
vector_int = anchor.exposeInt().eigenvectors().get(0, 0)
nested_vectors = anchor.expose().copy().eigenvectors().pinv().get(0, 0)
powered_rows = anchor.expose().pow(2).rows()
powered_int = anchor.exposeInt().pow(3).get(0, 0)
nested_power = anchor.expose().copy().pow(2).pinv().get(0, 0)
kron_other = matrix.new<float>(1, 1, 2.0)
kron_rows = anchor.expose().kron(kron_other).rows()
kron_int = anchor.exposeInt().kron(matrix.new<int>(1, 1, 3)).get(0, 0)
nested_kron = anchor.expose().copy().kron(kron_other).pow(2).get(0, 0)
diff_rows = anchor.expose().diff(1.0).rows()
diff_int = anchor.exposeInt().diff(matrix.new<int>(1, 1, 1)).get(0, 0)
nested_diff = anchor.expose().copy().diff(1.0).kron(kron_other).get(0, 0)
mult_rows = anchor.expose().mult(2.0).rows()
mult_int = anchor.exposeInt().mult(matrix.new<int>(2, 2, 3)).get(0, 0)
mult_array_size = anchor.expose().mult(array.from(1.0, 1.0)).copy().size()
nested_mult = anchor.expose().copy().mult(2.0).diff(1.0).get(0, 0)

plot(rows + columns + elements + get + copy_chain + int_get + empty + block_return + nested_return + control_flow + qualified + constructor_receiver + nested_copy + float_row.size() + int_row.size() + bool_row.size() + string_row.size() + color_row.size() + float_col.size() + int_col.size() + bool_col.size() + string_col.size() + color_col.size() + float_eigenvalues.size() + int_eigenvalues.size() + (float_is_square ? 1 : 0) + (string_is_square ? 1 : 0) + (float_is_zero ? 1 : 0) + (int_is_zero ? 1 : 0) + (float_is_binary ? 1 : 0) + (int_is_binary ? 1 : 0) + (float_is_diagonal ? 1 : 0) + (int_is_diagonal ? 1 : 0) + (float_is_identity ? 1 : 0) + (int_is_identity ? 1 : 0) + (float_is_symmetric ? 1 : 0) + (int_is_symmetric ? 1 : 0) + (float_is_antisymmetric ? 1 : 0) + (int_is_antisymmetric ? 1 : 0) + (float_is_stochastic ? 1 : 0) + (int_is_stochastic ? 1 : 0) + float_sum + int_sum + float_avg + int_avg + float_min + int_min + float_max + int_max + float_mode + int_mode + float_trace + int_trace + float_det + int_det + float_rank + int_rank)
plot(transposed_rows + transposed_columns + transposed_get + (transposed_bool ? 1 : 0) + repeated_transpose)
plot(sliced_rows + sliced_columns + sliced_get + (sliced_bool ? 1 : 0) + nested_slice)
plot(inverted_rows + inverted_int + nested_inv)
plot(pseudo_rows + pseudo_int + nested_pinv)
plot(vector_rows + vector_int + nested_vectors)
plot(powered_rows + powered_int + nested_power)
plot(kron_rows + kron_int + nested_kron)
plot(diff_rows + diff_int + nested_diff)
plot(mult_rows + mult_int + mult_array_size + nested_mult)
anchor.expose().set(0, 0, 2.0)
anchor.expose().fill(2.0)
anchor.expose().reverse()
anchor.expose().reshape(1, 4)
anchor.expose().swap_rows(0, 1)
anchor.expose().swap_columns(0, 1)
anchor.exposeInt().set(0, 0, 2)
anchor.exposeInt().fill(2)
anchor.exposeInt().reverse()
anchor.exposeInt().reshape(2, 1)
anchor.exposeInt().swap_rows(0, 0)
anchor.exposeInt().swap_columns(0, 0)
anchor.exposeBool().set(0, 0, false)
anchor.exposeBool().fill(false)
anchor.exposeBool().reverse()
anchor.exposeBool().reshape(1, 1)
anchor.exposeBool().swap_rows(0, 0)
anchor.exposeBool().swap_columns(0, 0)
anchor.exposeString().set(0, 0, "set")
anchor.exposeString().fill("fill")
anchor.exposeString().reverse()
anchor.exposeString().reshape(1, 1)
anchor.exposeString().swap_rows(0, 0)
anchor.exposeString().swap_columns(0, 0)
anchor.exposeColor().set(0, 0, color.blue)
anchor.exposeColor().fill(color.blue)
anchor.exposeColor().reverse()
anchor.exposeColor().reshape(1, 1)
anchor.exposeColor().swap_rows(0, 0)
anchor.exposeColor().swap_columns(0, 0)
anchor.expose().remove_row(0)
anchor.expose().remove_col(0)
anchor.exposeInt().remove_row(0)
anchor.exposeInt().remove_col(0)
anchor.exposeBool().remove_row(0)
anchor.exposeBool().remove_col(0)
anchor.exposeString().remove_row(0)
anchor.exposeString().remove_col(0)
anchor.exposeColor().remove_row(0)
anchor.exposeColor().remove_col(0)
anchor.expose().add_row(0, array.from(1.0))
anchor.exposeInt().add_row(0, array.from(1))
anchor.exposeBool().add_row(0, array.from(false))
anchor.exposeString().add_row(0, array.from("row"))
anchor.exposeColor().add_row(0, array.from(color.blue))

anchor.expose().add_col(0, array.from(1.0))
anchor.exposeInt().add_col(0, array.from(1))
anchor.exposeBool().add_col(0, array.from(false))
anchor.exposeString().add_col(0, array.from("column"))
anchor.exposeColor().add_col(0, array.from(color.blue))

anchor.expose().sort()
anchor.exposeInt().sort(0, order.descending)
