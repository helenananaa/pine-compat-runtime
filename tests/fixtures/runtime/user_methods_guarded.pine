//@version=5
indicator("User-defined methods")
type Point
    float x
type Wrapper
    Point point

makePoint(x) => Point.new(x)
makePointNamed(x) => Point.new(x=x)

method shift(Point p, float delta) => (na(p) ? na : p.x) + delta
method keep(Point p) => p
method keepBlock(Point p) =>
    copy = p
    copy
method keepTernary(Point p, bool flip) =>
    copy = p
    flip ? copy : p
method keepIf(Point p, bool flip) =>
    if flip
        copy = p
        copy
    else
        copy = p
        copy
method keepFor(Point p, int count) =>
    for i = 0 to count
        copy = p
        copy
method keepForIn(Point p, array<int> values) =>
    for value in values
        copy = p
        copy
method keepWhile(Point p, bool keepGoing) =>
    active = keepGoing
    while active
        copy = p
        active := false
        copy
method keepSwitch(Point p, int selector) =>
    switch selector
        0 =>
            copy = p
            copy
        =>
            copy = p
            copy
method choose(Point p, Point other) => other
method chooseBlock(Point p, Point other) =>
    copy = other
    copy
method chooseTernary(Point p, Point other, bool flip) =>
    copy = other
    flip ? copy : other
method chooseIf(Point p, Point other, bool flip) =>
    if flip
        copy = other
        copy
    else
        copy = other
        copy
method chooseFor(Point p, Point other, int count) =>
    for i = 0 to count
        copy = other
        copy
method chooseForIn(Point p, Point other, array<int> values) =>
    for value in values
        copy = other
        copy
method chooseWhile(Point p, Point other, bool keepGoing) =>
    active = keepGoing
    while active
        copy = other
        active := false
        copy
method chooseSwitch(Point p, Point other, int selector) =>
    switch selector
        0 =>
            copy = other
            copy
        =>
            copy = other
            copy
method wrap(Point p, Point other) => p.choose(other)
method clone(Point p) => Point.new((na(p) ? na : p.x))
method cloneOther(Point p, Point other) => Point.new((na(other) ? na : other.x))
method cloneOtherNamed(Point p, Point other) => Point.new(x=(na(other) ? na : other.x))
method cloneAlias(Point p) =>
    ax = (na(p) ? na : p.x)
    Point.new(ax)
method cloneOtherAlias(Point p, Point other) =>
    ox = (na(other) ? na : other.x)
    Point.new(ox)
method cloneOtherNamedAlias(Point p, Point other) =>
    ox = (na(other) ? na : other.x)
    Point.new(x=ox)
method cloneObjectAlias(Point p) =>
    copy = p
    Point.new((na(copy) ? na : copy.x))
method cloneOtherObjectAlias(Point p, Point other) =>
    copy = other
    Point.new((na(copy) ? na : copy.x))
method cloneOtherNamedObjectAlias(Point p, Point other) =>
    copy = other
    Point.new(x=(na(copy) ? na : copy.x))
method cloneViaMake(Point p) => makePoint((na(p) ? na : p.x))
method cloneOtherViaMake(Point p, Point other) => makePoint((na(other) ? na : other.x))
method cloneOtherViaMakeNamed(Point p, Point other) => makePointNamed((na(other) ? na : other.x))
method cloneTernary(Point p, bool flip) => flip ? Point.new((na(p) ? na : p.x)) : Point.new((na(p) ? na : p.x) + 10)
method cloneOtherTernary(Point p, Point other, bool flip) => flip ? Point.new((na(other) ? na : other.x)) : Point.new((na(other) ? na : other.x) + 10)
method cloneSwitch(Point p, int mode) =>
    switch mode
        0 => Point.new((na(p) ? na : p.x))
        1 => Point.new((na(p) ? na : p.x) + 5)
        => Point.new((na(p) ? na : p.x) + 10)
method cloneOtherSwitch(Point p, Point other, int mode) =>
    switch mode
        0 => Point.new((na(other) ? na : other.x))
        1 => Point.new((na(other) ? na : other.x) + 5)
        => Point.new((na(other) ? na : other.x) + 10)
method cloneIf(Point p, bool flip) =>
    if flip
        Point.new((na(p) ? na : p.x))
    else
        Point.new((na(p) ? na : p.x) + 10)
method cloneOtherIf(Point p, Point other, bool flip) =>
    if flip
        Point.new((na(other) ? na : other.x))
    else
        Point.new((na(other) ? na : other.x) + 10)
method cloneFor(Point p, int count) =>
    for i = 0 to count
        Point.new((na(p) ? na : p.x) + i)
method cloneOtherFor(Point p, Point other, int count) =>
    for i = 0 to count
        Point.new((na(other) ? na : other.x) + i)
method make(Point p, float x) => Point.new(x)
method makeBlock(Point p, float x) =>
    ax = x
    Point.new(ax)
method makeNamed(Point p, float x) => Point.new(x=x)
method makeNamedBlock(Point p, float x) =>
    ax = x
    Point.new(x=ax)
method makeTyped(Point p, float x) =>
    Point made = na
    made := Point.new(x)
    made
method makeTypedFrom(Point p, Point other) =>
    copy = p
    otherCopy = other
    px = (na(copy) ? na : copy.x)
    ox = (na(otherCopy) ? na : otherCopy.x)
    Point made = na
    made := Point.new(x=px + ox + 25)
    made
method makeTypedConstructed(Point p, float x) =>
    Point made = Point.new(x + 30)
    made := Point.new((na(made) ? na : made.x) + 5)
    made
method makeTypedConstructedFrom(Point p, Point other) =>
    copy = p
    otherCopy = other
    px = (na(copy) ? na : copy.x)
    ox = (na(otherCopy) ? na : otherCopy.x)
    Point made = Point.new(x=px + ox + 35)
    made := Point.new(x=(na(made) ? na : made.x) + 5)
    made
method makeTypedTernary(Point p, float x, bool flip) =>
    Point made = flip ? Point.new(x + 40) : Point.new(x + 45)
    made := flip ? Point.new((na(made) ? na : made.x) + 5) : Point.new((na(made) ? na : made.x) + 10)
    made
method makeTypedTernaryFrom(Point p, Point other, bool flip) =>
    copy = p
    otherCopy = other
    px = (na(copy) ? na : copy.x)
    ox = (na(otherCopy) ? na : otherCopy.x)
    Point made = flip ? Point.new(x=px + 70) : Point.new(x=ox + 75)
    made := flip ? Point.new(x=(na(made) ? na : made.x) + 5) : Point.new(x=(na(made) ? na : made.x) + 10)
    made
method makeTypedSwitch(Point p, float x, int mode) =>
    Point made = switch mode
        0 => Point.new(x + 55)
        1 => Point.new(x + 60)
        => Point.new(x + 65)
    made := switch mode
        3 => Point.new((na(made) ? na : made.x) + 5)
        => Point.new((na(made) ? na : made.x) + 10)
    made
method makeTypedSwitchFrom(Point p, Point other, int mode) =>
    copy = p
    otherCopy = other
    px = (na(copy) ? na : copy.x)
    ox = (na(otherCopy) ? na : otherCopy.x)
    Point made = switch mode
        0 => Point.new(x=px + 90)
        1 => Point.new(x=ox + 95)
        => Point.new(x=(na(copy) ? na : copy.x) + 100)
    made := switch mode
        3 => Point.new(x=(na(made) ? na : made.x) + 5)
        => Point.new(x=(na(made) ? na : made.x) + 10)
    made
method makeTypedIfFrom(Point p, Point other, bool flip) =>
    copy = p
    otherCopy = other
    px = (na(copy) ? na : copy.x)
    ox = (na(otherCopy) ? na : otherCopy.x)
    Point made = if flip
        branch = Point.new(x=px + 120)
        branch
    else
        branch = Point.new(x=ox + 125)
        branch
    made := if flip
        Point.new(x=(na(made) ? na : made.x) + 5)
    else
        Point.new(x=(na(made) ? na : made.x) + 10)
    made
method makeTypedForFrom(Point p, Point other, int count) =>
    copy = p
    otherCopy = other
    px = (na(copy) ? na : copy.x)
    ox = (na(otherCopy) ? na : otherCopy.x)
    Point made = for i = 0 to count
        Point.new(x=px + ox + i + 110)
    made := for i = 0 to count
        Point.new(x=(na(made) ? na : made.x) + i + 5)
    made
method makeTypedForInFrom(Point p, Point other, array<int> values) =>
    copy = p
    otherCopy = other
    px = (na(copy) ? na : copy.x)
    ox = (na(otherCopy) ? na : otherCopy.x)
    Point made = for value in values
        Point.new(x=px + ox + value + 140)
    made := for value in values
        Point.new(x=(na(made) ? na : made.x) + value + 5)
    made
method makeTypedWhileFrom(Point p, Point other, int count) =>
    copy = p
    otherCopy = other
    px = (na(copy) ? na : copy.x)
    ox = (na(otherCopy) ? na : otherCopy.x)
    i = 0
    Point made = while i < count
        i := i + 1
        Point.new(x=px + ox + i + 150)
    j = 0
    made := while j < count
        j := j + 1
        Point.new(x=(na(made) ? na : made.x) + j + 5)
    made
method toWrapper(Point p) => Wrapper.new(p)
method makeWrapper(Point p, float x) => Wrapper.new(Point.new(x))
method makeWrapperViaMethod(Point p, float x) => p.makeWrapper(x)
method toWrapperSwitch(Point p, int mode) =>
    switch mode
        0 => Wrapper.new(Point.new((na(p) ? na : p.x) + 170))
        1 => Wrapper.new(Point.new((na(p) ? na : p.x) + 175))
        => Wrapper.new(Point.new((na(p) ? na : p.x) + 180))
method keepWrapper(Wrapper w) => w
method keepWrapperViaMethod(Wrapper w) => w.keepWrapper()
method chooseWrapper(Wrapper w, Wrapper other, bool flip) => flip ? w : other
method mutateLocal(Point p, float delta) =>
    local = Point.new((na(p) ? na : p.x))
    local.x := (na(local) ? na : local.x) + delta
    local

p = Point.new(close)
q = Point.new(open)
steps = array.from(1, 2)
same = p.keep()
sameBlock = p.keepBlock()
sameTernary = p.keepTernary(bar_index < 2)
sameIf = p.keepIf(bar_index < 2)
sameFor = p.keepFor(2)
sameForIn = p.keepForIn(steps)
sameWhile = p.keepWhile(close > 0)
sameSwitch = p.keepSwitch(bar_index % 2)
chosen = p.choose(q)
chosenBlock = p.chooseBlock(q)
chosenTernary = p.chooseTernary(q, bar_index < 2)
chosenIf = p.chooseIf(q, bar_index < 2)
chosenFor = p.chooseFor(q, 2)
chosenForIn = p.chooseForIn(q, steps)
chosenWhile = p.chooseWhile(q, close > 0)
chosenSwitch = p.chooseSwitch(q, bar_index % 2)
wrapped = p.wrap(q)
cloned = p.clone()
clonedOther = p.cloneOther(q)
clonedOtherNamed = p.cloneOtherNamed(q)
clonedAlias = p.cloneAlias()
clonedOtherAlias = p.cloneOtherAlias(q)
clonedOtherNamedAlias = p.cloneOtherNamedAlias(q)
clonedObjectAlias = p.cloneObjectAlias()
clonedOtherObjectAlias = p.cloneOtherObjectAlias(q)
clonedOtherNamedObjectAlias = p.cloneOtherNamedObjectAlias(q)
clonedViaMake = p.cloneViaMake()
clonedOtherViaMake = p.cloneOtherViaMake(q)
clonedOtherViaMakeNamed = p.cloneOtherViaMakeNamed(q)
clonedTernary = p.cloneTernary(bar_index < 2)
clonedOtherTernary = p.cloneOtherTernary(q, bar_index < 2)
clonedSwitch = p.cloneSwitch(bar_index)
clonedOtherSwitch = p.cloneOtherSwitch(q, bar_index)
clonedIf = p.cloneIf(bar_index < 2)
clonedOtherIf = p.cloneOtherIf(q, bar_index < 2)
clonedFor = p.cloneFor(2)
clonedOtherFor = p.cloneOtherFor(q, 2)
made = p.make(open)
madeBlock = p.makeBlock(open)
madeNamed = p.makeNamed(open)
madeNamedBlock = p.makeNamedBlock(open)
madeTyped = p.makeTyped(open)
madeTypedFrom = p.makeTypedFrom(q)
madeTypedConstructed = p.makeTypedConstructed(open)
madeTypedConstructedFrom = p.makeTypedConstructedFrom(q)
madeTypedTernary = p.makeTypedTernary(open, bar_index < 2)
madeTypedTernaryFrom = p.makeTypedTernaryFrom(q, bar_index < 2)
madeTypedSwitch = p.makeTypedSwitch(open, bar_index)
madeTypedSwitchFrom = p.makeTypedSwitchFrom(q, bar_index)
madeTypedIfFrom = p.makeTypedIfFrom(q, bar_index < 2)
madeTypedForFrom = p.makeTypedForFrom(q, 2)
madeTypedForInFrom = p.makeTypedForInFrom(q, steps)
madeTypedWhileFrom = p.makeTypedWhileFrom(q, 2)
wrappedMade = p.toWrapper()
wrappedMadeViaMethod = p.makeWrapperViaMethod(close)
wrappedSwitch = p.toWrapperSwitch(bar_index)
wrappedSource = Wrapper.new(p)
wrappedOther = Wrapper.new(Point.new(open + 190))
wrappedKept = wrappedSource.keepWrapper()
wrappedKeptNested = wrappedSource.keepWrapperViaMethod()
wrappedChosen = wrappedSource.chooseWrapper(wrappedOther, bar_index % 2 == 0)
mutatedLocal = p.mutateLocal(200)
samePrior = same[1]
sameSwitchPrior = sameSwitch[1]
chosenForInPrior = chosenForIn[1]
clonedSwitchPrior = clonedSwitch[1]
clonedOtherSwitchPrior = clonedOtherSwitch[1]
madeTypedSwitchFromPrior = madeTypedSwitchFrom[1]
madeTypedForInFromPrior = madeTypedForInFrom[1]
madeTypedWhileFromPrior = madeTypedWhileFrom[1]
wrappedMadePrior = wrappedMade[1]
wrappedSwitchPrior = wrappedSwitch[1]
wrappedKeptPrior = wrappedKept[1]
wrappedChosenPrior = wrappedChosen[1]
dyn = bar_index == 0 ? na : 1
sameDynamic = same[dyn]
sameDynamicSibling = same[dyn]
float sameDynamicX = na
float sameDynamicSiblingXAfterMutation = na
wrappedKeptDynamic = wrappedKept[dyn]
wrappedKeptDynamicSibling = wrappedKept[dyn]
float wrappedKeptDynamicX = na
float wrappedKeptDynamicSiblingXAfterMutation = na
wrappedPointDynamic = wrapped[dyn]
wrappedPointDynamicSibling = wrapped[dyn]
float wrappedPointDynamicX = na
float wrappedPointDynamicSiblingXAfterMutation = na
wrappedKeptNestedDynamic = wrappedKeptNested[dyn]
wrappedKeptNestedDynamicSibling = wrappedKeptNested[dyn]
float wrappedKeptNestedDynamicX = na
float wrappedKeptNestedDynamicSiblingXAfterMutation = na
clonedDynamic = cloned[dyn]
clonedDynamicSibling = cloned[dyn]
float clonedDynamicX = na
float clonedDynamicSiblingXAfterMutation = na
clonedViaMakeDynamic = clonedViaMake[dyn]
clonedViaMakeDynamicSibling = clonedViaMake[dyn]
float clonedViaMakeDynamicX = na
float clonedViaMakeDynamicSiblingXAfterMutation = na
wrappedMadeDynamic = wrappedMade[dyn]
wrappedMadeDynamicSibling = wrappedMade[dyn]
float wrappedMadeDynamicX = na
float wrappedMadeDynamicSiblingXAfterMutation = na
wrappedMadeViaMethodDynamic = wrappedMadeViaMethod[dyn]
wrappedMadeViaMethodDynamicSibling = wrappedMadeViaMethod[dyn]
float wrappedMadeViaMethodDynamicX = na
float wrappedMadeViaMethodDynamicSiblingXAfterMutation = na
if bar_index > 0
    sameDynamicX := (na(sameDynamic) ? na : sameDynamic.x)
    sameDynamic.x := close + 700
    sameDynamicSiblingXAfterMutation := (na(sameDynamicSibling) ? na : sameDynamicSibling.x)
    wrappedKeptDynamicX := (na(wrappedKeptDynamic) ? na : na(wrappedKeptDynamic.point) ? na : wrappedKeptDynamic.point.x)
    wrappedKeptDynamic.point := Point.new(close + 800)
    wrappedKeptDynamicSiblingXAfterMutation := (na(wrappedKeptDynamicSibling) ? na : na(wrappedKeptDynamicSibling.point) ? na : wrappedKeptDynamicSibling.point.x)
    wrappedPointDynamicX := (na(wrappedPointDynamic) ? na : wrappedPointDynamic.x)
    wrappedPointDynamic.x := close + 1100
    wrappedPointDynamicSiblingXAfterMutation := (na(wrappedPointDynamicSibling) ? na : wrappedPointDynamicSibling.x)
    wrappedKeptNestedDynamicX := (na(wrappedKeptNestedDynamic) ? na : na(wrappedKeptNestedDynamic.point) ? na : wrappedKeptNestedDynamic.point.x)
    wrappedKeptNestedDynamic.point := Point.new(close + 1200)
    wrappedKeptNestedDynamicSiblingXAfterMutation := (na(wrappedKeptNestedDynamicSibling) ? na : na(wrappedKeptNestedDynamicSibling.point) ? na : wrappedKeptNestedDynamicSibling.point.x)
    clonedDynamicX := (na(clonedDynamic) ? na : clonedDynamic.x)
    clonedDynamic.x := close + 900
    clonedDynamicSiblingXAfterMutation := (na(clonedDynamicSibling) ? na : clonedDynamicSibling.x)
    clonedViaMakeDynamicX := (na(clonedViaMakeDynamic) ? na : clonedViaMakeDynamic.x)
    clonedViaMakeDynamic.x := close + 1300
    clonedViaMakeDynamicSiblingXAfterMutation := (na(clonedViaMakeDynamicSibling) ? na : clonedViaMakeDynamicSibling.x)
    wrappedMadeDynamicX := (na(wrappedMadeDynamic) ? na : na(wrappedMadeDynamic.point) ? na : wrappedMadeDynamic.point.x)
    wrappedMadeDynamic.point := Point.new(close + 1000)
    wrappedMadeDynamicSiblingXAfterMutation := (na(wrappedMadeDynamicSibling) ? na : na(wrappedMadeDynamicSibling.point) ? na : wrappedMadeDynamicSibling.point.x)
    wrappedMadeViaMethodDynamicX := (na(wrappedMadeViaMethodDynamic) ? na : na(wrappedMadeViaMethodDynamic.point) ? na : wrappedMadeViaMethodDynamic.point.x)
    wrappedMadeViaMethodDynamic.point := Point.new(close + 1400)
    wrappedMadeViaMethodDynamicSiblingXAfterMutation := (na(wrappedMadeViaMethodDynamicSibling) ? na : na(wrappedMadeViaMethodDynamicSibling.point) ? na : wrappedMadeViaMethodDynamicSibling.point.x)
plot(p.shift(open))
plot((na(same) ? na : same.x) + close)
plot((na(sameBlock) ? na : sameBlock.x) + close)
plot((na(sameTernary) ? na : sameTernary.x) + close + 10)
plot((na(chosen) ? na : chosen.x) + close)
plot((na(chosenBlock) ? na : chosenBlock.x) + close)
plot((na(chosenTernary) ? na : chosenTernary.x) + close + 15)
plot((na(chosenIf) ? na : chosenIf.x) + close + 20)
plot((na(chosenFor) ? na : chosenFor.x) + close + 30)
plot((na(wrapped) ? na : wrapped.x) + close)
plot((na(cloned) ? na : cloned.x) + close)
plot((na(clonedOther) ? na : clonedOther.x) + close)
plot((na(clonedOtherNamed) ? na : clonedOtherNamed.x) + close)
plot((na(clonedAlias) ? na : clonedAlias.x) + close)
plot((na(clonedOtherAlias) ? na : clonedOtherAlias.x) + close)
plot((na(clonedOtherNamedAlias) ? na : clonedOtherNamedAlias.x) + close)
plot((na(clonedObjectAlias) ? na : clonedObjectAlias.x) + close)
plot((na(clonedOtherObjectAlias) ? na : clonedOtherObjectAlias.x) + close)
plot((na(clonedOtherNamedObjectAlias) ? na : clonedOtherNamedObjectAlias.x) + close)
plot((na(clonedViaMake) ? na : clonedViaMake.x) + close)
plot((na(clonedOtherViaMake) ? na : clonedOtherViaMake.x) + close)
plot((na(clonedOtherViaMakeNamed) ? na : clonedOtherViaMakeNamed.x) + close)
plot((na(clonedTernary) ? na : clonedTernary.x) + close)
plot((na(clonedOtherTernary) ? na : clonedOtherTernary.x) + close + 60)
plot((na(clonedSwitch) ? na : clonedSwitch.x) + close)
plot((na(clonedOtherSwitch) ? na : clonedOtherSwitch.x) + close + 70)
plot((na(clonedIf) ? na : clonedIf.x) + close)
plot((na(clonedOtherIf) ? na : clonedOtherIf.x) + close + 40)
plot((na(clonedFor) ? na : clonedFor.x) + close)
plot((na(clonedOtherFor) ? na : clonedOtherFor.x) + close + 50)
plot((na(made) ? na : made.x) + close)
plot((na(madeBlock) ? na : madeBlock.x) + close)
plot((na(madeNamed) ? na : madeNamed.x) + close)
plot((na(madeNamedBlock) ? na : madeNamedBlock.x) + close)
plot((na(madeTyped) ? na : madeTyped.x) + close)
plot((na(madeTypedFrom) ? na : madeTypedFrom.x) + close)
plot((na(madeTypedConstructed) ? na : madeTypedConstructed.x) + close)
plot((na(madeTypedConstructedFrom) ? na : madeTypedConstructedFrom.x) + close)
plot((na(madeTypedTernary) ? na : madeTypedTernary.x) + close)
plot((na(madeTypedTernaryFrom) ? na : madeTypedTernaryFrom.x) + close)
plot((na(madeTypedSwitch) ? na : madeTypedSwitch.x) + close)
plot((na(madeTypedSwitchFrom) ? na : madeTypedSwitchFrom.x) + close)
plot((na(madeTypedIfFrom) ? na : madeTypedIfFrom.x) + close)
plot((na(madeTypedForFrom) ? na : madeTypedForFrom.x) + close)
plot((na(madeTypedForInFrom) ? na : madeTypedForInFrom.x) + close)
plot((na(madeTypedWhileFrom) ? na : madeTypedWhileFrom.x) + close)
plot((na(wrappedMade) ? na : na(wrappedMade.point) ? na : wrappedMade.point.x) + close)
plot((na(wrappedMadeViaMethod) ? na : na(wrappedMadeViaMethod.point) ? na : wrappedMadeViaMethod.point.x) + close)
plot((na(wrappedSwitch) ? na : na(wrappedSwitch.point) ? na : wrappedSwitch.point.x) + close)
plot((na(wrappedKept) ? na : na(wrappedKept.point) ? na : wrappedKept.point.x) + close)
plot((na(wrappedKeptNested) ? na : na(wrappedKeptNested.point) ? na : wrappedKeptNested.point.x) + close)
plot((na(wrappedChosen) ? na : na(wrappedChosen.point) ? na : wrappedChosen.point.x) + close)
plot((na(mutatedLocal) ? na : mutatedLocal.x) + close)
plot((na(sameIf) ? na : sameIf.x) + close)
plot((na(sameFor) ? na : sameFor.x) + close)
plot((na(sameForIn) ? na : sameForIn.x) + close)
plot((na(sameWhile) ? na : sameWhile.x) + close)
plot((na(sameSwitch) ? na : sameSwitch.x) + close)
plot((na(chosenForIn) ? na : chosenForIn.x) + close + 95)
plot((na(chosenWhile) ? na : chosenWhile.x) + close + 80)
plot((na(chosenSwitch) ? na : chosenSwitch.x) + close + 90)
plot((na(samePrior) ? na : samePrior.x))
plot((na(sameSwitchPrior) ? na : sameSwitchPrior.x) + close)
plot((na(chosenForInPrior) ? na : chosenForInPrior.x) + close)
plot((na(clonedSwitchPrior) ? na : clonedSwitchPrior.x) + close)
plot((na(clonedOtherSwitchPrior) ? na : clonedOtherSwitchPrior.x) + close)
plot((na(madeTypedSwitchFromPrior) ? na : madeTypedSwitchFromPrior.x) + close)
plot((na(madeTypedForInFromPrior) ? na : madeTypedForInFromPrior.x) + close)
plot((na(madeTypedWhileFromPrior) ? na : madeTypedWhileFromPrior.x) + close)
plot((na(wrappedMadePrior) ? na : na(wrappedMadePrior.point) ? na : wrappedMadePrior.point.x) + close)
plot((na(wrappedSwitchPrior) ? na : na(wrappedSwitchPrior.point) ? na : wrappedSwitchPrior.point.x) + close)
plot((na(wrappedKeptPrior) ? na : na(wrappedKeptPrior.point) ? na : wrappedKeptPrior.point.x) + close)
plot((na(wrappedChosenPrior) ? na : na(wrappedChosenPrior.point) ? na : wrappedChosenPrior.point.x) + close)
plot(sameDynamicX)
plot(sameDynamicSiblingXAfterMutation)
plot(wrappedKeptDynamicX)
plot(wrappedKeptDynamicSiblingXAfterMutation)
plot(wrappedPointDynamicX)
plot(wrappedPointDynamicSiblingXAfterMutation)
