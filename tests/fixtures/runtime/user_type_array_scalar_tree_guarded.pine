//@version=5
indicator("User type array scalar tree")
type Point
    float x
    float y

type Wrapper
    Point inner
    float weight

type First
    float shared
    float other

type Second
    float other
    float shared

type ReturnAnchor
    int tag

return_identity(values) => values

array(values) => values

size(values) => array.size(values) + 9000

get(values, int index) => array.size(values) + index + 9100

first(values) => array.size(values) + 9200

last(values) => array.size(values) + 9300

copy(values) => array.from(First.new(9400.0, 94000.0))

return_block_alias(values) =>
    made = values
    made

return_copy(values) => values.copy()

return_fresh(value) => array.from(value)

return_rebuild(values) =>
    nested = return_identity(values)
    item = nested.get(0)
    array.from(item)

return_new_first() => array.new<First>(1, First.new(110.0, 1100.0))

return_empty_first() => array.new<First>()

return_none_first() =>
    array<First> values = na
    values

return_nested(values) => return_block_alias(return_identity(values))

return_named(values, bool use_copy, int tag) => use_copy ? values.copy() : values

return_final_if(values) =>
    if bar_index >= 0
        made = values.copy()
        made
    else
        values

method returnFirst(ReturnAnchor self, array<First> values) => return_nested(values)

method returnSecond(ReturnAnchor self, Second[] values) =>
    made = values.copy()
    made

method returnInts(ReturnAnchor self, array<int> values) => return_identity(values)

method first(ReturnAnchor self, array<First> values) => array.size(values) + 700

method copy(ReturnAnchor self, array<First> values) => array.from(First.new(999.0, 9990.0))

method size(ReturnAnchor self, array<First> values) => array.size(values) + 900

method get(ReturnAnchor self, array<First> values, int index) => array.size(values) + index + 901

method last(ReturnAnchor self, array<First> values) => array.size(values) + 902

method retain(First self, array<First> values) => values

method retain(Second self, array<Second> values) => values

method size(First self) => (na(self) ? na : self.shared) + 1000.0

method get(First self, int index) => (na(self) ? na : self.shared) + index + 2000.0

method last(First self) => (na(self) ? na : self.shared) + 3000.0

method first(First self) => (na(self) ? na : self.shared) + 4000.0

method copy(First self) => (na(self) ? na : self.shared) + 5000.0

method size(Second self) => (na(self) ? na : self.shared) + 10000.0

method get(Second self, int index) => (na(self) ? na : self.shared) + index + 20000.0

method first(Second self) => (na(self) ? na : self.shared) + 30000.0

method last(Second self) => (na(self) ? na : self.shared) + 40000.0

method copy(Second self) => (na(self) ? na : self.shared) + 50000.0

method returnEmptyFirst(ReturnAnchor self) => array.new<First>()

method returnNoneFirst(ReturnAnchor self) =>
    array<First> values = na
    values

method returnStatic(First self, array<First> values) => return_nested(values)

readPostfix(receiver, values) =>
    item = receiver.retain(values).copy().first()
    (na(item) ? na : item.shared)

readAccessors(receiver, values) =>
    head = receiver.retain(values).get(index=0)
    tail = receiver.retain(values).last()
    receiver.retain(values).size() + (na(head) ? na : head.shared) + (na(tail) ? na : tail.shared)

readUnqualifiedArray(values) =>
    head = return_nested(values).get(index=0)
    first_item = return_nested(values).first()
    tail = return_nested(values).copy().last()
    return_nested(values).size() + (na(head) ? na : head.shared) + (na(first_item) ? na : first_item.shared) + (na(tail) ? na : tail.shared) + return_nested(values).copy().size()

readUnqualifiedScalarArray(values) =>
    head = return_identity(values).get(index=0)
    first_item = return_identity(values).first()
    tail = return_identity(values).copy().last()
    return_identity(values).size() + head + first_item + tail + return_identity(values).copy().size()

readUnqualifiedScalar(value) =>
    return_identity(value).size() + return_identity(value).get(index=1) + return_identity(value).first() + return_identity(value).last() + return_identity(value).copy()

sum_udt_values(values) =>
    float total = 0.0
    for item in values
        total := total + (na(item) ? na : item.shared)
    total

sum_indexed_udt_values(values) =>
    float total = 0.0
    for index, item in values
        total := total + index + (na(item) ? na : item.shared)
    total

sum_aliased_udt_values(values) =>
    source = values
    float total = 0.0
    for item in source
        total := total + (na(item) ? na : item.shared)
    total

sum_nested_udt_values(values) =>
    float total = 0.0
    for item in return_identity(values)
        total := total + (na(item) ? na : item.shared)
    total

last_indexed_udt_value(values) =>
    for index, item in values
        (na(item) ? na : item.shared) + index

last_udt_value(values) =>
    for item in values
        item

rebuild_last_udt_array(values) =>
    for item in values
        array.from(item)

method sumFirstIndexed(ReturnAnchor self, array<First> values) =>
    float total = 0.0
    for index, item in values
        total := total + index + (na(item) ? na : item.shared)
    total

method sumSecondValues(ReturnAnchor self, Second[] values) =>
    float total = 0.0
    for item in values
        total := total + (na(item) ? na : item.shared)
    total

method lastFirstIndexed(ReturnAnchor self, array<First> values) =>
    for index, item in values
        (na(item) ? na : item.shared) + index

method lastSecondValue(ReturnAnchor self, Second[] values) =>
    for item in values
        item

read_flow_shared(values) =>
    selected = bar_index >= 0 ? array.copy(values) : na
    item = array.first(selected)
    (na(item) ? na : item.shared)

read_flow_shared_method(values) =>
    selected = if bar_index >= 0
        made = values.copy()
        made
    else
        na
    item = selected.last()
    (na(item) ? na : item.shared)

rebuild_flow_shared(value) =>
    alias = value
    rebuilt = array.from(bar_index >= 0 ? alias : na, bar_index < 0 ? na : na)
    item = array.get(rebuilt, 0)
    (na(item) ? na : item.shared)

array<Wrapper> declared = na
declared := array.new<Wrapper>()
declared.push(Wrapper.new(Point.new(close, open), high))

Wrapper[] inferred = array.from(Wrapper.new(Point.new(high, low), close))
seeded = array.new<Wrapper>(1, Wrapper.new(Point.new(open, close), low))

declared_value = declared.get(0)
inferred_value = array.get(inferred, 0)
seeded_value = seeded.get(0)
prior_inferred = inferred_value[1]

plot((na(declared_value) ? na : na(declared_value.inner) ? na : declared_value.inner.x))
plot((na(inferred_value) ? na : na(inferred_value.inner) ? na : inferred_value.inner.x))
plot((na(inferred_value) ? na : na(inferred_value.inner) ? na : inferred_value.inner.y))
plot((na(seeded_value) ? na : na(seeded_value.inner) ? na : seeded_value.inner.y))
plot((na(prior_inferred) ? na : na(prior_inferred.inner) ? na : prior_inferred.inner.x))
plot(declared.size() + inferred.size() + seeded.size())

flow_left = array.new<Wrapper>(1, Wrapper.new(Point.new(close + 10, open + 20), 100.0))
flow_right = array.from(Wrapper.new(Point.new(high + 30, low + 40), 200.0))

flow_ternary = bar_index % 2 == 0 ? flow_left : flow_right
flow_nullable = bar_index % 2 == 0 ? flow_left : na

flow_if = if bar_index % 2 == 0
    made = flow_left.copy()
    made
else
    made = flow_right.copy()
    made

flow_switch = switch bar_index % 2
    0 =>
        made = flow_left.copy()
        made
    =>
        made = flow_right.copy()
        made

flow_for = for i = 0 to 0
    made = flow_left.copy()
    made

flow_for_in = for item in array.from(0)
    made = flow_right.copy()
    made

int flow_iterations = 0
flow_while = while flow_iterations < 1
    flow_iterations := flow_iterations + 1
    made = flow_right.copy()
    made

array<Wrapper> flow_typed = if bar_index % 2 == 0
    flow_left
else
    flow_right

flow_ternary_value = flow_ternary.get(0)
flow_if_value = flow_if.get(0)
flow_switch_value = flow_switch.get(0)
flow_for_value = flow_for.get(0)
flow_for_in_value = flow_for_in.get(0)
flow_while_value = flow_while.get(0)
flow_typed_value = flow_typed.get(0)
flow_history_value = array.get(flow_ternary[1], 0)

plot((na(flow_ternary_value) ? na : flow_ternary_value.weight))
plot(nz(flow_nullable.size(), -1))
plot((na(flow_if_value) ? na : na(flow_if_value.inner) ? na : flow_if_value.inner.x))
plot((na(flow_switch_value) ? na : na(flow_switch_value.inner) ? na : flow_switch_value.inner.y))
plot((na(flow_for_value) ? na : flow_for_value.weight))
plot((na(flow_for_in_value) ? na : flow_for_in_value.weight))
plot((na(flow_while_value) ? na : flow_while_value.weight))
plot((na(flow_typed_value) ? na : flow_typed_value.weight))
plot((na(flow_history_value) ? na : flow_history_value.weight))

first_layout = array.from(First.new(10.0, 100.0))
second_layout = array.from(Second.new(200.0, 20.0))
plot(read_flow_shared(first_layout))
plot(read_flow_shared(second_layout))
plot(read_flow_shared_method(first_layout))
plot(read_flow_shared_method(second_layout))
plot(rebuild_flow_shared(First.new(30.0, 300.0)))
plot(rebuild_flow_shared(Second.new(400.0, 40.0)))

return_first_source = array.from(First.new(60.0, 600.0))
return_second_source = array.from(Second.new(700.0, 70.0))
return_first_once = return_nested(return_first_source)
return_second_once = return_nested(return_second_source)
return_first_again = return_nested(return_first_source)
return_first_value = array.get(return_first_once, 0)
return_second_value = array.get(return_second_once, 0)
return_first_again_value = array.get(return_first_again, 0)
plot((na(return_first_value) ? na : return_first_value.shared))
plot((na(return_second_value) ? na : return_second_value.shared))
plot((na(return_first_again_value) ? na : return_first_again_value.shared))

return_named_first = return_named(tag=1, values=return_first_source, use_copy=true)
return_if_second = return_final_if(return_second_source)
return_anchor = ReturnAnchor.new(1)
return_method_first = return_anchor.returnFirst(return_first_source)
return_method_second = return_anchor.returnSecond(values=return_second_source)
return_named_first_value = array.get(return_named_first, 0)
return_if_second_value = array.get(return_if_second, 0)
return_method_first_value = array.get(return_method_first, 0)
return_method_second_value = array.get(return_method_second, 0)
plot((na(return_named_first_value) ? na : return_named_first_value.shared) + (na(return_if_second_value) ? na : return_if_second_value.shared) + (na(return_method_first_value) ? na : return_method_first_value.shared) + (na(return_method_second_value) ? na : return_method_second_value.shared))

return_identity_source = array.from(First.new(80.0, 800.0))
return_identity_alias = return_identity(return_identity_source)
return_identity_alias.push(First.new(81.0, 810.0))
plot(return_identity_source.size() * 10 + return_identity_alias.size())

return_copy_source = array.from(First.new(90.0, 900.0))
return_copy_result = return_copy(return_copy_source)
return_copy_result.push(First.new(91.0, 910.0))
plot(return_copy_source.size() * 10 + return_copy_result.size())

return_fresh_value = First.new(100.0, 1000.0)
return_fresh_first = return_fresh(return_fresh_value)
return_fresh_second = return_fresh(return_fresh_value)
return_fresh_first.push(First.new(101.0, 1010.0))
plot(return_fresh_first.size() * 10 + return_fresh_second.size())

return_rebuilt_first_once = return_rebuild(return_first_source)
return_rebuilt_second = return_rebuild(return_second_source)
return_rebuilt_first_again = return_rebuild(return_first_source)
plot(array.join(return_rebuilt_first_once, "|") == "First(60, 600)" ? 1 : 0)
plot(array.join(return_rebuilt_second, "|") == "Second(700, 70)" ? 1 : 0)
plot(array.join(return_rebuilt_first_again, "|") == "First(60, 600)" ? 1 : 0)

return_new_first_result = return_new_first()
plot(array.join(return_new_first_result, "|") == "First(110, 1100)" ? 1 : 0)

return_method_copy_result = return_anchor.copy(return_first_source)
plot(array.join(return_method_copy_result, "|") == "First(999, 9990)" ? 1 : 0)

postfix_method_first = return_anchor.returnFirst(return_first_source).first()
postfix_method_second = return_anchor.returnSecond(return_second_source).first()
postfix_method_first_again = return_anchor.returnFirst(return_first_source).first()
postfix_copy_first = return_anchor.returnFirst(return_first_source).copy().first()
postfix_copy_second = return_anchor.returnSecond(return_second_source).copy().first()
postfix_copy_first_again = return_anchor.returnFirst(return_first_source).copy().first()
postfix_method_qualified = ReturnAnchor.returnFirst(return_anchor, return_first_source).copy().first()
postfix_method_named = return_anchor.returnSecond(values=return_second_source).copy().first()
plot((na(postfix_method_first) ? na : postfix_method_first.shared))
plot((na(postfix_method_second) ? na : postfix_method_second.shared))
plot((na(postfix_method_first_again) ? na : postfix_method_first_again.shared))
plot((na(postfix_copy_first) ? na : postfix_copy_first.shared))
plot((na(postfix_copy_second) ? na : postfix_copy_second.shared))
plot((na(postfix_copy_first_again) ? na : postfix_copy_first_again.shared))
plot((na(postfix_method_qualified) ? na : postfix_method_qualified.shared))
plot((na(postfix_method_named) ? na : postfix_method_named.shared))

wrapped_postfix_first = readPostfix(First.new(1.0, 10.0), return_first_source)
wrapped_postfix_second = readPostfix(Second.new(20.0, 2.0), return_second_source)
wrapped_postfix_first_again = readPostfix(First.new(3.0, 30.0), return_first_source)
plot(wrapped_postfix_first)
plot(wrapped_postfix_second)
plot(wrapped_postfix_first_again)

access_first_values = array.from(First.new(160.0, 1600.0), First.new(161.0, 1610.0))
access_second_values = array.from(Second.new(1700.0, 170.0), Second.new(1710.0, 171.0))
postfix_size_first = return_anchor.returnFirst(access_first_values).size()
postfix_size_second = return_anchor.returnSecond(access_second_values).size()
postfix_size_first_again = return_anchor.returnFirst(access_first_values).size()
postfix_get_first = return_anchor.returnFirst(access_first_values).get(index=0)
postfix_get_second = return_anchor.returnSecond(access_second_values).get(0)
postfix_get_first_again = return_anchor.returnFirst(access_first_values).get(0)
postfix_last_first = return_anchor.returnFirst(access_first_values).last()
postfix_last_second = return_anchor.returnSecond(access_second_values).last()
postfix_last_first_again = return_anchor.returnFirst(access_first_values).last()
postfix_copy_get = return_anchor.returnFirst(access_first_values).copy().get(index=1)
postfix_copy_last = return_anchor.returnSecond(access_second_values).copy().last()
postfix_access_qualified = ReturnAnchor.returnFirst(return_anchor, access_first_values).get(index=1)
postfix_access_named = return_anchor.returnSecond(values=access_second_values).last()
postfix_includes_first = return_anchor.returnFirst(access_first_values).includes(First.new(160.0, 1600.0))
postfix_includes_second = return_anchor.returnSecond(access_second_values).includes(Second.new(1710.0, 171.0))
postfix_includes_first_again = return_anchor.returnFirst(access_first_values).copy().includes(First.new(161.0, 1610.0))
postfix_indexof_first = return_anchor.returnFirst(access_first_values).indexof(First.new(160.0, 1600.0))
postfix_indexof_second = return_anchor.returnSecond(access_second_values).indexof(Second.new(1710.0, 171.0))
postfix_indexof_first_again = return_anchor.returnFirst(access_first_values).copy().indexof(First.new(161.0, 1610.0))
postfix_lastindexof_first = return_anchor.returnFirst(access_first_values).lastindexof(First.new(160.0, 1600.0))
postfix_lastindexof_second = return_anchor.returnSecond(access_second_values).lastindexof(Second.new(1710.0, 171.0))
postfix_lastindexof_first_again = return_anchor.returnFirst(access_first_values).copy().lastindexof(First.new(161.0, 1610.0))
postfix_lastindexof_duplicate = return_anchor.returnFirst(array.from(First.new(160.0, 1600.0), First.new(161.0, 1610.0), First.new(160.0, 1600.0))).lastindexof(First.new(160.0, 1600.0))
plot(postfix_size_first)
plot(postfix_size_second)
plot(postfix_size_first_again)
plot((na(postfix_get_first) ? na : postfix_get_first.shared))
plot((na(postfix_get_second) ? na : postfix_get_second.shared))
plot((na(postfix_get_first_again) ? na : postfix_get_first_again.shared))
plot((na(postfix_last_first) ? na : postfix_last_first.shared))
plot((na(postfix_last_second) ? na : postfix_last_second.shared))
plot((na(postfix_last_first_again) ? na : postfix_last_first_again.shared))
plot((na(postfix_copy_get) ? na : postfix_copy_get.shared))
plot((na(postfix_copy_last) ? na : postfix_copy_last.shared))
plot((na(postfix_access_qualified) ? na : postfix_access_qualified.shared))
plot((na(postfix_access_named) ? na : postfix_access_named.shared))
plot(postfix_includes_first and postfix_includes_second and postfix_includes_first_again ? 1 : 0)
plot(postfix_indexof_first == 0 and postfix_indexof_second == 1 and postfix_indexof_first_again == 1 ? 1 : 0)
plot(postfix_lastindexof_first == 0 and postfix_lastindexof_second == 1 and postfix_lastindexof_first_again == 1 and postfix_lastindexof_duplicate == 2 ? 1 : 0)

wrapped_access_first = readAccessors(First.new(1.0, 10.0), access_first_values)
wrapped_access_second = readAccessors(Second.new(20.0, 2.0), access_second_values)
wrapped_access_first_again = readAccessors(First.new(3.0, 30.0), access_first_values)
plot(wrapped_access_first)
plot(wrapped_access_second)
plot(wrapped_access_first_again)

explicit_method_size = return_anchor.size(return_anchor.returnFirst(access_first_values))
explicit_method_get = ReturnAnchor.get(return_anchor, return_anchor.returnFirst(access_first_values), 0)
explicit_method_last = return_anchor.last(access_first_values)
scalar_result_size = First.new(2.0, 20.0).size()
scalar_result_get = First.new(3.0, 30.0).get(index=1)
scalar_result_last = First.new(4.0, 40.0).last()
plot(explicit_method_size)
plot(explicit_method_get)
plot(explicit_method_last)
plot(scalar_result_size)
plot(scalar_result_get)
plot(scalar_result_last)

empty_result_size = return_anchor.returnEmptyFirst().size()
empty_result_last = return_anchor.returnEmptyFirst().last()
none_result_size = return_anchor.returnNoneFirst().size()
none_result_get = return_anchor.returnNoneFirst().get(0)
none_result_last = return_anchor.returnNoneFirst().last()
none_copy_last = return_anchor.returnNoneFirst().copy().last()
empty_result_includes = return_anchor.returnEmptyFirst().includes(First.new(0.0, 0.0))
none_result_includes = return_anchor.returnNoneFirst().copy().includes(First.new(0.0, 0.0))
empty_result_indexof = return_anchor.returnEmptyFirst().indexof(First.new(0.0, 0.0))
none_result_indexof = return_anchor.returnNoneFirst().copy().indexof(First.new(0.0, 0.0))
empty_result_lastindexof = return_anchor.returnEmptyFirst().lastindexof(First.new(0.0, 0.0))
none_result_lastindexof = return_anchor.returnNoneFirst().copy().lastindexof(First.new(0.0, 0.0))
na_index_get = return_anchor.returnFirst(access_first_values).get(na)
negative_index_get = return_anchor.returnFirst(access_first_values).get(-1)
plot(empty_result_size)
plot(na(empty_result_last) ? 1 : 0)
plot(na(none_result_size) and na(none_result_get) and na(none_result_last) and na(none_copy_last) ? 1 : 0)
plot(not empty_result_includes ? 1 : 0)
plot(na(none_result_includes) ? 1 : 0)
plot(empty_result_indexof == -1 ? 1 : 0)
plot(none_result_indexof == -1 ? 1 : 0)
plot(empty_result_lastindexof == -1 ? 1 : 0)
plot(none_result_lastindexof == -1 ? 1 : 0)
plot(na(na_index_get) ? 1 : 0)
plot((na(negative_index_get) ? na : negative_index_get.shared))

unqualified_size_first = return_nested(access_first_values).size()
unqualified_size_second = return_nested(access_second_values).size()
unqualified_size_first_again = return_nested(access_first_values).size()
unqualified_get_first = return_nested(access_first_values).get(index=0)
unqualified_get_second = return_nested(access_second_values).get(0)
unqualified_get_first_again = return_nested(access_first_values).get(0)
unqualified_first_item = return_nested(access_first_values).first()
unqualified_last_item = return_nested(access_second_values).last()
unqualified_copy_get = return_nested(access_first_values).copy().get(index=1)
unqualified_named_get = return_named(tag=3, values=access_first_values, use_copy=true).get(index=1)
unqualified_builtin_named_last = array(access_first_values).copy().last()
unqualified_includes_first = return_nested(access_first_values).includes(First.new(160.0, 1600.0))
unqualified_includes_second = return_nested(access_second_values).copy().includes(Second.new(1710.0, 171.0))
unqualified_includes_first_again = return_nested(access_first_values).includes(First.new(161.0, 1610.0))
unqualified_indexof_first = return_nested(access_first_values).indexof(First.new(160.0, 1600.0))
unqualified_indexof_second = return_nested(access_second_values).copy().indexof(Second.new(1710.0, 171.0))
unqualified_indexof_first_again = return_nested(access_first_values).indexof(First.new(161.0, 1610.0))
unqualified_lastindexof_first = return_nested(access_first_values).lastindexof(First.new(160.0, 1600.0))
unqualified_lastindexof_second = return_nested(access_second_values).copy().lastindexof(Second.new(1710.0, 171.0))
unqualified_lastindexof_first_again = return_nested(access_first_values).lastindexof(First.new(161.0, 1610.0))
plot(unqualified_size_first)
plot(unqualified_size_second)
plot(unqualified_size_first_again)
plot((na(unqualified_get_first) ? na : unqualified_get_first.shared))
plot((na(unqualified_get_second) ? na : unqualified_get_second.shared))
plot((na(unqualified_get_first_again) ? na : unqualified_get_first_again.shared))
plot((na(unqualified_first_item) ? na : unqualified_first_item.shared))
plot((na(unqualified_last_item) ? na : unqualified_last_item.shared))
plot((na(unqualified_copy_get) ? na : unqualified_copy_get.shared))
plot((na(unqualified_named_get) ? na : unqualified_named_get.shared))
plot((na(unqualified_builtin_named_last) ? na : unqualified_builtin_named_last.shared))
plot(unqualified_includes_first and unqualified_includes_second and unqualified_includes_first_again ? 1 : 0)
plot(unqualified_indexof_first == 0 and unqualified_indexof_second == 1 and unqualified_indexof_first_again == 1 ? 1 : 0)
plot(unqualified_lastindexof_first == 0 and unqualified_lastindexof_second == 1 and unqualified_lastindexof_first_again == 1 ? 1 : 0)

