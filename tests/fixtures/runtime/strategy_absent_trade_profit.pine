//@version=6
strategy("Absent closed trade profit", initial_capital=10000)
if bar_index == 0
    strategy.entry("L", strategy.long, qty=1)
if bar_index == 2
    strategy.close_all()
plot(strategy.closedtrades.profit(0))
plot(strategy.closedtrades.profit(-1))
plot(strategy.closedtrades.profit(9999))
plot(strategy.closedtrades.entry_price(9999))
plot(strategy.closedtrades.profit(int(na)))
