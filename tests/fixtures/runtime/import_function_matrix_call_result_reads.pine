plot(right.exposeIntMatrixFunction().submatrix().get(0, 1), "submatrix_int")
plot(right.exposeColorMatrixFunction().submatrix().get(0, 0) == color.red ? 1 : 0, "submatrix_color")
plot(left.exposeEmptyMatrixFunction().submatrix().rows() * 100 + left.exposeEmptyMatrixFunction().submatrix().columns() * 10 + left.exposeEmptyMatrixFunction().submatrix().elements_count(), "submatrix_empty_shape")
plot(na(left.exposeMatrixFunction().inv().rows()) ? 1 : 0, "inv_singular_na")
plot(na(left.exposeMatrixFunction().inv().inv().rows()) ? 1 : 0, "inv_chain_na")
plot(na(right.exposeMatrixFunctionBlock().copy().inv().submatrix().rows()) ? 1 : 0, "inv_nested_na")
plot(left.exposeMatrixFunction().pinv().rows(), "pinv_rows")
plot(left.exposeMatrixFunction().pinv().columns(), "pinv_columns")
plot(left.exposeMatrixFunction().pinv().get(0, 1), "pinv_singular_get")
plot(left.exposeMatrixFunction().pinv().pinv().get(1, 0), "pinv_chain_get")
plot(right.exposeIntMatrixFunction().pinv().rows() * 100 + right.exposeIntMatrixFunction().pinv().columns() * 10, "pinv_int_shape")
plot(left.exposeEmptyMatrixFunction().pinv().rows() * 100 + left.exposeEmptyMatrixFunction().pinv().columns() * 10 + left.exposeEmptyMatrixFunction().pinv().elements_count(), "pinv_empty_shape")
plot(right.exposeMatrixFunctionBlock().copy().pinv().transpose().get(0, 0), "pinv_nested_get")
plot(left.exposeMatrixFunction().eigenvectors().rows(), "eigenvectors_rows")
plot(left.exposeMatrixFunction().eigenvectors().columns(), "eigenvectors_columns")
plot(left.exposeMatrixFunction().eigenvectors().get(0, 0), "eigenvectors_get")
plot(left.exposeMatrixFunction().eigenvectors().eigenvectors().get(1, 1), "eigenvectors_chain_get")
plot(right.exposeMatrixFunctionBlock().copy().eigenvectors().pinv().get(0, 0), "eigenvectors_nested_get")
plot(left.exposeMatrixFunction().pow(2).rows(), "pow_rows")
plot(left.exposeMatrixFunction().pow(2).columns(), "pow_columns")
plot(left.exposeMatrixFunction().pow(2).get(0, 0), "pow_get")
plot(left.exposeMatrixFunction().pow(2).pow(2).get(1, 1), "pow_chain_get")
plot(left.exposeMatrixFunction().pow(0).get(0, 0), "pow_identity_get")
plot(right.exposeMatrixFunctionBlock().copy().pow(2).pinv().get(0, 0), "pow_nested_get")
kron_other = matrix.new<float>(1, 1, 2.0)
kron_chain_copy = left.exposeMatrixFunction().kron(kron_other)
kron_chain_copy.set(0, 0, 780.0)
plot(left.exposeMatrixFunction().kron(kron_other).rows(), "kron_rows")
plot(left.exposeMatrixFunction().kron(kron_other).columns(), "kron_columns")
plot(left.exposeMatrixFunction().kron(kron_other).get(0, 1), "kron_get")
plot(left.exposeMatrixFunction().kron(kron_other).kron(kron_other).get(1, 1), "kron_chain_get")
plot(right.exposeIntMatrixFunction().kron(matrix.new<int>(1, 1, 3)).get(0, 0), "kron_int")
plot(left.exposeEmptyMatrixFunction().kron(kron_other).rows() * 100 + left.exposeEmptyMatrixFunction().kron(kron_other).columns() * 10 + left.exposeEmptyMatrixFunction().kron(kron_other).elements_count(), "kron_empty_shape")
plot(right.exposeMatrixFunctionBlock().copy().kron(kron_other).pinv().get(0, 0), "kron_nested_get")
plot(kron_chain_copy.get(0, 0), "kron_mutation")
plot(source.get(0, 0), "kron_source_unchanged")
diff_chain_copy = left.exposeMatrixFunction().diff(1.0)
diff_chain_copy.set(0, 0, 784.0)
plot(left.exposeMatrixFunction().diff(1.0).rows(), "diff_rows")
plot(left.exposeMatrixFunction().diff(1.0).columns(), "diff_columns")
plot(left.exposeMatrixFunction().diff(1.0).get(0, 1), "diff_get")
plot(left.exposeMatrixFunction().diff(1.0).diff(2.0).get(1, 1), "diff_chain_get")
plot(right.exposeIntMatrixFunction().diff(2).get(0, 0), "diff_int")
plot(na(left.exposeMatrixFunction().diff(na).get(0, 0)) ? 1 : 0, "diff_scalar_na")
plot(left.exposeEmptyMatrixFunction().diff(1.0).rows() * 100 + left.exposeEmptyMatrixFunction().diff(1.0).columns() * 10 + left.exposeEmptyMatrixFunction().diff(1.0).elements_count(), "diff_empty_shape")
plot(right.exposeMatrixFunctionBlock().copy().diff(1.0).kron(kron_other).get(0, 0), "diff_nested_get")
plot(diff_chain_copy.get(0, 0), "diff_mutation")
plot(source.get(0, 0), "diff_source_unchanged")
mult_chain_copy = left.exposeMatrixFunction().mult(2.0)
mult_chain_copy.set(0, 0, 789.0)
mult_array_chain_copy = left.exposeMatrixFunction().mult(array.from(1.0, 2.0))
mult_array_chain_copy.set(0, 790.0)
plot(left.exposeMatrixFunction().mult(2.0).rows(), "mult_rows")
plot(left.exposeMatrixFunction().mult(2.0).columns(), "mult_columns")
plot(left.exposeMatrixFunction().mult(2.0).get(0, 1), "mult_scalar_get")
plot(left.exposeMatrixFunction().mult(matrix.new<float>(2, 1, 1.0)).get(1, 0), "mult_matrix_get")
plot(left.exposeMatrixFunction().mult(array.from(1.0, 2.0)).copy().get(1), "mult_array_get")
plot(left.exposeMatrixFunction().mult(2.0).mult(0.5).get(1, 1), "mult_chain_get")
plot(right.exposeIntMatrixFunction().mult(matrix.new<int>(2, 1, 3)).get(0, 0), "mult_int")
plot(na(left.exposeMatrixFunction().mult(na).get(0, 0)) ? 1 : 0, "mult_scalar_na")
plot(left.exposeEmptyMatrixFunction().mult(2.0).rows() * 100 + left.exposeEmptyMatrixFunction().mult(2.0).columns() * 10 + left.exposeEmptyMatrixFunction().mult(2.0).elements_count(), "mult_empty_shape")
plot(left.exposeEmptyMatrixFunction().mult(array.from(1.0, 1.0, 1.0)).size(), "mult_empty_array_size")
plot(right.exposeMatrixFunctionBlock().copy().mult(2.0).diff(1.0).get(0, 0), "mult_nested_get")
plot(mult_chain_copy.get(0, 0), "mult_mutation")
plot(mult_array_chain_copy.get(0), "mult_array_mutation")
plot(source.get(0, 0), "mult_source_unchanged")
plot(left.exposeMatrixFunction().mult(array.from(1.0, 2.0)).get(0), "mult_array_source_unchanged")
left.exposeMatrixFunction().set(0, 0, 114.0)
right.exposeIntMatrixFunction().set(0, 0, 114)
left.exposeBoolMatrixFunction().set(0, 0, false)
right.exposeStringMatrixFunction().set(0, 0, "set")
left.exposeColorMatrixFunction().set(0, 0, color.blue)
plot(1, "call_result_set_fresh_kinds")
left.exposeMatrixFunction().fill(314.0)
right.exposeIntMatrixFunction().fill(314)
left.exposeBoolMatrixFunction().fill(false)
right.exposeStringMatrixFunction().fill("fill")
left.exposeColorMatrixFunction().fill(color.blue)
plot(1, "call_result_fill_fresh_kinds")
