//@version=6
indicator("Supported bound matrix.kron call-result reads")

kronRows(left, right) => left.kron(right).copy().rows()

left = matrix.new<float>(2, 2, 1.5)
right = matrix.new<float>(1, 2, 2.0)
int_left = matrix.new<int>(1, 1, 2)
int_right = matrix.new<int>(1, 1, 3)

int direct_rows = left.kron(right).rows()
int direct_columns = left.kron(right).columns()
int direct_elements = left.kron(right).elements_count()
float direct_get = left.kron(right).get(row=1, column=3)
matrix<float> nested_copy = left.kron(right).copy()
float int_get = int_left.kron(int_right).get(0, 0)
array<float> direct_row = left.kron(right).row(1).copy()
array<float> direct_col = left.kron(right).col(1).copy()
array<float> direct_eigenvalues = left.kron(right).eigenvalues().copy()
bool direct_is_square = left.kron(right).is_square()
bool direct_is_zero = left.kron(right).is_zero()
bool direct_is_binary = left.kron(right).is_binary()
bool direct_is_diagonal = left.kron(right).is_diagonal()
bool direct_is_identity = left.kron(right).is_identity()
bool direct_is_symmetric = left.kron(right).is_symmetric()
bool direct_is_antisymmetric = left.kron(right).is_antisymmetric()
bool direct_is_stochastic = left.kron(right).is_stochastic()
float direct_sum = left.kron(right).avg()
float direct_avg = left.kron(right).avg()
float direct_min = left.kron(right).min()
float direct_max = left.kron(right).max()
float direct_mode = left.kron(right).mode()
float direct_trace = left.kron(right).trace()
float direct_det = left.kron(right).det()
int direct_rank = left.kron(right).rank()
int transposed_columns = left.kron(right).transpose().columns()
int sliced_rows = left.kron(right).submatrix().rows()
int inverted_rows = left.kron(right).inv().rows()
int pseudo_rows = left.kron(right).pinv().rows()
int vector_rows = left.kron(right).eigenvectors().rows()
int powered_rows = left.kron(right).pow(2).rows()
matrix<float> kron_other = matrix.new<float>(1, 1, 2.0)
int kron_rows = left.kron(right).kron(kron_other).rows()
float diff_get = left.kron(right).diff(1.0).get(0, 0)
float mult_get = left.kron(right).mult(2.0).get(0, 0)

plot(direct_rows + direct_columns + direct_elements + direct_get + nested_copy.get(0, 0) + int_get + direct_row.size() + direct_col.size() + direct_eigenvalues.size() + (direct_is_square ? 1 : 0) + (direct_is_zero ? 1 : 0) + (direct_is_binary ? 1 : 0) + (direct_is_diagonal ? 1 : 0) + (direct_is_identity ? 1 : 0) + (direct_is_symmetric ? 1 : 0) + (direct_is_antisymmetric ? 1 : 0) + (direct_is_stochastic ? 1 : 0) + direct_sum + direct_avg + direct_min + direct_max + direct_mode + direct_trace + direct_det + direct_rank + transposed_columns + kronRows(left, right))
plot(sliced_rows)
plot(inverted_rows)
plot(pseudo_rows)
plot(vector_rows)
plot(powered_rows)
plot(kron_rows)
plot(diff_get)
plot(mult_get)
left.kron(right).set(0, 0, 2.0)
left.kron(right).fill(2.0)
left.kron(right).reverse()
left.kron(right).reshape(1, 8)
left.kron(right).swap_rows(0, 1)
left.kron(right).swap_columns(0, 1)
left.kron(right).remove_row(0)
left.kron(right).remove_col(0)
left.kron(right).add_row(0, array.from(1.0))
left.kron(right).add_col(0, array.from(1.0))
left.kron(right).sort()
