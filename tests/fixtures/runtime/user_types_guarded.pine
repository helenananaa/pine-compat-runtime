if bar_index >= 0
    Point block_typed_switch = switch bar_index
        0 => Point.new(high + 165, low)
        1 => Point.new(high + 170, low)
        => Point.new(high + 175, low)
    block_typed_switch := switch bar_index
        3 => Point.new(high + 180, low)
        => Point.new(high + 185, low)
    plot((na(block_typed_switch) ? na : block_typed_switch.x) + (na(block_typed_switch) ? na : block_typed_switch.y))
if bar_index >= 0
    Point block_typed_for = for block_typed_for_i = 0 to 1
        Point.new(high + block_typed_for_i + 420, low)
    block_typed_for := for block_typed_for_j = 0 to 1
        Point.new(high + block_typed_for_j + 425, low)
    plot((na(block_typed_for) ? na : block_typed_for.x) + (na(block_typed_for) ? na : block_typed_for.y))
loop_typed_sum = close > 0 ? 0.0 : 0.0
for typed_i = 0 to 1
    Point loop_typed_point = na
    loop_typed_point := Point.new(high + typed_i, low)
    loop_typed_sum := loop_typed_sum + (na(loop_typed_point) ? na : loop_typed_point.x) + (na(loop_typed_point) ? na : loop_typed_point.y)
plot(loop_typed_sum)
loop_typed_constructed_sum = close > 0 ? 0.0 : 0.0
for typed_constructed_i = 0 to 1
    Point loop_typed_constructed = Point.new(high + typed_constructed_i + 70, low)
    loop_typed_constructed := Point.new(high + typed_constructed_i + 75, low)
    loop_typed_constructed_sum := loop_typed_constructed_sum + (na(loop_typed_constructed) ? na : loop_typed_constructed.x) + (na(loop_typed_constructed) ? na : loop_typed_constructed.y)
plot(loop_typed_constructed_sum)
loop_typed_ternary_sum = close > 0 ? 0.0 : 0.0
for typed_ternary_i = 0 to 1
    Point loop_typed_ternary = typed_ternary_i == 0 ? Point.new(high + typed_ternary_i + 190, low) : Point.new(high + typed_ternary_i + 195, low)
    loop_typed_ternary := typed_ternary_i == 1 ? Point.new(high + typed_ternary_i + 200, low) : Point.new(high + typed_ternary_i + 205, low)
    loop_typed_ternary_sum := loop_typed_ternary_sum + (na(loop_typed_ternary) ? na : loop_typed_ternary.x) + (na(loop_typed_ternary) ? na : loop_typed_ternary.y)
plot(loop_typed_ternary_sum)
loop_typed_if_sum = close > 0 ? 0.0 : 0.0
for typed_if_i = 0 to 1
    Point loop_typed_if = if typed_if_i == 0
        Point.new(high + typed_if_i + 310, low)
    else
        Point.new(high + typed_if_i + 315, low)
    loop_typed_if := if typed_if_i == 1
        Point.new(high + typed_if_i + 320, low)
    else
        Point.new(high + typed_if_i + 325, low)
    loop_typed_if_sum := loop_typed_if_sum + (na(loop_typed_if) ? na : loop_typed_if.x) + (na(loop_typed_if) ? na : loop_typed_if.y)
plot(loop_typed_if_sum)
loop_typed_switch_sum = close > 0 ? 0.0 : 0.0
for typed_switch_i = 0 to 1
    Point loop_typed_switch = switch typed_switch_i
        0 => Point.new(high + typed_switch_i + 230, low)
        => Point.new(high + typed_switch_i + 235, low)
    loop_typed_switch := switch typed_switch_i
        1 => Point.new(high + typed_switch_i + 240, low)
        => Point.new(high + typed_switch_i + 245, low)
