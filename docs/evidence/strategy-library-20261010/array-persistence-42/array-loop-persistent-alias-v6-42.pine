//@version=6
indicator("array-loop-persistent-alias-v6-42")
int x=0
int y=0
for i=0 to 1
    var a=array.new_int()
    var b=a
    a.push(1)
    b.push(2)
    x:=a.size()
    y:=b.size()
varip int xh=0
varip int yh=0
varip int ih=0
if barstate.ishistory
    xh:=x
    yh:=y
    ih:=bar_index
plot(xh)
plot(yh)
plot(ih)
