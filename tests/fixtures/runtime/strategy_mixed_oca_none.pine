//@version=5
strategy("Mixed OCA none keeps entry and order independent")
if bar_index == 1
    strategy.entry("E", strategy.long, qty=1, limit=3, oca_name="g", oca_type=strategy.oca.none)
    strategy.order("O", strategy.long, qty=1, limit=3, oca_name="g", oca_type=strategy.oca.none)
plot(strategy.position_size)
plot(strategy.opentrades)
plot(strategy.closedtrades)
