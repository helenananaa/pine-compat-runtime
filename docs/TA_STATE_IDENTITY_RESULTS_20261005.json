  "publicApiProbeSource": "//! Public-API behavior reproduction only; no timers or allocation counters.\n//! Compile the identical source against the sealed baseline and candidate.\nuse std::panic::{AssertUnwindSafe, catch_unwind};\nuse std::process::ExitCode;\n\nuse pine_ir::{CallSiteId, HirExprKind, HirStmtKind};\nuse pine_runtime::{Bar, HistoricalRuntime, PineValue, PreparedProgram};\n\nconst SOURCE: &str = \"//@version=6\\nindicator(\\\"shared rolling key\\\")\\nplot(ta.wma(close, 2))\\nplot(ta.wma(close, 2))\\nplot(ta.sma(close + 1.0, 2))\\nplot(ta.wma(close + 1.0, 2))\\nplot(ta.sma(close + 98.0, 2))\\n\";\nconst CALLEES: [&str; 5] = [\"ta.wma\", \"ta.wma\", \"ta.sma\", \"ta.wma\", \"ta.sma\"];\n\nfn quoted(text: &str) -> String {\n    let mut encoded = String::from(\"\\\"\");\n    for character in text.chars() {\n        match character {\n            '\\\\' => encoded.push_str(\"\\\\\\\\\"),\n            '\"' => encoded.push_str(\"\\\\\\\"\"),\n            '\\n' => encoded.push_str(\"\\\\n\"),\n            '\\r' => encoded.push_str(\"\\\\r\"),\n            '\\t' => encoded.push_str(\"\\\\t\"),\n            control if control.is_control() => {\n                encoded.push_str(&format!(\"\\\\u{:04x}\", u32::from(control)));\n            }\n            other => encoded.push(other),\n        }\n    }\n    encoded.push('\"');\n    encoded\n}\n\nfn typed(value: &PineValue) -> String {\n    match value {\n        PineValue::Float(value) => {\n            format!(\"{{\\\"type\\\":\\\"float\\\",\\\"bits\\\":\\\"{:016x}\\\"}}\", value.to_bits())\n        }\n        PineValue::Int(value) => format!(\"{{\\\"type\\\":\\\"int\\\",\\\"value\\\":{value}}}\"),\n        PineValue::Na => \"{\\\"type\\\":\\\"na\\\"}\".to_owned(),\n        other => format!(\"{{\\\"type\\\":\\\"unexpected\\\",\\\"debug\\\":{}}}\", quoted(&format!(\"{other:?}\"))),\n    }\n}\n\nfn main() -> ExitCode {\n    let source = pine_syntax::SourceFile::new(\"shared_key_probe.pine\", SOURCE);\n    let analysis = pine_sema::analyze_source(&source);\n    if !analysis.diagnostics.is_empty() {\n        eprintln!(\"fixture analysis failed: {:?}\", analysis.diagnostics);\n        return ExitCode::FAILURE;\n    }\n    let mut hir = analysis.hir.expect(\"successful analysis must produce HIR\");\n    let mut modified = 0;\n    let mut original_ids = Vec::new();\n    for statement in &mut hir.statements {\n        let HirStmtKind::Expr(expression) = &mut statement.kind else {\n            continue;\n        };\n        let HirExprKind::Call { callee, args, .. } = &mut expression.kind else {\n            continue;\n        };\n        if callee != \"plot\" {\n            continue;\n        }\n        let HirExprKind::Call { callee, call_site_id, .. } = &mut args[0].value.kind else {\n            panic!(\"fixture plot must directly wrap a TA call\");\n        };\n        assert_eq!(callee, CALLEES[modified]);\n        original_ids.push(call_site_id.0.to_string());\n        // Only these five identities change. In particular, preserve plot IDs,\n        // series metadata, next_call_site_id, arguments and statement order.\n        *call_site_id = CallSiteId(u32::MAX);\n        modified += 1;\n    }\n    assert_eq!(modified, 5);\n\n    let prepared = PreparedProgram::new(hir);\n    let mut runtime = HistoricalRuntime::from_prepared(&prepared);\n    let appended = catch_unwind(AssertUnwindSafe(|| {\n        runtime.append_bar(Bar {\n            time: 0,\n            open: 1.0,\n            high: 1.0,\n            low: 1.0,\n            close: 1.0,\n            volume: 1.0,\n        })\n    }));\n    let (outcome, detail) = match appended {\n        Ok(Ok(())) => (\"ok\", None),\n        Ok(Err(error)) => (\"runtime_error\", Some(error.message)),\n        Err(payload) => {\n            let message = payload.downcast_ref::<String>().cloned()\n                .or_else(|| payload.downcast_ref::<&str>().map(|value| (*value).to_owned()))\n                .unwrap_or_else(|| \"non-string panic payload\".to_owned());\n            (\"panic\", Some(message))\n        }\n    };\n    // Failed execution is inspected only, never retried. The default panic hook\n    // still writes the actual panic location to stderr. Each of the five plot\n    // positions is emitted, including a missing final plot after an unwind.\n    let result = runtime.result();\n    let plots: Vec<_> = (0..5).map(|index| {\n        let (present, values) = match result.plots.get(index) {\n            Some(plot) => (true, plot.values.iter().map(typed).collect::<Vec<_>>().join(\",\")),\n            None => (false, String::new()),\n        };\n        format!(\"{{\\\"position\\\":{index},\\\"callee\\\":{},\\\"present\\\":{present},\\\"values\\\":[{values}]}}\", quoted(CALLEES[index]))\n    }).collect();\n    println!(\"{{\\\"schema\\\":\\\"pine.shared-rolling-key-behavior.v1\\\",\\\"source\\\":{},\\\"modifiedTaCalls\\\":5,\\\"originalTaCallSiteIds\\\":[{}],\\\"sharedTaCallSiteId\\\":{},\\\"finiteBarsAttempted\\\":1,\\\"appendOutcome\\\":{},\\\"detail\\\":{},\\\"retainedPlotCount\\\":{},\\\"plots\\\":[{}]}}\",\n        quoted(SOURCE), original_ids.join(\",\"), u32::MAX, quoted(outcome),\n        detail.as_deref().map(quoted).unwrap_or_else(|| \"null\".to_owned()),\n        result.plots.len(), plots.join(\",\"));\n    if outcome == \"ok\" { ExitCode::SUCCESS } else { ExitCode::FAILURE }\n}\n"
}
