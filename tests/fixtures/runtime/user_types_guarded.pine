var Point typed_var_for_in = for value in typed_var_values
    Point.new(high + value + 450, low)
if bar_index == 2
    typed_var_for_in := Point.new(high + 455, low)
plot((na(typed_var_for_in) ? na : typed_var_for_in.x) + (na(typed_var_for_in) ? na : typed_var_for_in.y))
typed_var_while_i = 0
