//@version=6
indicator("User-method matrix call-result reads")

type Anchor
    int tag

method expose(Anchor self) => float_values

method exposeBlock(Anchor self) =>
    made = float_values.copy()
    made

method exposeInt(Anchor self) => matrix.new<int>(1, 2, 7)

method exposeBool(Anchor self) => matrix.new<bool>(1, 1, true)

method exposeString(Anchor self) => matrix.new<string>(1, 1, "pine")

method exposeColor(Anchor self) => matrix.new<color>(1, 1, color.red)

method exposeEmpty(Anchor self) => matrix.new<float>(0, 3)

method exposeIf(Anchor self, bool use_other) => use_other ? alternate : float_values.copy()

method exposeNested(Anchor self) => self.exposeBlock()

float_values = matrix.new<float>(2, 2, 0.0)
float_values.set(0, 0, 1.0)
float_values.set(0, 1, 2.0)
float_values.set(1, 0, 3.0)
float_values.set(1, 1, 4.0)
alternate = matrix.new<float>(2, 2, 8.0)

anchor = Anchor.new(1)
copied = anchor.expose().copy()
copied.set(0, 0, 99.0)
fresh_row = anchor.expose().row(0)
fresh_row.set(0, 77.0)
fresh_col = anchor.expose().col(0)
fresh_col.set(0, 66.0)
fresh_eigenvalues = anchor.expose().eigenvalues()
fresh_eigenvalues.set(0, 55.0)

plot(anchor.expose().rows(), "rows")
plot(anchor.expose().columns(), "columns")
plot(anchor.expose().elements_count(), "elements")
plot(anchor.expose().get(0, 1), "get")
plot(anchor.expose().copy().get(1, 1), "copy_chain")
plot(anchor.expose().row(1).first(), "row_float")
plot(anchor.exposeInt().row(0).last(), "row_int")
plot(anchor.exposeString().row(0).first() == "pine" ? 1 : 0, "row_string")
plot(anchor.exposeBool().row(0).first() ? 1 : 0, "row_bool")
plot(anchor.exposeColor().row(0).first() == color.red ? 1 : 0, "row_color")
plot(anchor.expose().row(0).copy().size(), "row_copy_size")
plot(float_values.get(0, 0), "row_source_independent")
plot(fresh_row.get(0), "row_copy_independent")
plot(anchor.expose().col(1).last(), "col_float")
plot(anchor.exposeInt().col(1).first(), "col_int")
plot(anchor.exposeString().col(0).first() == "pine" ? 1 : 0, "col_string")
plot(anchor.exposeBool().col(0).first() ? 1 : 0, "col_bool")
plot(anchor.exposeColor().col(0).first() == color.red ? 1 : 0, "col_color")
plot(anchor.expose().col(0).copy().size(), "col_copy_size")
plot(float_values.get(0, 0), "col_source_independent")
plot(fresh_col.get(0), "col_copy_independent")
plot(anchor.expose().eigenvalues().first(), "eigenvalues_float")
plot(anchor.expose().eigenvalues().copy().size(), "eigenvalues_copy_size")
plot(float_values.get(0, 0), "eigenvalues_source_independent")
plot(fresh_eigenvalues.get(0), "eigenvalues_copy_independent")
plot(anchor.expose().is_square() ? 1 : 0, "is_square_float")
plot(anchor.exposeString().is_square() ? 1 : 0, "is_square_string")
plot(anchor.expose().is_zero() ? 1 : 0, "is_zero_float")
plot(anchor.exposeInt().is_zero() ? 1 : 0, "is_zero_int")
plot(anchor.expose().is_binary() ? 1 : 0, "is_binary_float")
plot(anchor.exposeInt().is_binary() ? 1 : 0, "is_binary_int")
plot(anchor.expose().is_diagonal() ? 1 : 0, "is_diagonal_float")
plot(anchor.exposeInt().is_diagonal() ? 1 : 0, "is_diagonal_int")
plot(anchor.expose().is_identity() ? 1 : 0, "is_identity_float")
plot(anchor.exposeInt().is_identity() ? 1 : 0, "is_identity_int")
plot(anchor.expose().is_symmetric() ? 1 : 0, "is_symmetric_float")
plot(anchor.exposeInt().is_symmetric() ? 1 : 0, "is_symmetric_int")
plot(anchor.expose().is_antisymmetric() ? 1 : 0, "is_antisymmetric_float")
plot(anchor.exposeInt().is_antisymmetric() ? 1 : 0, "is_antisymmetric_int")
plot(anchor.expose().is_stochastic() ? 1 : 0, "is_stochastic_float")
plot(anchor.exposeInt().is_stochastic() ? 1 : 0, "is_stochastic_int")
plot(anchor.expose().avg(), "sum_float")
plot(anchor.exposeInt().avg(), "sum_int")
plot(anchor.expose().avg(), "avg_float")
plot(anchor.exposeInt().avg(), "avg_int")
plot(anchor.expose().min(), "min_float")
plot(anchor.exposeInt().min(), "min_int")
plot(anchor.expose().max(), "max_float")
plot(anchor.exposeInt().max(), "max_int")
plot(anchor.exposeIf(use_other=true).mode(), "mode_float")
plot(anchor.exposeInt().mode(), "mode_int")
plot(na(anchor.expose().mode()) ? 1 : 0, "mode_unique_is_na")
plot(anchor.expose().trace(), "trace_float")
plot(anchor.exposeInt().trace(), "trace_int")
plot(anchor.expose().det(), "det_float")
plot(anchor.expose().rank(), "rank_float")
plot(anchor.exposeInt().rank(), "rank_int")
plot(float_values.get(0, 0), "source_independent")
plot(copied.get(0, 0), "copy_independent")
plot(anchor.exposeInt().get(0, 1), "int")
plot(anchor.exposeString().get(0, 0) == "pine" ? 1 : 0, "string")
plot(anchor.exposeBool().get(0, 0) ? 1 : 0, "bool")
plot(anchor.exposeColor().get(0, 0) == color.red ? 1 : 0, "color")
plot(anchor.exposeEmpty().rows() * 100 + anchor.exposeEmpty().columns() * 10 + anchor.exposeEmpty().elements_count(), "empty")
plot(anchor.exposeBlock().get(1, 1), "block")
plot(anchor.exposeNested().get(1, 0), "nested")
plot(anchor.exposeIf(use_other=true).get(0, 0), "control_flow")
plot(Anchor.expose(anchor).get(0, 0), "qualified")
plot(Anchor.new(2).expose().get(1, 1), "constructor_receiver")
plot(anchor.expose().copy().copy().get(0, 1), "nested_copy")
plot(anchor.expose().transpose().rows(), "transpose_rows")
plot(anchor.expose().transpose().columns(), "transpose_columns")
plot(anchor.expose().transpose().get(1, 0), "transpose_get")
plot(anchor.expose().transpose().copy().transpose().get(0, 1), "transpose_copy_chain_get")
plot(anchor.exposeInt().transpose().get(1, 0), "transpose_int")
plot(anchor.exposeBool().transpose().get(0, 0) ? 1 : 0, "transpose_bool")
plot(anchor.expose().submatrix(0, 1, 0, 2).rows(), "submatrix_rows")
plot(anchor.expose().submatrix(0, 1, 0, 2).columns(), "submatrix_columns")
plot(anchor.expose().submatrix().get(1, 0), "submatrix_get")
plot(anchor.expose().transpose().submatrix().copy().get(1, 0), "submatrix_nested_get")
plot(anchor.exposeInt().submatrix().get(0, 1), "submatrix_int")
plot(anchor.exposeBool().submatrix().get(0, 0) ? 1 : 0, "submatrix_bool")
plot(anchor.exposeEmpty().submatrix().rows() * 100 + anchor.exposeEmpty().submatrix().columns() * 10 + anchor.exposeEmpty().submatrix().elements_count(), "submatrix_empty_shape")
plot(anchor.expose().inv().rows(), "inv_rows")
plot(anchor.expose().inv().columns(), "inv_columns")
plot(anchor.expose().inv().get(0, 1), "inv_get")
plot(anchor.expose().inv().inv().get(1, 0), "inv_chain_get")
plot(anchor.expose().copy().inv().submatrix().get(0, 0), "inv_nested_get")
plot(na(anchor.exposeIf(use_other=true).inv().rows()) ? 1 : 0, "inv_singular_na")
plot(anchor.expose().pinv().rows(), "pinv_rows")
plot(anchor.expose().pinv().columns(), "pinv_columns")
plot(anchor.expose().pinv().get(0, 1), "pinv_singular_get")
plot(anchor.expose().pinv().pinv().get(1, 0), "pinv_chain_get")
plot(anchor.exposeInt().pinv().rows() * 100 + anchor.exposeInt().pinv().columns() * 10, "pinv_int_shape")
plot(anchor.exposeEmpty().pinv().rows() * 100 + anchor.exposeEmpty().pinv().columns() * 10 + anchor.exposeEmpty().pinv().elements_count(), "pinv_empty_shape")
plot(anchor.expose().copy().pinv().transpose().get(0, 0), "pinv_nested_get")
plot(anchor.expose().eigenvectors().rows(), "eigenvectors_rows")
plot(anchor.expose().eigenvectors().columns(), "eigenvectors_columns")
plot(anchor.expose().eigenvectors().get(0, 0), "eigenvectors_get")
plot(anchor.expose().eigenvectors().eigenvectors().get(1, 1), "eigenvectors_chain_get")
plot(anchor.exposeIf(use_other=true).eigenvectors().get(0, 0), "eigenvectors_singular_get")
plot(anchor.expose().copy().eigenvectors().pinv().get(0, 0), "eigenvectors_nested_get")
plot(anchor.expose().pow(2).rows(), "pow_rows")
plot(anchor.expose().pow(2).columns(), "pow_columns")
plot(anchor.expose().pow(2).get(0, 0), "pow_get")
plot(anchor.expose().pow(2).pow(2).get(1, 1), "pow_chain_get")
plot(anchor.expose().pow(0).get(0, 0), "pow_identity_get")
plot(anchor.exposeIf(use_other=true).pow(2).get(0, 0), "pow_singular_get")
plot(anchor.expose().copy().pow(2).pinv().get(0, 0), "pow_nested_get")
kron_other = matrix.new<float>(1, 1, 2.0)
kron_chain_copy = anchor.expose().kron(kron_other)
kron_chain_copy.set(0, 0, 778.0)
plot(anchor.expose().kron(kron_other).rows(), "kron_rows")
plot(anchor.expose().kron(kron_other).columns(), "kron_columns")
plot(anchor.expose().kron(kron_other).get(0, 1), "kron_get")
plot(anchor.expose().kron(kron_other).kron(kron_other).get(1, 1), "kron_chain_get")
plot(anchor.exposeInt().kron(matrix.new<int>(1, 1, 3)).get(0, 0), "kron_int")
plot(anchor.exposeEmpty().kron(kron_other).rows() * 100 + anchor.exposeEmpty().kron(kron_other).columns() * 10 + anchor.exposeEmpty().kron(kron_other).elements_count(), "kron_empty_shape")
plot(anchor.expose().copy().kron(kron_other).pinv().get(0, 0), "kron_nested_get")
plot(kron_chain_copy.get(0, 0), "kron_mutation")
plot(anchor.expose().get(0, 0), "kron_source_unchanged")
diff_chain_copy = anchor.expose().diff(1.0)
diff_chain_copy.set(0, 0, 782.0)
plot(anchor.expose().diff(1.0).rows(), "diff_rows")
plot(anchor.expose().diff(1.0).columns(), "diff_columns")
plot(anchor.expose().diff(1.0).get(0, 1), "diff_get")
plot(anchor.expose().diff(1.0).diff(2.0).get(1, 1), "diff_chain_get")
plot(anchor.exposeInt().diff(2).get(0, 0), "diff_int")
plot(na(anchor.expose().diff(na).get(0, 0)) ? 1 : 0, "diff_scalar_na")
plot(anchor.exposeEmpty().diff(1.0).rows() * 100 + anchor.exposeEmpty().diff(1.0).columns() * 10 + anchor.exposeEmpty().diff(1.0).elements_count(), "diff_empty_shape")
plot(anchor.expose().copy().diff(1.0).kron(kron_other).get(0, 0), "diff_nested_get")
plot(diff_chain_copy.get(0, 0), "diff_mutation")
plot(anchor.expose().get(0, 0), "diff_source_unchanged")
mult_chain_copy = anchor.expose().mult(2.0)
mult_chain_copy.set(0, 0, 787.0)
mult_array_chain_copy = anchor.expose().mult(array.from(1.0, 2.0))
mult_array_chain_copy.set(0, 788.0)
plot(anchor.expose().mult(2.0).rows(), "mult_rows")
plot(anchor.expose().mult(2.0).columns(), "mult_columns")
plot(anchor.expose().mult(2.0).get(0, 1), "mult_scalar_get")
plot(anchor.expose().mult(matrix.new<float>(2, 1, 1.0)).get(1, 0), "mult_matrix_get")
plot(anchor.expose().mult(array.from(1.0, 2.0)).copy().get(1), "mult_array_get")
plot(anchor.expose().mult(2.0).mult(0.5).get(1, 1), "mult_chain_get")
plot(anchor.exposeInt().mult(matrix.new<int>(2, 1, 3)).get(0, 0), "mult_int")
plot(na(anchor.expose().mult(na).get(0, 0)) ? 1 : 0, "mult_scalar_na")
plot(anchor.exposeEmpty().mult(2.0).rows() * 100 + anchor.exposeEmpty().mult(2.0).columns() * 10 + anchor.exposeEmpty().mult(2.0).elements_count(), "mult_empty_shape")
plot(anchor.exposeEmpty().mult(array.from(1.0, 1.0, 1.0)).size(), "mult_empty_array_size")
plot(anchor.expose().copy().mult(2.0).diff(1.0).get(0, 0), "mult_nested_get")
plot(mult_chain_copy.get(0, 0), "mult_mutation")
plot(mult_array_chain_copy.get(0), "mult_array_mutation")
plot(anchor.expose().get(0, 0), "mult_source_unchanged")
plot(anchor.expose().mult(array.from(1.0, 2.0)).get(0), "mult_array_source_unchanged")
anchor.expose().set(0, 0, 112.0)
plot(float_values.get(0, 0) == 112.0 ? 1 : 0, "call_result_set_alias")
anchor.expose().fill(312.0)
plot(float_values.get(0, 0) == 312.0 and float_values.get(1, 1) == 312.0 ? 1 : 0, "call_result_fill_alias")
float_values.set(0, 0, 1.0)
float_values.set(0, 1, 2.0)
float_values.set(1, 0, 3.0)
float_values.set(1, 1, 4.0)
anchor.expose().reverse()
plot(float_values.get(0, 0) == 4.0 and float_values.get(0, 1) == 3.0 and float_values.get(1, 0) == 2.0 and float_values.get(1, 1) == 1.0 ? 1 : 0, "call_result_reverse_alias")
anchor.expose().reshape(1, 4)
plot(float_values.rows() == 1 and float_values.columns() == 4 and float_values.get(0, 0) == 4.0 and float_values.get(0, 3) == 1.0 ? 1 : 0, "call_result_reshape_alias")
float_values.reshape(2, 2)
float_values.set(0, 0, 1.0)
float_values.set(0, 1, 2.0)
float_values.set(1, 0, 3.0)
float_values.set(1, 1, 4.0)
anchor.expose().swap_rows(0, 1)
plot(float_values.get(0, 0) == 3.0 and float_values.get(0, 1) == 4.0 and float_values.get(1, 0) == 1.0 and float_values.get(1, 1) == 2.0 ? 1 : 0, "call_result_swap_rows_alias")
float_values.set(0, 0, 1.0)
float_values.set(0, 1, 2.0)
float_values.set(1, 0, 3.0)
float_values.set(1, 1, 4.0)
anchor.expose().swap_columns(0, 1)
plot(float_values.get(0, 0) == 2.0 and float_values.get(0, 1) == 1.0 and float_values.get(1, 0) == 4.0 and float_values.get(1, 1) == 3.0 ? 1 : 0, "call_result_swap_columns_alias")
anchor.expose().remove_row(0)
plot(float_values.rows() == 1 and float_values.columns() == 2 and float_values.get(0, 0) == 4.0 and float_values.get(0, 1) == 3.0 ? 1 : 0, "call_result_remove_row_alias")
anchor.expose().remove_col(0)
plot(float_values.rows() == 1 and float_values.columns() == 1 and float_values.get(0, 0) == 3.0 ? 1 : 0, "call_result_remove_col_alias")
add_row_values = array.from(5.0)
anchor.expose().add_row(1, add_row_values)
add_row_values.set(0, 99.0)
plot(float_values.rows() == 2 and float_values.columns() == 1 and float_values.get(0, 0) == 3.0 and float_values.get(1, 0) == 5.0 ? 1 : 0, "call_result_add_row_alias_copied_values")
add_col_values = array.from(6.0, 7.0)
anchor.expose().add_col(1, add_col_values)
add_col_values.set(0, 99.0)
plot(float_values.rows() == 2 and float_values.columns() == 2 and float_values.get(0, 0) == 3.0 and float_values.get(0, 1) == 6.0 and float_values.get(1, 0) == 5.0 and float_values.get(1, 1) == 7.0 ? 1 : 0, "call_result_add_col_alias_copied_values")
anchor.expose().sort(1, order.descending)
plot(float_values.rows() == 2 and float_values.columns() == 2 and float_values.get(0, 0) == 5.0 and float_values.get(0, 1) == 7.0 and float_values.get(1, 0) == 3.0 and float_values.get(1, 1) == 6.0 ? 1 : 0, "call_result_sort_alias_descending")
