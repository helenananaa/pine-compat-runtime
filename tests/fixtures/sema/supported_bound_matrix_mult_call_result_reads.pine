//@version=6
indicator("Supported bound matrix.mult call-result reads")

multRows(left, right) => left.mult(right).copy().rows()

left = matrix.new<float>(2, 3, 1.0)
right = matrix.new<float>(3, 2, 2.0)
int_left = matrix.new<int>(1, 1, 2)
int_right = matrix.new<int>(1, 1, 3)
vector = array.from(1.0, 2.0, 3.0)

int direct_rows = left.mult(right).rows()
int direct_columns = left.mult(right).columns()
int direct_elements = left.mult(right).elements_count()
float direct_get = left.mult(right).get(row=0, column=0)
matrix<float> nested_copy = left.mult(2.0).copy()
float int_get = int_left.mult(int_right).get(0, 0)
int array_size = left.mult(vector).size()
float array_get = left.mult(vector).get(0)
array<float> direct_row = left.mult(right).row(1).copy()
array<float> direct_col = left.mult(right).col(1).copy()
array<float> direct_eigenvalues = left.mult(right).eigenvalues().copy()
bool direct_is_square = left.mult(right).is_square()
bool direct_is_zero = left.mult(right).is_zero()
bool direct_is_binary = left.mult(right).is_binary()
bool direct_is_diagonal = left.mult(right).is_diagonal()
bool direct_is_identity = left.mult(right).is_identity()
bool direct_is_symmetric = left.mult(right).is_symmetric()
bool direct_is_antisymmetric = left.mult(right).is_antisymmetric()
bool direct_is_stochastic = left.mult(right).is_stochastic()
float direct_sum = left.mult(right).avg()
float direct_avg = left.mult(right).avg()
float direct_min = left.mult(right).min()
float direct_max = left.mult(right).max()
float direct_mode = left.mult(right).mode()
float direct_trace = left.mult(right).trace()
float direct_det = left.mult(right).det()
int direct_rank = left.mult(right).rank()
int transposed_columns = left.mult(right).transpose().columns()
int sliced_rows = left.mult(right).submatrix().rows()
int inverted_rows = left.mult(right).inv().rows()
int pseudo_rows = left.mult(right).pinv().rows()
int vector_rows = left.mult(right).eigenvectors().rows()
int powered_rows = left.mult(right).pow(2).rows()
matrix<float> kron_other = matrix.new<float>(1, 1, 2.0)
int kron_rows = left.mult(right).kron(kron_other).rows()
float diff_get = left.mult(right).diff(1.0).get(0, 0)
float mult_get = left.mult(right).mult(2.0).get(0, 0)
int nested_array_size = left.mult(right).mult(array.from(1.0, 1.0)).copy().size()

plot(direct_rows + direct_columns + direct_elements + direct_get + nested_copy.get(0, 0) + int_get + array_size + array_get + direct_row.size() + direct_col.size() + direct_eigenvalues.size() + (direct_is_square ? 1 : 0) + (direct_is_zero ? 1 : 0) + (direct_is_binary ? 1 : 0) + (direct_is_diagonal ? 1 : 0) + (direct_is_identity ? 1 : 0) + (direct_is_symmetric ? 1 : 0) + (direct_is_antisymmetric ? 1 : 0) + (direct_is_stochastic ? 1 : 0) + direct_sum + direct_avg + direct_min + direct_max + direct_mode + direct_trace + direct_det + direct_rank + transposed_columns + multRows(left, right))
plot(sliced_rows)
plot(inverted_rows)
plot(pseudo_rows)
plot(vector_rows)
plot(powered_rows)
plot(kron_rows)
plot(diff_get)
plot(mult_get)
plot(nested_array_size)
left.mult(right).set(0, 0, 2.0)
left.mult(right).fill(2.0)
left.mult(right).reverse()
left.mult(right).reshape(1, 4)
left.mult(right).swap_rows(0, 1)
left.mult(right).swap_columns(0, 1)
left.mult(right).remove_row(0)
left.mult(right).remove_col(0)
left.mult(right).add_row(0, array.from(1.0))
left.mult(right).add_col(0, array.from(1.0))
left.mult(right).sort()
