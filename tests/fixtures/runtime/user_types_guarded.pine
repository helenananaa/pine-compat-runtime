//@version=5
indicator("User-defined types")
type Point
    float x
    float y
type Wrapper
    Point inner
    float weight

p = Point.new(close, open)
plot((na(p) ? na : p.x) + (na(p) ? na : p.y))
Point typed_point = na
plot((na(typed_point) ? na : typed_point.x))
typed_point := Point.new(high + 5, low)
plot((na(typed_point) ? na : typed_point.x) + (na(typed_point) ? na : typed_point.y))
