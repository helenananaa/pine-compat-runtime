    typed_var_while_i := typed_var_while_i + 1
    Point.new(high + typed_var_while_i + 460, low)
if bar_index == 2
    typed_var_while := Point.new(high + 465, low)
plot((na(typed_var_while) ? na : typed_var_while.x) + (na(typed_var_while) ? na : typed_var_while.y))
if bar_index >= 0
    Point block_typed_point = na
