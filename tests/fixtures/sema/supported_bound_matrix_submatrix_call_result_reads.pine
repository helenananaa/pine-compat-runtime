//@version=6
indicator("Supported bound matrix.submatrix call-result reads")

submatrixRows(id) => id.submatrix(1, 3, 1, 4).copy().rows()

floats = matrix.new<float>(3, 4, 1.5)
ints = matrix.new<int>(1, 1, 4)
bools = matrix.new<bool>(1, 1, true)
strings = matrix.new<string>(1, 1, "value")
colors = matrix.new<color>(1, 1, color.red)

int direct_rows = floats.submatrix(1, 3, 1, 4).rows()
int direct_columns = floats.submatrix(1, 3, 1, 4).columns()
int direct_elements = floats.submatrix(1, 3, 1, 4).elements_count()
float direct_get = floats.submatrix(1, 3, 1, 4).get(row=1, column=2)
matrix<float> nested_copy = floats.submatrix().copy()
int int_get = ints.submatrix().get(0, 0)
bool bool_get = bools.submatrix().get(0, 0)
string string_get = strings.submatrix().get(0, 0)
color color_get = colors.submatrix().get(0, 0)
array<float> direct_row = floats.submatrix(1, 3, 1, 4).row(0).copy()
array<float> direct_col = floats.submatrix(1, 3, 1, 4).col(1).copy()
array<float> direct_eigenvalues = floats.submatrix(1, 3, 1, 3).eigenvalues().copy()
bool direct_is_square = floats.submatrix(1, 3, 1, 4).is_square()
bool direct_is_zero = floats.submatrix(1, 3, 1, 4).is_zero()
bool direct_is_binary = floats.submatrix(1, 3, 1, 4).is_binary()
bool direct_is_diagonal = floats.submatrix(1, 3, 1, 4).is_diagonal()
bool direct_is_identity = floats.submatrix(1, 3, 1, 4).is_identity()
bool direct_is_symmetric = floats.submatrix(1, 3, 1, 4).is_symmetric()
bool direct_is_antisymmetric = floats.submatrix(1, 3, 1, 4).is_antisymmetric()
bool direct_is_stochastic = floats.submatrix(1, 3, 1, 4).is_stochastic()
float direct_sum = floats.submatrix(1, 3, 1, 4).avg()
float direct_avg = floats.submatrix(1, 3, 1, 4).avg()
float direct_min = floats.submatrix(1, 3, 1, 4).min()
float direct_max = floats.submatrix(1, 3, 1, 4).max()
float direct_mode = floats.submatrix(1, 3, 1, 4).mode()
float direct_trace = floats.submatrix(1, 3, 1, 4).trace()
float direct_det = floats.submatrix(1, 3, 1, 4).det()
int direct_rank = floats.submatrix(1, 3, 1, 4).rank()
int transposed_columns = floats.submatrix(1, 3, 1, 4).transpose().columns()
int sliced_rows = floats.submatrix(1, 3, 1, 4).submatrix().rows()
int inverted_rows = floats.submatrix(1, 3, 1, 3).inv().rows()
int pseudo_rows = floats.submatrix(1, 3, 1, 3).pinv().rows()
int vector_rows = floats.submatrix(1, 3, 1, 3).eigenvectors().rows()
int powered_rows = floats.submatrix(1, 3, 1, 3).pow(2).rows()
matrix<float> kron_other = matrix.new<float>(1, 1, 2.0)
int kron_rows = floats.submatrix(1, 3, 1, 3).kron(kron_other).rows()
float diff_get = floats.submatrix(1, 3, 1, 3).diff(1.0).get(0, 0)
float mult_get = floats.submatrix(1, 3, 1, 3).mult(2.0).get(0, 0)

plot(direct_rows + direct_columns + direct_elements + direct_get + nested_copy.get(0, 0) + int_get + (bool_get ? 1 : 0) + (string_get == "value" ? 1 : 0) + (color_get == color.red ? 1 : 0) + direct_row.size() + direct_col.size() + direct_eigenvalues.size() + (direct_is_square ? 1 : 0) + (direct_is_zero ? 1 : 0) + (direct_is_binary ? 1 : 0) + (direct_is_diagonal ? 1 : 0) + (direct_is_identity ? 1 : 0) + (direct_is_symmetric ? 1 : 0) + (direct_is_antisymmetric ? 1 : 0) + (direct_is_stochastic ? 1 : 0) + direct_sum + direct_avg + direct_min + direct_max + direct_mode + direct_trace + direct_det + direct_rank + transposed_columns + submatrixRows(floats))
plot(sliced_rows)
plot(inverted_rows)
plot(pseudo_rows)
plot(vector_rows)
plot(powered_rows)
plot(kron_rows)
plot(diff_get)
plot(mult_get)
floats.submatrix().set(0, 0, 2.0)
floats.submatrix().fill(2.0)
floats.submatrix().reverse()
floats.submatrix().reshape(2, 6)
floats.submatrix().swap_rows(0, 1)
floats.submatrix().swap_columns(0, 1)
floats.submatrix().remove_row(0)
floats.submatrix().remove_col(0)
floats.submatrix().add_row(0, array.from(1.0))
floats.submatrix().add_col(0, array.from(1.0))
floats.submatrix().sort()
