//@version=4
study("Bool numeric ternary expanded 24",precision=0)
c=time>0
f=time<0
bool a=c?true:2
bool b=f?true:2
bool d=c?-2:false
bool e=f?-2:false
bool g=c?false:0.5
bool h=f?false:0.5
bool i=c?-0.5:true
bool j=f?-0.5:true
bool k=c?false:na
bool l=f?false:na
pick(x,y,z)=>z?x:y
bool m=pick(true,0,f)
bool n=pick(0,false,c)
plot(a?1:0,title="a")
plot(b?1:0,title="b")
plot(d?1:0,title="d")
plot(e?1:0,title="e")
plot(g?1:0,title="g")
plot(h?1:0,title="h")
plot(i?1:0,title="i")
plot(j?1:0,title="j")
plot(k?1:0,title="k")
plot(l?1:0,title="l")
plot(m?1:0,title="m")
plot(n?1:0,title="n")
