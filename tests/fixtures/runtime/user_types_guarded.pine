p.x := high
plot((na(p) ? na : p.x) + (na(p) ? na : p.y))
branch = Point.new(close, open)
if bar_index < 2
    branch.x := (na(branch) ? na : branch.x) + 10
else
    branch.y := (na(branch) ? na : branch.y) + 20
plot((na(branch) ? na : branch.x) + (na(branch) ? na : branch.y))
loop_mutated = Point.new(close, open)
for i = 0 to 1
    loop_mutated.x := (na(loop_mutated) ? na : loop_mutated.x) + i
plot((na(loop_mutated) ? na : loop_mutated.x) + (na(loop_mutated) ? na : loop_mutated.y))
while_mutated = Point.new(close, open)
while_i = 0
while while_i < 2
    while_mutated.y := (na(while_mutated) ? na : while_mutated.y) + while_i
    while_i := while_i + 1
plot((na(while_mutated) ? na : while_mutated.x) + (na(while_mutated) ? na : while_mutated.y))
looped = for i = 0 to 1
    Point.new((na(p) ? na : p.x) + i, (na(p) ? na : p.y))
plot((na(looped) ? na : looped.x) + (na(looped) ? na : looped.y))
Wrapper typed_wrapped = Wrapper.new(Point.new(high + 100, low), high)
plot((na(typed_wrapped) ? na : na(typed_wrapped.inner) ? na : typed_wrapped.inner.x) + (na(typed_wrapped) ? na : na(typed_wrapped.inner) ? na : typed_wrapped.inner.y) + (na(typed_wrapped) ? na : typed_wrapped.weight))
typed_wrapped := Wrapper.new(Point.new(high + 105, low), close)
plot((na(typed_wrapped) ? na : na(typed_wrapped.inner) ? na : typed_wrapped.inner.x) + (na(typed_wrapped) ? na : na(typed_wrapped.inner) ? na : typed_wrapped.inner.y) + (na(typed_wrapped) ? na : typed_wrapped.weight))
Wrapper typed_wrapped_na = na
typed_wrapped_na := Wrapper.new(Point.new(high + 110, low), close)
plot((na(typed_wrapped_na) ? na : na(typed_wrapped_na.inner) ? na : typed_wrapped_na.inner.x) + (na(typed_wrapped_na) ? na : na(typed_wrapped_na.inner) ? na : typed_wrapped_na.inner.y) + (na(typed_wrapped_na) ? na : typed_wrapped_na.weight))
wrapped = Wrapper.new(p, high)
plot((na(wrapped) ? na : na(wrapped.inner) ? na : wrapped.inner.x) + (na(wrapped) ? na : na(wrapped.inner) ? na : wrapped.inner.y) + (na(wrapped) ? na : wrapped.weight))
inner = (na(wrapped) ? na : wrapped.inner)
plot((na(inner) ? na : inner.x) + (na(inner) ? na : inner.y))
nestedScore(w) => (na(w) ? na : na(w.inner) ? na : w.inner.x) + (na(w) ? na : na(w.inner) ? na : w.inner.y) + (na(w) ? na : w.weight)
plot(nestedScore(wrapped))
wrapped.inner := Point.new(high + 10, low)
plot((na(wrapped) ? na : na(wrapped.inner) ? na : wrapped.inner.x) + (na(wrapped) ? na : na(wrapped.inner) ? na : wrapped.inner.y) + (na(wrapped) ? na : wrapped.weight))
branch_wrapped = Wrapper.new(Point.new(close, open), high)
if bar_index < 2
    branch_wrapped.inner := Point.new(high + 20, low)
else
    branch_wrapped.inner := Point.new(high + 30, low)
plot((na(branch_wrapped) ? na : na(branch_wrapped.inner) ? na : branch_wrapped.inner.x) + (na(branch_wrapped) ? na : na(branch_wrapped.inner) ? na : branch_wrapped.inner.y) + (na(branch_wrapped) ? na : branch_wrapped.weight))
for_wrapped = Wrapper.new(Point.new(close, open), high)
for i = 0 to 1
    for_wrapped.inner := Point.new((na(for_wrapped) ? na : na(for_wrapped.inner) ? na : for_wrapped.inner.x) + i + 10, (na(for_wrapped) ? na : na(for_wrapped.inner) ? na : for_wrapped.inner.y) + i)
plot((na(for_wrapped) ? na : na(for_wrapped.inner) ? na : for_wrapped.inner.x) + (na(for_wrapped) ? na : na(for_wrapped.inner) ? na : for_wrapped.inner.y) + (na(for_wrapped) ? na : for_wrapped.weight))
while_wrapped = Wrapper.new(Point.new(close, open), high)
while_i_nested = 0
while while_i_nested < 2
    while_wrapped.inner := Point.new((na(while_wrapped) ? na : na(while_wrapped.inner) ? na : while_wrapped.inner.x) + while_i_nested + 20, (na(while_wrapped) ? na : na(while_wrapped.inner) ? na : while_wrapped.inner.y) + while_i_nested)
    while_i_nested := while_i_nested + 1
plot((na(while_wrapped) ? na : na(while_wrapped.inner) ? na : while_wrapped.inner.x) + (na(while_wrapped) ? na : na(while_wrapped.inner) ? na : while_wrapped.inner.y) + (na(while_wrapped) ? na : while_wrapped.weight))
