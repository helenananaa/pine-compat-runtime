//@version=6
indicator("window-input-script-small-v6-44",dynamic_requests=true,calc_bars_count=2)
enabled=input.bool(true,"input-script-small-44")
float a=na
if enabled
    a:=request.security(syminfo.tickerid,timeframe.period,bar_index,calc_bars_count=100)
var count=0
count+=1
plot(bar_index)
plot(na(a)?-1:a)
plot(count)
