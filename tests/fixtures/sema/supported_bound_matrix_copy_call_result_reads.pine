//@version=6
indicator("Supported bound matrix.copy call-result reads")

copyRows(id) => id.copy().copy().rows()

floats = matrix.new<float>(2, 3, 1.5)
ints = matrix.new<int>(1, 1, 4)
bools = matrix.new<bool>(1, 1, true)
strings = matrix.new<string>(1, 1, "value")
colors = matrix.new<color>(1, 1, color.red)

int direct_rows = floats.copy().rows()
int direct_columns = floats.copy().columns()
int direct_elements = floats.copy().elements_count()
float direct_get = floats.copy().get(row=0, column=1)
matrix<float> nested_copy = floats.copy().copy()
int int_get = ints.copy().get(0, 0)
bool bool_get = bools.copy().get(0, 0)
string string_get = strings.copy().get(0, 0)
color color_get = colors.copy().get(0, 0)
array<float> direct_row = floats.copy().row(1).copy()
array<float> direct_col = floats.copy().col(1).copy()
array<float> direct_eigenvalues = floats.copy().eigenvalues().copy()
bool direct_is_square = floats.copy().is_square()
bool direct_is_zero = floats.copy().is_zero()
bool direct_is_binary = floats.copy().is_binary()
bool direct_is_diagonal = floats.copy().is_diagonal()
bool direct_is_identity = floats.copy().is_identity()
bool direct_is_symmetric = floats.copy().is_symmetric()
bool direct_is_antisymmetric = floats.copy().is_antisymmetric()
bool direct_is_stochastic = floats.copy().is_stochastic()
float direct_sum = floats.copy().avg()
float direct_avg = floats.copy().avg()
float direct_min = floats.copy().min()
float direct_max = floats.copy().max()
float direct_mode = floats.copy().mode()
float direct_trace = floats.copy().trace()
float direct_det = floats.copy().det()
int direct_rank = floats.copy().rank()
int transposed_columns = floats.copy().transpose().columns()
int sliced_rows = floats.copy().submatrix(0, 1, 0, 1).rows()
int inverted_rows = floats.copy().inv().rows()
int pseudo_rows = floats.copy().pinv().rows()
int vector_rows = floats.copy().eigenvectors().rows()
int powered_rows = floats.copy().pow(2).rows()
matrix<float> kron_other = matrix.new<float>(1, 1, 2.0)
int kron_rows = floats.copy().kron(kron_other).rows()
float diff_get = floats.copy().diff(1.0).get(0, 0)
float mult_get = floats.copy().mult(2.0).get(0, 0)

plot(direct_rows + direct_columns + direct_elements + direct_get + nested_copy.get(0, 0) + int_get + (bool_get ? 1 : 0) + (string_get == "value" ? 1 : 0) + (color_get == color.red ? 1 : 0) + direct_row.size() + direct_col.size() + direct_eigenvalues.size() + (direct_is_square ? 1 : 0) + (direct_is_zero ? 1 : 0) + (direct_is_binary ? 1 : 0) + (direct_is_diagonal ? 1 : 0) + (direct_is_identity ? 1 : 0) + (direct_is_symmetric ? 1 : 0) + (direct_is_antisymmetric ? 1 : 0) + (direct_is_stochastic ? 1 : 0) + direct_sum + direct_avg + direct_min + direct_max + direct_mode + direct_trace + direct_det + direct_rank + transposed_columns + copyRows(floats))
plot(sliced_rows)
plot(inverted_rows)
plot(pseudo_rows)
plot(vector_rows)
plot(powered_rows)
plot(kron_rows)
plot(diff_get)
plot(mult_get)
floats.copy().set(row=0, column=0, value=2.0)
floats.copy().fill(2.0)
floats.copy().reverse()
floats.copy().reshape(3, 2)
floats.copy().swap_rows(0, 1)
floats.copy().swap_columns(0, 1)
floats.copy().remove_row(0)
floats.copy().remove_col(0)
floats.copy().add_row(0, array.from(1.0))
floats.copy().add_col(0, array.from(1.0))
floats.copy().sort()
