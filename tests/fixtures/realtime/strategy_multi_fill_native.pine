//@version=6
strategy("Realtime Multi Fill Reference", initial_capital=1000000, margin_long=100, margin_short=100, pyramiding=2, calc_on_every_tick=true, calc_on_order_fills=true, commission_type=strategy.commission.cash_per_order, commission_value=0, precision=12)
int captureStart = 1789003980000
varip array<float> samples = array.new<float>()
varip int sampleCount = 0
varip bool placed = false
varip bool closed = false
if barstate.isrealtime and time == captureStart
    if sampleCount < 7
        sampleCount += 1
        array.push(samples, timenow)
        array.push(samples, open)
        array.push(samples, high)
        array.push(samples, low)
        array.push(samples, close)
        array.push(samples, volume)
        array.push(samples, strategy.position_size)
        array.push(samples, strategy.opentrades)
        array.push(samples, strategy.closedtrades)
    if not placed
        strategy.entry("A", strategy.long, qty=0.001)
        strategy.entry("B", strategy.long, qty=0.001)
        placed := true
    if sampleCount >= 3 and strategy.position_size > 0 and not closed
        strategy.close_all()
        closed := true
field(int index) => array.size(samples) > index ? array.get(samples, index) : na
plot(field(0), "MF0 now", display=display.data_window)
plot(field(1), "MF0 open", display=display.data_window)
plot(field(2), "MF0 high", display=display.data_window)
plot(field(3), "MF0 low", display=display.data_window)
plot(field(4), "MF0 close", display=display.data_window)
plot(field(5), "MF0 volume", display=display.data_window)
plot(field(6), "MF0 position", display=display.data_window)
plot(field(7), "MF0 openTrades", display=display.data_window)
plot(field(8), "MF0 closedTrades", display=display.data_window)
