//@version=6
indicator("Supported bound matrix.inv call-result reads")

invRows(values) => values.inv().copy().rows()

values = matrix.new<float>(2, 2, 0.0)
values.set(0, 0, 4.0)
values.set(0, 1, 7.0)
values.set(1, 0, 2.0)
values.set(1, 1, 6.0)
ints = matrix.new<int>(1, 1, 2)

int direct_rows = values.inv().rows()
int direct_columns = values.inv().columns()
int direct_elements = values.inv().elements_count()
float direct_get = values.inv().get(row=0, column=0)
matrix<float> nested_copy = values.inv().copy()
float int_get = ints.inv().get(0, 0)
array<float> direct_row = values.inv().row(1).copy()
array<float> direct_col = values.inv().col(1).copy()
array<float> direct_eigenvalues = values.inv().eigenvalues().copy()
bool direct_is_square = values.inv().is_square()
bool direct_is_zero = values.inv().is_zero()
bool direct_is_binary = values.inv().is_binary()
bool direct_is_diagonal = values.inv().is_diagonal()
bool direct_is_identity = values.inv().is_identity()
bool direct_is_symmetric = values.inv().is_symmetric()
bool direct_is_antisymmetric = values.inv().is_antisymmetric()
bool direct_is_stochastic = values.inv().is_stochastic()
float direct_sum = values.inv().avg()
float direct_avg = values.inv().avg()
float direct_min = values.inv().min()
float direct_max = values.inv().max()
float direct_mode = values.inv().mode()
float direct_trace = values.inv().trace()
float direct_det = values.inv().det()
int direct_rank = values.inv().rank()
int transposed_columns = values.inv().transpose().columns()
int sliced_rows = values.inv().submatrix().rows()
int inverted_rows = values.inv().inv().rows()
int pseudo_rows = values.inv().pinv().rows()
int vector_rows = values.inv().eigenvectors().rows()
int powered_rows = values.inv().pow(2).rows()
matrix<float> kron_other = matrix.new<float>(1, 1, 2.0)
int kron_rows = values.inv().kron(kron_other).rows()
float diff_get = values.inv().diff(1.0).get(0, 0)
float mult_get = values.inv().mult(2.0).get(0, 0)

plot(direct_rows + direct_columns + direct_elements + direct_get + nested_copy.get(0, 1) + int_get + direct_row.size() + direct_col.size() + direct_eigenvalues.size() + (direct_is_square ? 1 : 0) + (direct_is_zero ? 1 : 0) + (direct_is_binary ? 1 : 0) + (direct_is_diagonal ? 1 : 0) + (direct_is_identity ? 1 : 0) + (direct_is_symmetric ? 1 : 0) + (direct_is_antisymmetric ? 1 : 0) + (direct_is_stochastic ? 1 : 0) + direct_sum + direct_avg + direct_min + direct_max + direct_mode + direct_trace + direct_det + direct_rank + transposed_columns + invRows(values))
plot(sliced_rows)
plot(inverted_rows)
plot(pseudo_rows)
plot(vector_rows)
plot(powered_rows)
plot(kron_rows)
plot(diff_get)
plot(mult_get)
values.inv().set(0, 0, 2.0)
values.inv().fill(2.0)
values.inv().reverse()
values.inv().reshape(1, 4)
values.inv().swap_rows(0, 1)
values.inv().swap_columns(0, 1)
values.inv().remove_row(0)
values.inv().remove_col(0)
values.inv().add_row(0, array.from(1.0))
values.inv().add_col(0, array.from(1.0))
values.inv().sort()
