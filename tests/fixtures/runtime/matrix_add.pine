//@version=6
indicator("Matrix addition")
a = matrix.new<float>(2, 2, 1.0)
b = matrix.new<float>(2, 2, 2.0)
c = matrix.sum(id2=b, id1=a)
d = a.sum(4.0)
i = matrix.new<int>(1, 1, 3)
matrix<int> j = i.sum(2)
plot(c.get(0, 0), "pair")
plot(d.get(1, 1), "scalar")
plot(j.get(0, 0), "int")
plot(a.get(0, 0), "input preserved")
matrix.set(a, 0, 0, 9)
plot(c.get(0, 0), "result preserved")
matrix<float> mixed = matrix.sum(id2=0.5, id1=i)
plot(mixed.get(0, 0), "mixed scalar promoted")
matrix<float> mixed_pair = i.sum(matrix.new<float>(1, 1, 0.5))
plot(mixed_pair.get(0, 0), "mixed pair promoted")
