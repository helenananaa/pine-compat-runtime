//@version=6
import user/udt/1 as left
import user/udt/1 as right
indicator("Supported imported function matrix call-result reads")

rows = left.exposeMatrixFunction().rows()
columns = left.exposeMatrixFunction().columns()
elements = left.exposeMatrixFunction().elements_count()
get = left.exposeMatrixFunction().get(0, 1)
copy_chain = left.exposeMatrixFunction().copy().get(1, 1)
int_get = left.exposeIntMatrixFunction().get(0, 1)
bool_get = left.exposeBoolMatrixFunction().get(0, 0)
string_get = left.exposeStringMatrixFunction().get(0, 0)
color_get = left.exposeColorMatrixFunction().get(0, 0)
empty = left.exposeEmptyMatrixFunction().columns()
block_return = left.exposeMatrixFunctionBlock().get(1, 1)
nested_return = left.exposeMatrixFunctionNested().get(1, 0)
control_flow = left.exposeMatrixFunctionIf(other=true).get(0, 0)
dual_alias = right.exposeMatrixFunction().get(0, 0)
nested_copy = left.exposeMatrixFunction().copy().copy().get(0, 1)
float_row = left.exposeMatrixFunction().row(1).copy()
int_row = left.exposeIntMatrixFunction().row(0)
dual_alias_row = right.exposeMatrixFunction().row(0).size()
float_col = left.exposeMatrixFunction().col(1).copy()
int_col = left.exposeIntMatrixFunction().col(1)
dual_alias_col = right.exposeMatrixFunction().col(0).size()
float_eigenvalues = left.exposeMatrixFunction().eigenvalues().copy()
dual_alias_eigenvalues = right.exposeMatrixFunction().eigenvalues().size()
float_is_square = left.exposeMatrixFunction().is_square()
color_is_square = left.exposeColorMatrixFunction().is_square()
float_is_zero = left.exposeMatrixFunction().is_zero()
int_is_zero = right.exposeIntMatrixFunction().is_zero()
float_is_binary = left.exposeMatrixFunction().is_binary()
int_is_binary = right.exposeIntMatrixFunction().is_binary()
float_is_diagonal = left.exposeMatrixFunction().is_diagonal()
int_is_diagonal = right.exposeIntMatrixFunction().is_diagonal()
float_is_identity = left.exposeMatrixFunction().is_identity()
int_is_identity = right.exposeIntMatrixFunction().is_identity()
float_is_symmetric = left.exposeMatrixFunction().is_symmetric()
int_is_symmetric = right.exposeIntMatrixFunction().is_symmetric()
float_is_antisymmetric = left.exposeMatrixFunction().is_antisymmetric()
int_is_antisymmetric = right.exposeIntMatrixFunction().is_antisymmetric()
float_is_stochastic = left.exposeMatrixFunction().is_stochastic()
int_is_stochastic = right.exposeIntMatrixFunction().is_stochastic()
float_sum = left.exposeMatrixFunction().avg()
int_sum = right.exposeIntMatrixFunction().avg()
float_avg = left.exposeMatrixFunction().avg()
int_avg = right.exposeIntMatrixFunction().avg()
float_min = left.exposeMatrixFunction().min()
int_min = right.exposeIntMatrixFunction().min()
float_max = left.exposeMatrixFunction().max()
int_max = right.exposeIntMatrixFunction().max()
float_mode = left.exposeMatrixFunction().mode()
int_mode = right.exposeIntMatrixFunction().mode()
float_trace = left.exposeMatrixFunction().trace()
int_trace = right.exposeIntMatrixFunction().trace()
float_det = left.exposeMatrixFunction().det()
int_det = right.exposeIntMatrixFunction().det()
float_rank = left.exposeMatrixFunction().rank()
int_rank = right.exposeIntMatrixFunction().rank()
transposed_rows = left.exposeMatrixFunction().transpose().rows()
transposed_columns = left.exposeMatrixFunction().transpose().columns()
transposed_get = left.exposeMatrixFunction().transpose().get(1, 0)
transposed_color = right.exposeColorMatrixFunction().transpose().get(0, 0)
repeated_transpose = left.exposeMatrixFunction().copy().transpose().transpose().get(0, 1)
sliced_rows = left.exposeMatrixFunction().submatrix(0, 1, 0, 2).rows()
sliced_columns = left.exposeMatrixFunction().submatrix().columns()
sliced_get = left.exposeMatrixFunction().submatrix().get(1, 0)
sliced_color = right.exposeColorMatrixFunction().submatrix().get(0, 0)
nested_slice = left.exposeMatrixFunction().transpose().submatrix().copy().get(1, 0)
inverted_rows = left.exposeMatrixFunction().inv().rows()
inverted_int = right.exposeIntMatrixFunction().inv().get(0, 0)
nested_inv = left.exposeMatrixFunction().copy().inv().submatrix().get(0, 0)
pseudo_rows = left.exposeMatrixFunction().pinv().rows()
pseudo_int = right.exposeIntMatrixFunction().pinv().get(0, 0)
nested_pinv = left.exposeMatrixFunction().copy().pinv().transpose().get(0, 0)
vector_rows = left.exposeMatrixFunction().eigenvectors().rows()
vector_int = right.exposeIntMatrixFunction().eigenvectors().get(0, 0)
nested_vectors = left.exposeMatrixFunction().copy().eigenvectors().pinv().get(0, 0)
powered_rows = left.exposeMatrixFunction().pow(2).rows()
powered_int = right.exposeIntMatrixFunction().pow(3).get(0, 0)
nested_power = left.exposeMatrixFunction().copy().pow(2).pinv().get(0, 0)
kron_other = matrix.new<float>(1, 1, 2.0)
kron_rows = left.exposeMatrixFunction().kron(kron_other).rows()
kron_int = right.exposeIntMatrixFunction().kron(matrix.new<int>(1, 1, 3)).get(0, 0)
nested_kron = left.exposeMatrixFunction().copy().kron(kron_other).pow(2).get(0, 0)
diff_rows = left.exposeMatrixFunction().diff(1.0).rows()
diff_int = right.exposeIntMatrixFunction().diff(matrix.new<int>(1, 1, 1)).get(0, 0)
nested_diff = left.exposeMatrixFunction().copy().diff(1.0).kron(kron_other).get(0, 0)
mult_rows = left.exposeMatrixFunction().mult(2.0).rows()
mult_int = right.exposeIntMatrixFunction().mult(matrix.new<int>(2, 2, 3)).get(0, 0)
mult_array_size = left.exposeMatrixFunction().mult(array.from(1.0, 1.0)).copy().size()
nested_mult = left.exposeMatrixFunction().copy().mult(2.0).diff(1.0).get(0, 0)

plot(rows + columns + elements + get + copy_chain + int_get + empty + block_return + nested_return + control_flow + dual_alias + nested_copy + float_row.size() + int_row.size() + dual_alias_row + float_col.size() + int_col.size() + dual_alias_col + float_eigenvalues.size() + dual_alias_eigenvalues + (float_is_square ? 1 : 0) + (color_is_square ? 1 : 0) + (float_is_zero ? 1 : 0) + (int_is_zero ? 1 : 0) + (float_is_binary ? 1 : 0) + (int_is_binary ? 1 : 0) + (float_is_diagonal ? 1 : 0) + (int_is_diagonal ? 1 : 0) + (float_is_identity ? 1 : 0) + (int_is_identity ? 1 : 0) + (float_is_symmetric ? 1 : 0) + (int_is_symmetric ? 1 : 0) + (float_is_antisymmetric ? 1 : 0) + (int_is_antisymmetric ? 1 : 0) + (float_is_stochastic ? 1 : 0) + (int_is_stochastic ? 1 : 0) + float_sum + int_sum + float_avg + int_avg + float_min + int_min + float_max + int_max + float_mode + int_mode + float_trace + int_trace + float_det + int_det + float_rank + int_rank)
plot(transposed_rows + transposed_columns + transposed_get + (transposed_color == color.red ? 1 : 0) + repeated_transpose)
plot(sliced_rows + sliced_columns + sliced_get + (sliced_color == color.red ? 1 : 0) + nested_slice)
plot(inverted_rows + inverted_int + nested_inv)
plot(pseudo_rows + pseudo_int + nested_pinv)
plot(vector_rows + vector_int + nested_vectors)
plot(powered_rows + powered_int + nested_power)
plot(kron_rows + kron_int + nested_kron)
plot(diff_rows + diff_int + nested_diff)
plot(mult_rows + mult_int + mult_array_size + nested_mult)
left.exposeMatrixFunction().set(0, 0, 2.0)
left.exposeMatrixFunction().fill(2.0)
left.exposeMatrixFunction().reverse()
left.exposeMatrixFunction().reshape(1, 4)
left.exposeMatrixFunction().swap_rows(0, 1)
left.exposeMatrixFunction().swap_columns(0, 1)
right.exposeIntMatrixFunction().set(0, 0, 2)
right.exposeIntMatrixFunction().fill(2)
right.exposeIntMatrixFunction().reverse()
right.exposeIntMatrixFunction().reshape(2, 1)
right.exposeIntMatrixFunction().swap_rows(0, 0)
right.exposeIntMatrixFunction().swap_columns(0, 0)
left.exposeBoolMatrixFunction().set(0, 0, false)
left.exposeBoolMatrixFunction().fill(false)
left.exposeBoolMatrixFunction().reverse()
left.exposeBoolMatrixFunction().reshape(1, 1)
left.exposeBoolMatrixFunction().swap_rows(0, 0)
left.exposeBoolMatrixFunction().swap_columns(0, 0)
right.exposeStringMatrixFunction().set(0, 0, "set")
right.exposeStringMatrixFunction().fill("fill")
right.exposeStringMatrixFunction().reverse()
right.exposeStringMatrixFunction().reshape(1, 1)
right.exposeStringMatrixFunction().swap_rows(0, 0)
right.exposeStringMatrixFunction().swap_columns(0, 0)
left.exposeColorMatrixFunction().set(0, 0, color.blue)
left.exposeColorMatrixFunction().fill(color.blue)
left.exposeColorMatrixFunction().reverse()
left.exposeColorMatrixFunction().reshape(1, 1)
left.exposeColorMatrixFunction().swap_rows(0, 0)
left.exposeColorMatrixFunction().swap_columns(0, 0)
left.exposeMatrixFunction().remove_row(0)
left.exposeMatrixFunction().remove_col(0)
right.exposeIntMatrixFunction().remove_row(0)
right.exposeIntMatrixFunction().remove_col(0)
left.exposeBoolMatrixFunction().remove_row(0)
left.exposeBoolMatrixFunction().remove_col(0)
right.exposeStringMatrixFunction().remove_row(0)
right.exposeStringMatrixFunction().remove_col(0)
left.exposeColorMatrixFunction().remove_row(0)
left.exposeColorMatrixFunction().remove_col(0)
left.exposeMatrixFunction().add_row(0, array.from(1.0))
right.exposeIntMatrixFunction().add_row(0, array.from(1))
left.exposeBoolMatrixFunction().add_row(0, array.from(false))
right.exposeStringMatrixFunction().add_row(0, array.from("row"))
left.exposeColorMatrixFunction().add_row(0, array.from(color.blue))

left.exposeMatrixFunction().add_col(0, array.from(1.0))
right.exposeIntMatrixFunction().add_col(0, array.from(1))
left.exposeBoolMatrixFunction().add_col(0, array.from(false))
right.exposeStringMatrixFunction().add_col(0, array.from("column"))
left.exposeColorMatrixFunction().add_col(0, array.from(color.blue))

left.exposeMatrixFunction().sort()
right.exposeIntMatrixFunction().sort(0, order.descending)
