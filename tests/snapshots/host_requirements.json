{
  "schemaVersion": 4,
  "discovery": "conservativeExecutableHirInventory",
  "chart": {
    "bars": "hostSuppliedStandardOhlcv",
    "priceGrid": "positiveIntegerMinMoveAndPriceScale",
    "quantityPrecision": "decimalPowerZeroThroughNine",
    "symbolMetadata": [
      "syminfo.mincontract",
      "syminfo.tickerid"
    ],
    "defaults": {
      "symbol": "NASDAQ:AAPL",
      "timeframe": "1",
      "minMove": 1,
      "priceScale": 100,
      "quantityPrecision": 0,
      "synthetic": true,
      "symbolLookup": false,
      "currency": "USD",
      "pointValue": 1,
      "timezone": "Etc/UTC"
    },
    "barCalendars": "continuousUtcDefaultOrHostSuppliedTradingIntervalsV1",
    "contractMetadataSchemaVersion": 1,
    "quantityStep": "optionalExactPositiveDecimalString",
    "minContract": "optionalPositiveDecimalMinimumIndependentOfStep"
  },
  "account": {
    "profile": "linearHostPointValueWithHostCurrencyRates",
    "currencyConversion": true,
    "unsupportedProfiles": [
      "inverseContractAccounting",
      "nonstandardChartBroker"
    ],
    "defaultQuantity": {
      "kind": "fixed",
      "value": "1"
    },
    "defaultPointValue": 1,
    "contractMetadataSchemaVersion": 1
  },
  "execution": {
    "clock": "explicitTimestampWhenEvaluated",
    "realtimeUpdates": "hostOrderedFormingReplacementAndConfirmation",
    "calcOnEveryTick": true,
    "calcOnEveryHistoryTick": false,
    "calcOnOrderFills": false,
    "processOrdersOnClose": false,
    "magnifier": "historicalIntrabarsOrReportedStandardOhlcFallback",
    "sessionWindows": "hostWindowAndTradingDayIdsOrUtcFallback"
  },
  "requests": [
    {
      "callSiteId": 4,
      "function": "request.security",
      "symbol": {
        "kind": "literal",
        "value": "OTHER"
      },
      "timeframe": {
        "kind": "literal",
        "value": "60"
      },
      "provider": "whenEvaluatedOutsideCurrentContext",
      "timeframeRelation": "sameOrLowerOrHigher",
      "gaps": "gapsOff",
      "lookahead": "lookaheadOff"
    },
    {
      "callSiteId": 6,
      "function": "request.security",
      "symbol": {
        "kind": "currentContextSymbol"
      },
      "timeframe": {
        "kind": "currentContextTimeframe"
      },
      "provider": "whenEvaluatedOutsideCurrentContext",
      "timeframeRelation": "sameOrLowerOrHigher",
      "gaps": "gapsOff",
      "lookahead": "lookaheadOff"
    }
  ],
  "inputCallSiteIds": [
    1
  ]
}
