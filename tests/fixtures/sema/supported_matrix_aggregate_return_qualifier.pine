//@version=6
indicator("Supported matrix aggregate return qualifier")

int_values = matrix.new<int>(2, 2, 1)
float_values = matrix.new<float>(2, 2, close)

plot(matrix.avg(int_values) + matrix.avg(int_values) + matrix.min(int_values) + matrix.max(int_values) + matrix.mode(int_values) + matrix.trace(int_values) + matrix.det(int_values))
plot(int_values.avg() + int_values.avg() + int_values.min() + int_values.max() + int_values.mode() + int_values.trace() + int_values.det())
plot(matrix.avg(float_values) + matrix.avg(float_values) + matrix.min(float_values) + matrix.max(float_values) + matrix.mode(float_values) + matrix.trace(float_values) + matrix.det(float_values))
plot(float_values.avg() + float_values.avg() + float_values.min() + float_values.max() + float_values.mode() + float_values.trace() + float_values.det())
plot(matrix.rank(int_values) + int_values.rank() + matrix.rank(float_values) + float_values.rank())
