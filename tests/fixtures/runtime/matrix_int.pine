//@version=6
indicator("Matrix int")

values = matrix.new<int>(2, 3, 7)
matrix.set(values, 0, 1, 9)
values.set(1, 2, na)
initial = matrix.get(values, 0, 2)
set_cell = values.get(0, 1)
set_na_cell = values.get(1, 2)
default_values = matrix.new<int>(1, 2)
default_cell = matrix.get(default_values, 0, 1)
matrix.fill(default_values, 3)
filled_cell = default_values.get(0, 1)
default_values.fill(na)
filled_na_cell = default_values.get(0, 0)

copied = matrix.copy(values)
reversed = matrix.copy(values)
matrix.reverse(reversed)
transposed = values.transpose()
reshaped = matrix.copy(values)
reshaped.reshape(3, 2)
slice = values.submatrix(0, 1, 1, 3)
row_values = matrix.row(values, 0)
column_values = values.col(1)
row_before_matrix_write = row_values.get(1)
column_before_matrix_write = column_values.get(0)
matrix.set(values, 0, 1, 5)
row_after_matrix_write = row_values.get(1)
column_after_matrix_write = column_values.get(0)
row_values.set(0, 11)
column_values.set(1, 12)
row_after_array_write = row_values.get(0)
column_after_array_write = column_values.get(1)
matrix_after_row_array_write = values.get(0, 0)
matrix_after_column_array_write = values.get(1, 1)
row_swapped = matrix.copy(values)
matrix.swap_rows(row_swapped, 0, 1)
column_swapped = matrix.copy(values)
column_swapped.swap_columns(0, 2)
row_removed = matrix.copy(values)
matrix.remove_row(row_removed, 1)
column_removed = matrix.copy(values)
column_removed.remove_col(1)
sort_values = matrix.new<int>(3, 2, 0)
matrix.set(sort_values, 0, 0, 2)
matrix.set(sort_values, 0, 1, 20)
matrix.set(sort_values, 1, 0, 1)
matrix.set(sort_values, 1, 1, 10)
matrix.set(sort_values, 2, 0, na)
matrix.set(sort_values, 2, 1, 99)
matrix.sort(sort_values, 0)
descending_sort = matrix.copy(sort_values)
descending_sort.sort(0, order.descending)
row_added = matrix.new<int>(1, 2, 1)
row_insert = array.from(2, na)
matrix.add_row(row_added, 1, row_insert)
row_added.add_row(2, array.from(3, 4))
row_added_snapshot = row_added.row(1)
row_insert.set(0, 99)
col_added = matrix.new<int>(2, 1, 1)
col_added.set(1, 0, 6)
col_insert = array.from(2, na)
matrix.add_col(col_added, 1, col_insert)
col_added.add_col(2, array.from(3, 4))
col_added_snapshot = col_added.col(1)
col_insert.set(0, 99)
int_zero = matrix.new<int>(2, 2, 0)
int_binary = matrix.copy(int_zero)
matrix.set(int_binary, 0, 1, 1)
int_non_binary = matrix.copy(int_binary)
int_non_binary.set(1, 1, 2)
int_diagonal = matrix.new<int>(2, 2, 0)
matrix.set(int_diagonal, 0, 0, 5)
matrix.set(int_diagonal, 1, 1, 6)
int_identity = matrix.new<int>(2, 2, 0)
matrix.set(int_identity, 0, 0, 1)
matrix.set(int_identity, 1, 1, 1)
int_symmetric = matrix.copy(int_identity)
matrix.set(int_symmetric, 0, 1, 3)
matrix.set(int_symmetric, 1, 0, 3)
int_antisymmetric = matrix.new<int>(2, 2, 0)
matrix.set(int_antisymmetric, 0, 1, 3)
matrix.set(int_antisymmetric, 1, 0, -3)
int_stochastic = matrix.new<int>(1, 1, 1)
int_predicate_na = matrix.new<int>(1, 1, na)
int_stats = matrix.new<int>(2, 3, na)
matrix.set(int_stats, 0, 0, 1)
matrix.set(int_stats, 0, 1, 2)
matrix.set(int_stats, 0, 2, 2)
matrix.set(int_stats, 1, 0, 4)
matrix.set(int_stats, 1, 2, 6)
int_rank = matrix.new<int>(2, 2, 0)
matrix.set(int_rank, 0, 0, 1)
matrix.set(int_rank, 0, 1, 2)
matrix.set(int_rank, 1, 0, 2)
matrix.set(int_rank, 1, 1, 4)
arith_left = matrix.new<int>(2, 2, 0)
matrix.set(arith_left, 0, 0, 1)
matrix.set(arith_left, 0, 1, 2)
matrix.set(arith_left, 1, 0, 3)
matrix.set(arith_left, 1, 1, 4)
arith_right = matrix.new<int>(2, 2, 0)
matrix.set(arith_right, 0, 0, 5)
matrix.set(arith_right, 0, 1, 6)
matrix.set(arith_right, 1, 0, 7)
matrix.set(arith_right, 1, 1, 8)
int_kron = matrix.kron(arith_left, arith_right)
int_mult = arith_left.mult(arith_right)
int_diff = matrix.diff(arith_right, arith_left)
int_pow = arith_left.pow(2)
int_linalg = matrix.new<int>(1, 1, 4)
int_eigenvalues = matrix.eigenvalues(int_linalg)
int_eigenvectors = int_linalg.eigenvectors()
int_inv = matrix.inv(int_linalg)
int_pinv = int_linalg.pinv()

plot(matrix.rows(values), "rows")
plot(values.columns(), "columns")
plot(values.elements_count(), "elements_count")
plot(initial, "initial")
plot(set_cell, "set_cell")
plot(set_na_cell, "set_na_cell")
plot(default_cell, "default_cell")
plot(filled_cell, "filled_cell")
plot(filled_na_cell, "filled_na_cell")
plot(copied.get(1, 2), "copied_last")
plot(reversed.get(0, 0), "reversed_first")
plot(matrix.rows(transposed), "transposed_rows")
plot(matrix.columns(transposed), "transposed_columns")
plot(reshaped.rows(), "reshaped_rows")
plot(reshaped.columns(), "reshaped_columns")
plot(slice.rows(), "slice_rows")
plot(slice.columns(), "slice_columns")
plot(slice.get(0, 1), "slice_last")
plot(row_values.size(), "row_size")
plot(column_values.size(), "column_size")
plot(row_before_matrix_write, "row_before_matrix_write")
plot(row_after_matrix_write, "row_after_matrix_write")
plot(column_before_matrix_write, "column_before_matrix_write")
plot(column_after_matrix_write, "column_after_matrix_write")
plot(row_after_array_write, "row_after_array_write")
plot(column_after_array_write, "column_after_array_write")
plot(matrix_after_row_array_write, "matrix_after_row_array_write")
plot(matrix_after_column_array_write, "matrix_after_column_array_write")
plot(row_swapped.get(0, 1), "row_swapped_first_row_middle")
plot(column_swapped.get(0, 0), "column_swapped_first_cell")
plot(column_swapped.get(1, 2), "column_swapped_last_column")
plot(row_removed.rows(), "row_removed_rows")
plot(row_removed.get(0, 1), "row_removed_middle")
plot(column_removed.columns(), "column_removed_columns")
plot(column_removed.get(0, 1), "column_removed_last")
plot(sort_values.get(0, 1), "sort_first_payload")
plot(sort_values.get(2, 1), "sort_na_payload")
plot(descending_sort.get(0, 1), "sort_descending_first_payload")
plot(row_added.rows(), "row_added_rows")
plot(row_added.columns(), "row_added_columns")
plot(row_added.get(1, 0), "row_added_inserted")
plot(row_added.get(1, 1), "row_added_inserted_na")
plot(row_added.get(2, 1), "row_added_method_last")
plot(row_added_snapshot.get(0), "row_added_snapshot")
plot(col_added.rows(), "col_added_rows")
plot(col_added.columns(), "col_added_columns")
plot(col_added.get(0, 1), "col_added_inserted")
plot(col_added.get(1, 1), "col_added_inserted_na")
plot(col_added.get(1, 2), "col_added_method_last")
plot(col_added_snapshot.get(0), "col_added_snapshot")
plot(int_zero.is_zero() ? 1 : 0, "int_is_zero")
plot(matrix.is_binary(int_binary) ? 1 : 0, "int_is_binary")
plot(int_non_binary.is_binary() ? 1 : 0, "int_is_binary_false")
plot(matrix.is_diagonal(int_diagonal) ? 1 : 0, "int_is_diagonal")
plot(int_identity.is_identity() ? 1 : 0, "int_is_identity")
plot(matrix.is_symmetric(int_symmetric) ? 1 : 0, "int_is_symmetric")
plot(int_antisymmetric.is_antisymmetric() ? 1 : 0, "int_is_antisymmetric")
plot(matrix.is_stochastic(int_stochastic) ? 1 : 0, "int_is_stochastic")
plot(int_predicate_na.is_zero() ? 1 : 0, "int_predicate_na_false")
plot(matrix.avg(int_stats), "int_sum")
plot(int_stats.avg(), "int_avg")
plot(matrix.min(int_stats), "int_min")
plot(int_stats.max(), "int_max")
plot(matrix.mode(int_stats), "int_mode")
plot(int_stats.trace(), "int_trace")
plot(matrix.rank(int_rank), "int_rank")
plot(int_rank.rank(), "int_rank_method")
plot(matrix.get(int_kron, 3, 3), "int_kron_last")
plot(int_mult.get(1, 1), "int_mult_last")
plot(matrix.get(int_diff, 0, 0), "int_diff_first")
plot(int_pow.get(1, 1), "int_pow_last")
plot(matrix.det(int_linalg), "int_det")
plot(array.get(int_eigenvalues, 0), "int_eigenvalue")
plot(matrix.get(int_eigenvectors, 0, 0), "int_eigenvector")
plot(int_inv.get(0, 0), "int_inv")
plot(matrix.get(int_pinv, 0, 0), "int_pinv")
plot(values.is_square() ? 1 : 0, "is_square")
