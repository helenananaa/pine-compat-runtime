//@version=6
indicator("window-simple-true-guard-v6-44",dynamic_requests=true)
simple bool enabled=syminfo.tickerid=="BINANCE:BTCUSDT"
float a=na
if enabled
    a:=request.security(syminfo.tickerid,timeframe.period,bar_index,calc_bars_count=2)
var count=0
count+=1
plot(bar_index)
plot(na(a)?-1:a)
plot(count)
