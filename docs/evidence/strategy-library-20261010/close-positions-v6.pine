//@version=6
strategy("Codex close positions v6 oracle",overlay=true,initial_capital=1000000)
if bar_index==0
    strategy.entry("E",strategy.long,qty=2)
if bar_index==2
    strategy.close("E","half",1,na,"half alert",false,false)
plot(strategy.position_size,"position size")
plot(strategy.closedtrades,"closed trades")
