//@version=6
import user/udt/1 as left
import user/udt/1 as right
indicator("Supported imported user-method matrix call-result reads")

left_point = left.Point.new(1.0)
right_point = right.Point.new(2.0)

rows = left_point.exposeMatrix().rows()
columns = left_point.exposeMatrix().columns()
elements = left_point.exposeMatrix().elements_count()
get = left_point.exposeMatrix().get(0, 1)
copy_chain = left_point.exposeMatrix().copy().get(1, 1)
int_get = left_point.exposeIntMatrix().get(0, 1)
bool_get = left_point.exposeBoolMatrix().get(0, 0)
string_get = left_point.exposeStringMatrix().get(0, 0)
color_get = left_point.exposeColorMatrix().get(0, 0)
empty = left_point.exposeEmptyMatrix().columns()
block_return = left_point.exposeMatrixBlock().get(1, 1)
nested_return = left_point.exposeMatrixNested().get(1, 0)
control_flow = left_point.exposeMatrixIf(other=true).get(0, 0)
alias_qualified = left.exposeMatrix(left_point).get(0, 0)
constructor_receiver = left.Point.new(3.0).exposeMatrix().get(1, 1)
dual_alias = right_point.exposeMatrix().get(0, 0)
nested_copy = left_point.exposeMatrix().copy().copy().get(0, 1)
float_row = left_point.exposeMatrix().row(1).copy()
int_row = left_point.exposeIntMatrix().row(0)
dual_alias_row = right_point.exposeMatrix().row(0).size()
float_col = left_point.exposeMatrix().col(1).copy()
int_col = left_point.exposeIntMatrix().col(1)
dual_alias_col = right_point.exposeMatrix().col(0).size()
float_eigenvalues = left_point.exposeMatrix().eigenvalues().copy()
dual_alias_eigenvalues = right_point.exposeMatrix().eigenvalues().size()
float_is_square = left_point.exposeMatrix().is_square()
color_is_square = left_point.exposeColorMatrix().is_square()
float_is_zero = left_point.exposeMatrix().is_zero()
int_is_zero = right_point.exposeIntMatrix().is_zero()
float_is_binary = left_point.exposeMatrix().is_binary()
int_is_binary = right_point.exposeIntMatrix().is_binary()
float_is_diagonal = left_point.exposeMatrix().is_diagonal()
int_is_diagonal = right_point.exposeIntMatrix().is_diagonal()
float_is_identity = left_point.exposeMatrix().is_identity()
int_is_identity = right_point.exposeIntMatrix().is_identity()
float_is_symmetric = left_point.exposeMatrix().is_symmetric()
int_is_symmetric = right_point.exposeIntMatrix().is_symmetric()
float_is_antisymmetric = left_point.exposeMatrix().is_antisymmetric()
int_is_antisymmetric = right_point.exposeIntMatrix().is_antisymmetric()
float_is_stochastic = left_point.exposeMatrix().is_stochastic()
int_is_stochastic = right_point.exposeIntMatrix().is_stochastic()
float_sum = left_point.exposeMatrix().avg()
int_sum = right_point.exposeIntMatrix().avg()
float_avg = left_point.exposeMatrix().avg()
int_avg = right_point.exposeIntMatrix().avg()
float_min = left_point.exposeMatrix().min()
int_min = right_point.exposeIntMatrix().min()
float_max = left_point.exposeMatrix().max()
int_max = right_point.exposeIntMatrix().max()
float_mode = left_point.exposeMatrix().mode()
int_mode = right_point.exposeIntMatrix().mode()
float_trace = left_point.exposeMatrix().trace()
int_trace = right_point.exposeIntMatrix().trace()
float_det = left_point.exposeMatrix().det()
int_det = right_point.exposeIntMatrix().det()
float_rank = left_point.exposeMatrix().rank()
int_rank = right_point.exposeIntMatrix().rank()
transposed_rows = left_point.exposeMatrix().transpose().rows()
transposed_columns = left_point.exposeMatrix().transpose().columns()
transposed_get = left_point.exposeMatrix().transpose().get(1, 0)
transposed_string = right_point.exposeStringMatrix().transpose().get(0, 0)
repeated_transpose = left_point.exposeMatrix().copy().transpose().transpose().get(0, 1)
sliced_rows = left_point.exposeMatrix().submatrix(0, 1, 0, 2).rows()
sliced_columns = left_point.exposeMatrix().submatrix().columns()
sliced_get = left_point.exposeMatrix().submatrix().get(1, 0)
sliced_string = right_point.exposeStringMatrix().submatrix().get(0, 0)
nested_slice = left_point.exposeMatrix().transpose().submatrix().copy().get(1, 0)
inverted_rows = left_point.exposeMatrix().inv().rows()
inverted_int = right_point.exposeIntMatrix().inv().get(0, 0)
nested_inv = left_point.exposeMatrix().copy().inv().submatrix().get(0, 0)
pseudo_rows = left_point.exposeMatrix().pinv().rows()
pseudo_int = right_point.exposeIntMatrix().pinv().get(0, 0)
nested_pinv = left_point.exposeMatrix().copy().pinv().transpose().get(0, 0)
vector_rows = left_point.exposeMatrix().eigenvectors().rows()
vector_int = right_point.exposeIntMatrix().eigenvectors().get(0, 0)
nested_vectors = left_point.exposeMatrix().copy().eigenvectors().pinv().get(0, 0)
powered_rows = left_point.exposeMatrix().pow(2).rows()
powered_int = right_point.exposeIntMatrix().pow(3).get(0, 0)
nested_power = left_point.exposeMatrix().copy().pow(2).pinv().get(0, 0)
kron_other = matrix.new<float>(1, 1, 2.0)
kron_rows = left_point.exposeMatrix().kron(kron_other).rows()
kron_int = right_point.exposeIntMatrix().kron(matrix.new<int>(1, 1, 3)).get(0, 0)
nested_kron = left_point.exposeMatrix().copy().kron(kron_other).pow(2).get(0, 0)
diff_rows = left_point.exposeMatrix().diff(1.0).rows()
diff_int = right_point.exposeIntMatrix().diff(matrix.new<int>(1, 1, 1)).get(0, 0)
nested_diff = left_point.exposeMatrix().copy().diff(1.0).kron(kron_other).get(0, 0)
mult_rows = left_point.exposeMatrix().mult(2.0).rows()
mult_int = right_point.exposeIntMatrix().mult(matrix.new<int>(2, 2, 3)).get(0, 0)
mult_array_size = left_point.exposeMatrix().mult(array.from(1.0, 1.0)).copy().size()
nested_mult = left_point.exposeMatrix().copy().mult(2.0).diff(1.0).get(0, 0)

plot(rows + columns + elements + get + copy_chain + int_get + empty + block_return + nested_return + control_flow + alias_qualified + constructor_receiver + dual_alias + nested_copy + float_row.size() + int_row.size() + dual_alias_row + float_col.size() + int_col.size() + dual_alias_col + float_eigenvalues.size() + dual_alias_eigenvalues + (float_is_square ? 1 : 0) + (color_is_square ? 1 : 0) + (float_is_zero ? 1 : 0) + (int_is_zero ? 1 : 0) + (float_is_binary ? 1 : 0) + (int_is_binary ? 1 : 0) + (float_is_diagonal ? 1 : 0) + (int_is_diagonal ? 1 : 0) + (float_is_identity ? 1 : 0) + (int_is_identity ? 1 : 0) + (float_is_symmetric ? 1 : 0) + (int_is_symmetric ? 1 : 0) + (float_is_antisymmetric ? 1 : 0) + (int_is_antisymmetric ? 1 : 0) + (float_is_stochastic ? 1 : 0) + (int_is_stochastic ? 1 : 0) + float_sum + int_sum + float_avg + int_avg + float_min + int_min + float_max + int_max + float_mode + int_mode + float_trace + int_trace + float_det + int_det + float_rank + int_rank)
plot(transposed_rows + transposed_columns + transposed_get + (transposed_string == "pine" ? 1 : 0) + repeated_transpose)
plot(sliced_rows + sliced_columns + sliced_get + (sliced_string == "pine" ? 1 : 0) + nested_slice)
plot(inverted_rows + inverted_int + nested_inv)
plot(pseudo_rows + pseudo_int + nested_pinv)
plot(vector_rows + vector_int + nested_vectors)
plot(powered_rows + powered_int + nested_power)
plot(kron_rows + kron_int + nested_kron)
plot(diff_rows + diff_int + nested_diff)
plot(mult_rows + mult_int + mult_array_size + nested_mult)
left_point.exposeMatrix().set(0, 0, 2.0)
left_point.exposeMatrix().fill(2.0)
left_point.exposeMatrix().reverse()
left_point.exposeMatrix().reshape(1, 4)
left_point.exposeMatrix().swap_rows(0, 1)
left_point.exposeMatrix().swap_columns(0, 1)
right_point.exposeIntMatrix().set(0, 0, 2)
right_point.exposeIntMatrix().fill(2)
right_point.exposeIntMatrix().reverse()
right_point.exposeIntMatrix().reshape(2, 1)
right_point.exposeIntMatrix().swap_rows(0, 0)
right_point.exposeIntMatrix().swap_columns(0, 0)
left_point.exposeBoolMatrix().set(0, 0, false)
left_point.exposeBoolMatrix().fill(false)
left_point.exposeBoolMatrix().reverse()
left_point.exposeBoolMatrix().reshape(1, 1)
left_point.exposeBoolMatrix().swap_rows(0, 0)
left_point.exposeBoolMatrix().swap_columns(0, 0)
right_point.exposeStringMatrix().set(0, 0, "set")
right_point.exposeStringMatrix().fill("fill")
right_point.exposeStringMatrix().reverse()
right_point.exposeStringMatrix().reshape(1, 1)
right_point.exposeStringMatrix().swap_rows(0, 0)
right_point.exposeStringMatrix().swap_columns(0, 0)
left_point.exposeColorMatrix().set(0, 0, color.blue)
left_point.exposeColorMatrix().fill(color.blue)
left_point.exposeColorMatrix().reverse()
left_point.exposeColorMatrix().reshape(1, 1)
left_point.exposeColorMatrix().swap_rows(0, 0)
left_point.exposeColorMatrix().swap_columns(0, 0)
left_point.exposeMatrix().remove_row(0)
left_point.exposeMatrix().remove_col(0)
right_point.exposeIntMatrix().remove_row(0)
right_point.exposeIntMatrix().remove_col(0)
left_point.exposeBoolMatrix().remove_row(0)
left_point.exposeBoolMatrix().remove_col(0)
right_point.exposeStringMatrix().remove_row(0)
right_point.exposeStringMatrix().remove_col(0)
left_point.exposeColorMatrix().remove_row(0)
left_point.exposeColorMatrix().remove_col(0)
left_point.exposeMatrix().add_row(0, array.from(1.0))
right_point.exposeIntMatrix().add_row(0, array.from(1))
left_point.exposeBoolMatrix().add_row(0, array.from(false))
right_point.exposeStringMatrix().add_row(0, array.from("row"))
left_point.exposeColorMatrix().add_row(0, array.from(color.blue))

left_point.exposeMatrix().add_col(0, array.from(1.0))
right_point.exposeIntMatrix().add_col(0, array.from(1))
left_point.exposeBoolMatrix().add_col(0, array.from(false))
right_point.exposeStringMatrix().add_col(0, array.from("column"))
left_point.exposeColorMatrix().add_col(0, array.from(color.blue))

left_point.exposeMatrix().sort()
right_point.exposeIntMatrix().sort(0, order.descending)
